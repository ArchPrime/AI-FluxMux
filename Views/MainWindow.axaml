<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FluxMux.Avalonia.ViewModels"
        xmlns:views="using:FluxMux.Avalonia.Views"
        xmlns:svc="using:FluxMux.Avalonia.Services"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:ctrl="using:FluxMux.Avalonia.Controls"
    xmlns:shapes="using:Avalonia.Controls.Shapes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
        x:Class="FluxMux.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:Name="RootWindow"
        Icon="/Assets/Logos/AI-FluxMux.ico"
    Title="AI-FluxMux v0.2.1 beta"
    MinWidth="640"
    MinHeight="600"
        WindowStartupLocation="Manual"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="Full"
        Background="{DynamicResource FluxPaneBackground}">

    <Window.Resources>
        <x:String x:Key="IdleTimeoutTooltip">Set how many idle minutes before AI-FluxMux stops the local model. This saves power, and frees VRAM for other apps. A reply that is still being prepared does not count as idle, even if that turn takes a long time. While a reply is being worked on, AI-FluxMux asks Windows to stay awake so the turn can finish. Note however that if using a laptop, closing the lid can still trigger sleep. Windows can also sleep when no reply is in progress. After the PC wakes, idle time includes the time spent asleep. After an idle timeout, when you send the next chat, the local model must reload and rebuild the context from the chat history, which is slower and risks reduced model understanding of what was most pertinent. Leave the idle timeout setting off to keep the local model loaded and ready in memory.</x:String>
        <DataTemplate x:Key="CloudProviderOptionTemplate" x:DataType="x:String">
            <TextBlock Text="{Binding Converter={x:Static vm:CloudProviderDisplayConverter.Instance}}" />
        </DataTemplate>
        <DataTemplate x:Key="LiveUtilizationGaugeTemplate" x:DataType="vm:LiveUtilizationGaugeViewModel">
            <StackPanel Spacing="2" ToolTip.Tip="{Binding Tooltip}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBlock Text="{Binding Title}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#E4E7EC"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Badge}"
                               FontSize="10"
                               Opacity="0.72"
                               Foreground="#D0D5DD"
                               TextWrapping="NoWrap" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <ctrl:SegmentedUtilizationGauge Percent="{Binding Percent}"
                                                    VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding PercentText}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#F9FAFB"
                               VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="{Binding DetailText}"
                           FontSize="10"
                           Opacity="0.78"
                           Foreground="#D0D5DD"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ValidatedProfileOptionTemplate" x:DataType="vm:ValidatedQuickSelectProfileOption">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="profileStatusIcon"
                           Text="⚠"
                           Foreground="#DC2626"
                           IsVisible="{Binding ShowMissingFileWarning, FallbackValue=False, TargetNullValue=False}"
                           ToolTip.Tip="{Binding MissingFileWarningTooltip}" />
                <Border Classes="corporateLogoBadge comboLogoChip"
                        IsVisible="{Binding HasLogo, FallbackValue=False}"
                        ToolTip.Tip="{Binding LogoCompanyName}">
                    <Image Classes="corporateLogo"
                           Source="{Binding LogoAssetKey, Converter={x:Static vm:CorporateLogoImageConverter.Instance}}" />
                </Border>
                <TextBlock Text="{Binding DisplayName}"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="SwitchBenchmarkProfileOptionTemplate" x:DataType="vm:SwitchBenchmarkProfileOption">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="profileStatusIcon"
                           Text="⚠"
                           Foreground="#DC2626"
                           IsVisible="{Binding ShowMissingFileWarning, FallbackValue=False, TargetNullValue=False}"
                           ToolTip.Tip="{Binding MissingFileWarningTooltip}" />
                <Border Classes="corporateLogoBadge comboLogoChip"
                        IsVisible="{Binding HasLogo, FallbackValue=False}"
                        ToolTip.Tip="{Binding LogoCompanyName}">
                    <Image Classes="corporateLogo"
                           Source="{Binding LogoAssetKey, Converter={x:Static vm:CorporateLogoImageConverter.Instance}}" />
                </Border>
                <TextBlock Text="{Binding DisplayName}"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="CloudProfileEditorTemplate" x:DataType="vm:MainViewModel">
<Border HorizontalAlignment="Stretch" Margin="0,4,0,0" Padding="8,6" CornerRadius="6" BorderBrush="{DynamicResource FluxCardBorder}" BorderThickness="1" Background="{DynamicResource FluxCardBackground}">
                                                        <StackPanel Spacing="10" HorizontalAlignment="Stretch">
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" HorizontalAlignment="Stretch">
                                                                <StackPanel Grid.Column="0" Width="280" Spacing="8" IsEnabled="{Binding IsCloudVariantEditable}">
                                                                    <StackPanel Spacing="2">
                                                                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="User priorities wizard" />
                                                                        <TextBlock FontSize="11" FontWeight="Normal" Opacity="0.75" Text="(use this if in doubt)" />
                                                                    </StackPanel>
                                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                                    <ListBox Grid.Column="0"
                                                                             x:Name="CloudPriorityListBox"
                                                                             ItemsSource="{Binding CloudPriorityOrder}"
                                                                             SelectedItem="{Binding SelectedCloudPriority}"
                                                                             MinHeight="175"
                                                                             SelectionMode="Single"
                                                                             views:ReorderMoveAnimation.Enable="True"
                                                                             PointerPressed="PriorityListBox_PointerPressed"
                                                                             PointerMoved="PriorityListBox_PointerMoved"
                                                                             PointerReleased="PriorityListBox_PointerReleased"
                                                                             PointerCaptureLost="PriorityListBox_PointerCaptureLost">
                                                                        <ListBox.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <StackPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ListBox.ItemsPanel>
                                                                        <ListBox.Styles>
                                                                            <Style Selector="ListBoxItem">
                                                                                <Setter Property="Margin" Value="0,0,0,5" />
                                                                                <Setter Property="Padding" Value="7,5" />
                                                                                <Setter Property="CornerRadius" Value="5" />
                                                                                <Setter Property="Background" Value="{DynamicResource FluxListItemBackground}" />
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource FluxListItemBorder}" />
                                                                                <Setter Property="BorderThickness" Value="1" />
                                                                            </Style>
                                                                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                                                                <Setter Property="Background" Value="{DynamicResource FluxListItemHoverBackground}" />
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource FluxListItemHoverBorder}" />
                                                                            </Style>
                                                                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                                                                <Setter Property="Background" Value="{DynamicResource FluxListItemSelectedBackground}" />
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource FluxListItemSelectedBorder}" />
                                                                                <Setter Property="BorderThickness" Value="2" />
                                                                            </Style>
                                                                        </ListBox.Styles>
                                                                        <ListBox.ItemTemplate>
                                                                            <DataTemplate x:DataType="x:String">
                                                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="2,3">
                                                                                    <TextBlock Classes="reorderGrip"
                                                                                               Grid.Column="0"
                                                                                               Text="⋮⋮"
                                                                                               ToolTip.Tip="Drag to change how important this goal is. The up and down buttons do the same."
                                                                                               PointerPressed="PriorityListBox_PointerPressed"
                                                                                               PointerMoved="PriorityListBox_PointerMoved"
                                                                                               PointerReleased="PriorityListBox_PointerReleased"
                                                                                               PointerCaptureLost="PriorityListBox_PointerCaptureLost" />
                                                                                    <TextBlock Grid.Column="1" FontSize="11" VerticalAlignment="Center" Text="{Binding}" ToolTip.Tip="{Binding Converter={x:Static vm:PriorityTooltipConverter.Instance}, ConverterParameter=cloud}" />
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ListBox.ItemTemplate>
                                                                    </ListBox>
                                                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                                                        <Button Content="↑" Command="{Binding MoveCloudPriorityUpCommand}" ToolTip.Tip="Makes this goal more important and updates the settings below." />
                                                                        <Button Content="↓" Command="{Binding MoveCloudPriorityDownCommand}" ToolTip.Tip="Makes this goal less important and updates the settings below." />
                                                                    </StackPanel>
                                                                    </Grid>
                                                                    <StackPanel Spacing="4">
                                                                        <Button HorizontalAlignment="Left"
                                                                                Content="AutoTune"
                                                                                ToolTip.Tip="After you changed settings by hand, try to use leftover cloud ability without ignoring your goal list."
                                                                                Command="{Binding ApplyCloudIntentPresetCommand}" />
                                                                        <TextBlock FontSize="11" TextWrapping="Wrap" views:MarkedText.Source="{Binding CloudIntentPresetInfoText}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Spacing="8" IsEnabled="{Binding IsCloudVariantEditable}">
                                                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="Detailed settings" />
                                                                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                                                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontSize="11" Text="Provider" />
                                                                        <ComboBox Grid.Row="0" Grid.Column="1"
                                                                                  ItemsSource="{Binding CloudProviders}"
                                                                                  SelectedItem="{Binding CloudFamilyProviderDraft}"
                                                                                  ToolTip.Tip="Which cloud company this profile uses. Saved with the rest of the profile." />
                                                                        <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" FontSize="11" Text="Model id" />
                                                                        <ComboBox Grid.Row="0" Grid.Column="3"
                                                                                  ItemsSource="{Binding CloudFamilyModelIdChoices}"
                                                                                  SelectedItem="{Binding CloudFamilyModelIdDraft}"
                                                                                  ToolTip.Tip="The model id this profile talks to. Saved with the rest of the profile." />
                                                                        <TextBlock Grid.Row="0" Grid.Column="4" VerticalAlignment="Center" FontSize="11" Text="Paste" />
                                                                        <TextBox Grid.Row="0" Grid.Column="5"
                                                                                 PlaceholderText="gpt-4.1"
                                                                                 Text="{Binding CloudFamilyModelIdPaste}"
                                                                                 views:MarkedText.Tip="Optional model id if it is not in the list. Click **Save profile** to apply." />
                                                                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontSize="11" Text="Context" />
                                                                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding CloudContextWindowChoices}" SelectedItem="{Binding CloudVariantContextWindow}" ToolTip.Tip="How much of the chat the cloud model can keep in mind. Shorter means it forgets earlier details sooner." />
                                                                        <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" FontSize="11" Text="Max tokens" />
                                                                        <NumericUpDown Grid.Row="1" Grid.Column="3" Minimum="128" Maximum="65536" Increment="128" Value="{Binding CloudVariantMaxTokens}" ToolTip.Tip="How long one answer can be. Shorter answers may stop in the middle of a reply." />
                                                                        <TextBlock Grid.Row="1" Grid.Column="4" VerticalAlignment="Center" FontSize="11" Text="Temp" />
                                                                        <NumericUpDown Grid.Row="1" Grid.Column="5" Minimum="0" Maximum="2" Increment="0.05" Value="{Binding CloudVariantTemperature}" ToolTip.Tip="How mixed the wording is. Lower is more repeatable. Higher is more varied. Does not make answers faster." />
                                                                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontSize="11" Text="Reasoning" />
                                                                        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding CloudReasoningModeOptions}" SelectedItem="{Binding CloudVariantReasoningMode}" ToolTip.Tip="Quick answers versus slower, more careful thinking when the company supports it." />
                                                                        <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" FontSize="11" Text="Response" />
                                                                        <ComboBox Grid.Row="2" Grid.Column="3" ItemsSource="{Binding CloudResponseFormatOptions}" SelectedItem="{Binding CloudVariantResponseFormat}" ToolTip.Tip="Ordinary text, or a structured layout if this model supports it." />
                                                                        <TextBlock Grid.Row="2" Grid.Column="4" VerticalAlignment="Center" FontSize="11" Text="Effort" />
                                                                        <ComboBox Grid.Row="2" Grid.Column="5" ItemsSource="{Binding CloudReasoningEffortChoices}" SelectedItem="{Binding CloudVariantOpenAiReasoningEffort}" ToolTip.Tip="How hard the cloud model tries on tough questions. Higher can be better, slower, and cost more." />
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Grid>
                                                            <TextBlock FontSize="10" Opacity="0.75" TextWrapping="Wrap" Text="{Binding CloudVariantFootprintText}" />
                                                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="6">
                                                                <Button Grid.Column="0" Content="Revert changes" VerticalAlignment="Center" Command="{Binding RevertCloudVariantCommand}" ToolTip.Tip="Throw away unsaved edits and put back the last saved settings." />
                                                                <Button Grid.Column="1" Content="Use model defaults" VerticalAlignment="Center" Command="{Binding UseCloudModelDefaultsCommand}" views:MarkedText.Tip="Load this model's starting settings as unsaved edits. Click **Save profile** to keep them." />
                                                                <Button Grid.Column="2"
                                                                        VerticalAlignment="Center"
                                                                        IsEnabled="{Binding CanValidateActiveCloudProfile}"
                                                                        Command="{Binding ValidateCloudProfileToEndpointCommand}"
                                                                        CommandParameter="{Binding SelectedCloudVariantItem}"
                                                                        ToolTip.Tip="Tests the saved profile on the Provider and Model id you saved. Save profile first if you changed those fields.">
                                                                    <TextBlock Text="Validate to endpoint" TextWrapping="NoWrap" />
                                                                </Button>
                                                                <Button Grid.Column="3"
                                                                        VerticalAlignment="Center"
                                                                        IsEnabled="{Binding IsCloudVariantEditable}"
                                                                        Command="{Binding SaveCloudVariantCommand}">
                                                                    <TextBlock Text="Save profile" TextWrapping="NoWrap" />
                                                                </Button>
                                                                <TextBox Grid.Column="4"
                                                                         Classes="profileName"
                                                                         IsEnabled="{Binding IsCloudVariantEditable}"
                                                                         Text="{Binding CloudVariantDraftName}"
                                                                         PlaceholderText="New profile name"
                                                                         ToolTip.Tip="Type a new name, then click Rename." />
                                                                <Button Grid.Column="5"
                                                                        Content="Rename"
                                                                        VerticalAlignment="Center"
                                                                        IsEnabled="{Binding IsCloudVariantEditable}"
                                                                        Command="{Binding RenameCloudVariantCommand}" />
                                                                <Button Grid.Column="6"
                                                                        Content="Delete"
                                                                        VerticalAlignment="Center"
                                                                        IsEnabled="{Binding CanDeleteActiveCloudProfile}"
                                                                        Command="{Binding DeleteCloudVariantCommand}"
                                                                        CommandParameter="{Binding SelectedCloudVariantItem}"
                                                                        ToolTip.Tip="Deletes this copy from AI-FluxMux. If this is the default, the whole cloud model and its copies are removed from AI-FluxMux. A profile that lost its model id can be deleted without unlocking. Nothing is deleted at the cloud company." />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" HorizontalAlignment="Stretch">
                                                                <Button Grid.Column="0" Content="Make New Variant" Command="{Binding AddGuidedProfileVariantCommand}" CommandParameter="Cloud" views:MarkedText.Tip="Creates a new model profile variant that starts with a copy of this profile's settings. Type a name in the box first. Change at least one setting, then **Save profile** — AI-FluxMux will not keep two variants with the same settings package." />
                                                                <TextBox Grid.Column="1" Classes="profileName" Text="{Binding NewProfileVariantName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Name your variant first" ToolTip.Tip="Type a name here, then click Make New Variant. AI-FluxMux will tell you if this box is empty." />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" HorizontalAlignment="Stretch">
                                                                <Panel Grid.Column="0" VerticalAlignment="Center">
                                                                    <TextBlock Classes="profileStatusIcon"
                                                                               Text="⚠"
                                                                               Foreground="#DC2626"
                                                                               IsVisible="{Binding SelectedCloudVariantItem.ShowMissingFileWarning, FallbackValue=False, TargetNullValue=False}" />
                                                                    <TextBlock Classes="profileStatusIcon"
                                                                               Text="✓"
                                                                               Foreground="#16A34A"
                                                                               IsVisible="{Binding SelectedCloudVariantItem.ShowValidatedCheck, FallbackValue=False, TargetNullValue=False}" />
                                                                </Panel>
                                                                <TextBlock Grid.Column="1"
                                                                           FontSize="11"
                                                                           TextWrapping="Wrap"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxHeight="40"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{Binding SelectedCloudVariantItem.EndpointStatusForeground}"
                                                                           Text="{Binding SelectedCloudVariantItem.EndpointStatusText}" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
        </DataTemplate>
        <DataTemplate x:Key="LocalProfileEditorTemplate" x:DataType="vm:MainViewModel">
<Border HorizontalAlignment="Stretch" Margin="0,4,0,0" Padding="8,6" CornerRadius="6" BorderBrush="#A7F3D0" BorderThickness="1" Background="{DynamicResource FluxCardBackground}">
                                                        <StackPanel Spacing="10" HorizontalAlignment="Stretch">
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" HorizontalAlignment="Stretch">
                                                                <StackPanel Grid.Column="0" Width="280" Spacing="8" IsEnabled="{Binding IsLocalVariantEditable}">
                                                                    <StackPanel Spacing="2">
                                                                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="User priorities wizard" />
                                                                        <TextBlock FontSize="11" FontWeight="Normal" Opacity="0.75" Text="(use this if in doubt)" />
                                                                    </StackPanel>
                                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                                    <ListBox Grid.Column="0"
                                                                             x:Name="LocalPriorityListBox"
                                                                             ItemsSource="{Binding LocalPriorityOrder}"
                                                                             SelectedItem="{Binding SelectedLocalPriority}"
                                                                             MinHeight="175"
                                                                             SelectionMode="Single"
                                                                             views:ReorderMoveAnimation.Enable="True"
                                                                             PointerPressed="PriorityListBox_PointerPressed"
                                                                             PointerMoved="PriorityListBox_PointerMoved"
                                                                             PointerReleased="PriorityListBox_PointerReleased"
                                                                             PointerCaptureLost="PriorityListBox_PointerCaptureLost">
                                                                        <ListBox.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <StackPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ListBox.ItemsPanel>
                                                                        <ListBox.Styles>
                                                                            <Style Selector="ListBoxItem">
                                                                                <Setter Property="Margin" Value="0,0,0,5" />
                                                                                <Setter Property="Padding" Value="7,5" />
                                                                                <Setter Property="CornerRadius" Value="5" />
                                                                                <Setter Property="Background" Value="{DynamicResource FluxListItemBackground}" />
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource FluxListItemBorder}" />
                                                                                <Setter Property="BorderThickness" Value="1" />
                                                                            </Style>
                                                                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                                                                <Setter Property="Background" Value="{DynamicResource FluxListItemHoverBackground}" />
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource FluxListItemHoverBorder}" />
                                                                            </Style>
                                                                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                                                                <Setter Property="Background" Value="{DynamicResource FluxListItemSelectedBackground}" />
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource FluxListItemSelectedBorder}" />
                                                                                <Setter Property="BorderThickness" Value="2" />
                                                                            </Style>
                                                                        </ListBox.Styles>
                                                                        <ListBox.ItemTemplate>
                                                                            <DataTemplate x:DataType="x:String">
                                                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="2,3">
                                                                                    <TextBlock Classes="reorderGrip"
                                                                                               Grid.Column="0"
                                                                                               Text="⋮⋮"
                                                                                               ToolTip.Tip="Drag to change how important this goal is. The up and down buttons do the same."
                                                                                               PointerPressed="PriorityListBox_PointerPressed"
                                                                                               PointerMoved="PriorityListBox_PointerMoved"
                                                                                               PointerReleased="PriorityListBox_PointerReleased"
                                                                                               PointerCaptureLost="PriorityListBox_PointerCaptureLost" />
                                                                                    <TextBlock Grid.Column="1" FontSize="11" VerticalAlignment="Center" Text="{Binding}" ToolTip.Tip="{Binding Converter={x:Static vm:PriorityTooltipConverter.Instance}, ConverterParameter=local}" />
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ListBox.ItemTemplate>
                                                                    </ListBox>
                                                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                                                        <Button Content="↑" Command="{Binding MoveLocalPriorityUpCommand}" ToolTip.Tip="Makes this goal more important and updates GPU, context, and related launch settings below. Leaves max tokens, temperature, reasoning, and chat format you already set." />
                                                                        <Button Content="↓" Command="{Binding MoveLocalPriorityDownCommand}" ToolTip.Tip="Makes this goal less important and updates GPU, context, and related launch settings below. Leaves max tokens, temperature, reasoning, and chat format you already set." />
                                                                    </StackPanel>
                                                                    </Grid>
                                                                    <StackPanel Spacing="4">
                                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                                            <Button VerticalAlignment="Center"
                                                                                    Content="AutoTune"
                                                                                    views:MarkedText.Tip="Fills leftover graphics-card and context room from your priority list. Leaves Images, max tokens, temperature, reasoning, and chat format you already set. Images on reserves graphics memory from Max image edge, so Context advice is smaller. **Save profile** to keep the launch settings, or **Revert changes** to discard. Tick the experimental box to also time a tiny test reply; that path stores settings so the model can reload."
                                                                                    Command="{Binding ApplyLocalPriorityWizardCommand}"
                                                                                    CommandParameter="{Binding SelectedLocalVariantItem}" />
                                                                            <CheckBox VerticalAlignment="Center"
                                                                                      IsChecked="{Binding LocalExperimentalHardwareTuneEnabled}"
                                                                                      views:MarkedText.Tip="When ticked, **AutoTune** still applies the usual launch settings, then reloads the model and times a tiny reply (a few words). That path stores settings so the model can reload. Any speed-up on that tiny test is usually a fraction of a second — not a full chat. Progress shows in Diagnostics. Leave unticked for the instant unsaved settings pass only.">
                                                                                <CheckBox.Content>
                                                                                    <TextBlock Text="Test local system for additional optimisations (experimental)"
                                                                                               TextWrapping="Wrap"
                                                                                               MaxWidth="180"
                                                                                               FontSize="11" />
                                                                                </CheckBox.Content>
                                                                            </CheckBox>
                                                                        </StackPanel>
                                                                        <TextBlock FontSize="11" TextWrapping="Wrap" views:MarkedText.Source="{Binding LocalQuickAutoTuneInfoText}" />
                                                                    </StackPanel>
                                                                    <StackPanel Spacing="2" Margin="0,6,0,0">
                                                                        <TextBlock FontSize="11" TextWrapping="Wrap" Text="{Binding LocalVariantFootprintText}" />
                                                                        <TextBlock FontSize="10" Opacity="0.82" TextWrapping="Wrap" Text="{Binding LocalVariantPerformanceEstimateText}" />
                                                                        <TextBlock FontSize="10"
                                                                                   Opacity="0.75"
                                                                                   TextWrapping="Wrap"
                                                                                   IsVisible="{Binding ShowLocalLaunchTelemetryText}"
                                                                                   Text="{Binding LocalLaunchTelemetryText}"
                                                                                   ToolTip.Tip="{Binding LocalLaunchTelemetryDetailText}" />
                                                                    </StackPanel>
                                                                    <TextBlock Margin="0,10,0,0"
                                                                               FontSize="11"
                                                                               TextWrapping="Wrap"
                                                                               Foreground="#C2410C"
                                                                               IsVisible="{Binding ShowLocalVariantVramWarning}"
                                                                               Text="{Binding LocalVariantVramWarningText}" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Spacing="8" IsEnabled="{Binding IsLocalVariantEditable}">
                                                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="Detailed settings" />
                                                                    <Border Padding="8,6" CornerRadius="5" BorderBrush="{DynamicResource FluxTintAmberBorder}" BorderThickness="1" Background="{DynamicResource FluxTintAmberBackground}">
                                                                        <StackPanel Spacing="6">
                                                                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="Images" />
                                                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" Text="Enable" />
                                                                                <ComboBox Grid.Column="1" ItemsSource="{Binding LocalOnOffOptions}" SelectedItem="{Binding LocalVariantVisionEnabled}" ToolTip.Tip="On: this model can look at pictures (needs a matching extra file and uses more graphics memory). Off: text only. AutoTune does not change this — it works around the leftover graphics memory." />
                                                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" Text="Max image edge" />
                                                                                <NumericUpDown Grid.Column="3" Minimum="256" Maximum="4096" Increment="64" Value="{Binding LocalVariantVisionMaxImageEdge}" ToolTip.Tip="Largest picture size (longest side, in pixels) this model will accept. Bigger reserves more graphics memory, so AutoTune and Context have less headroom." />
                                                                            </Grid>
                                                                            <Grid ColumnDefinitions="Auto,*,2*,Auto" ColumnSpacing="8">
                                                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" Text="Projector file" />
                                                                                <ComboBox Grid.Column="1"
                                                                                          VerticalAlignment="Center"
                                                                                          ItemsSource="{Binding LocalVariantVisionProjectorChoices}"
                                                                                          SelectedItem="{Binding SelectedLocalVariantVisionProjectorChoice}"
                                                                                          ToolTip.Tip="Picture helper files in the models folder that look like they belong to this model. Unrelated files are hidden. Browse if yours is missing." />
                                                                                <TextBox Grid.Column="2"
                                                                                         VerticalAlignment="Center"
                                                                                         Text="{Binding LocalVariantVisionProjectorPath}"
                                                                                         PlaceholderText="Or paste a projector path"
                                                                                         ToolTip.Tip="Usually filled from the list. Browse only if the matching picture-helper file was not found." />
                                                                                <Button Grid.Column="3"
                                                                                        VerticalAlignment="Center"
                                                                                        Content="Browse"
                                                                                        Command="{Binding BrowseVisionProjectorCommand}"
                                                                                        ToolTip.Tip="Pick the picture-helper file if it was not found automatically." />
                                                                            </Grid>
                                                                            <TextBlock FontSize="11" TextWrapping="Wrap" Opacity="0.9" Text="{Binding LocalVariantImagesHeadroomNote}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <Border Padding="8,6" CornerRadius="5" BorderBrush="{DynamicResource FluxMutedBorder}" BorderThickness="1" Background="{DynamicResource FluxMutedBackground}">
                                                                        <StackPanel Spacing="6">
                                                                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="Fit and memory" />
                                                                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                                                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontSize="11" Text="Context" />
                                                                        <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="1024" Maximum="262144" Increment="1024" Value="{Binding LocalVariantContext}" ToolTip.Tip="How much of the chat the model can keep in mind. Bigger uses more graphics memory and may need a full reload later. AutoTune sizes this from leftover GPU memory after Images (Max image edge). On this 32 GB PC the daily NVFP4 sizes are 213056 with Images off and 163840 with Images on." />
                                                                        <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" FontSize="11" Text="Flash" />
                                                                        <ComboBox Grid.Row="0" Grid.Column="3" ItemsSource="{Binding LocalOnOffOptions}" SelectedItem="{Binding LocalVariantFlashAttention}" ToolTip.Tip="Can make long chats faster if your graphics card supports it. Leave Auto/On unless long chats feel broken." />
                                                                        <TextBlock Grid.Row="0" Grid.Column="4" VerticalAlignment="Center" FontSize="11" Text="Fit VRAM" />
                                                                        <CheckBox Grid.Row="0"
                                                                                  Grid.Column="5"
                                                                                  VerticalAlignment="Center"
                                                                                  IsChecked="{Binding LocalVariantFitEnabled}"
                                                                                  Content="On"
                                                                                  ToolTip.Tip="On: shrink settings so the model still fits in graphics memory. Off: keep the sizes you set, even if that needs more graphics memory. Save keeps this choice." />

                                                                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontSize="11" Text="KV key" />
                                                                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding LocalKvCacheOptions}" SelectedItem="{Binding LocalVariantKvCacheTypeK}" ToolTip.Tip="Precision for attention Keys — how reliably the model links new text back to the right earlier turns. Prefer q8_0 or f16. Do not go below q8_0: the fidelity loss usually outweighs any Context gain from q6/q5/q4. Match KV value unless you are tuning on purpose." />
                                                                        <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" FontSize="11" Text="KV value" />
                                                                        <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding LocalKvCacheOptions}" SelectedItem="{Binding LocalVariantKvCacheTypeV}" ToolTip.Tip="Precision for attention Values — how faithfully earlier turn content is kept. Prefer q8_0 or f16. Do not go below q8_0: the fidelity loss usually outweighs any Context gain from q6/q5/q4. Match KV key unless you are tuning on purpose." />
                                                                        <TextBlock Grid.Row="1" Grid.Column="4" VerticalAlignment="Center" FontSize="11" Text="SWA full" />
                                                                        <ComboBox Grid.Row="1" Grid.Column="5" ItemsSource="{Binding LocalOnOffOptions}" SelectedItem="{Binding LocalVariantSwaFull}" ToolTip.Tip="Keeps extra chat memory on some models. Try On if long chats forget what you just said." />

                                                                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontSize="11" Text="Cache reuse" />
                                                                        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding LocalCacheReuseOptions}" SelectedItem="{Binding LocalVariantCacheReuse}" ToolTip.Tip="Reuse work from similar earlier questions so follow-ups can start sooner." />
                                                                        <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" FontSize="11" Text="Cache RAM" />
                                                                        <ComboBox Grid.Row="2" Grid.Column="3" ItemsSource="{Binding LocalCacheRamOptions}" SelectedItem="{Binding LocalVariantCacheRam}" ToolTip.Tip="How much ordinary computer memory to keep for that reuse. Unlimited helps long back-and-forth chats. Disabled turns reuse off." />
                                                                        <TextBlock Grid.Row="2" Grid.Column="4" VerticalAlignment="Center" FontSize="11" Text="Compact" />
                                                                        <CheckBox Grid.Row="2"
                                                                                  Grid.Column="5"
                                                                                  VerticalAlignment="Center"
                                                                                  IsChecked="{Binding LocalVariantAutoCompressEnabled}"
                                                                                  Content="On"
                                                                                  ToolTip.Tip="On: when Context is filling, AI-FluxMux may shorten older turns it forwards to llama-server. The Client app still keeps the full chat. Off: never auto-compact forwarded history." />
                                                                            </Grid>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <Border Padding="8,6" CornerRadius="5" BorderBrush="{DynamicResource FluxTintGreenBorder}" BorderThickness="1" Background="{DynamicResource FluxTintGreenBackground}">
                                                                        <StackPanel Spacing="6">
                                                                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="Graphics card" />
                                                                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                                                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontSize="11" Text="GPU mode" />
                                                                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding LocalGpuOffloadModeOptions}" SelectedItem="{Binding LocalVariantGpuOffloadMode}" ToolTip.Tip="Run the model on the graphics card, the ordinary processor, or both. More graphics-card use is usually faster if there is enough graphics memory." />
                                                                        <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" FontSize="11" Text="GPU layers" />
                                                                        <ComboBox Grid.Row="0" Grid.Column="3" ItemsSource="{Binding LocalGpuLayersChoices}" SelectedItem="{Binding LocalVariantGpuLayers}" ToolTip.Tip="How much of the model sits on the graphics card. More is usually faster if there is room. Auto lets AI-FluxMux place it. Auto is only on editable copies." />
                                                                        <TextBlock Grid.Row="0" Grid.Column="4" VerticalAlignment="Center" FontSize="11" Text="Speculative" />
                                                                        <ComboBox Grid.Row="0" Grid.Column="5" ItemsSource="{Binding LocalSpecTypeOptions}" SelectedItem="{Binding LocalVariantSpecType}" ToolTip.Tip="Let the model guess ahead to speed up answers. Turn this off if answers get worse." />
                                                                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontSize="11" Text="Multi-GPU" />
                                                                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding LocalMultiGpuModeOptions}" SelectedItem="{Binding LocalVariantMultiGpuMode}" ToolTip.Tip="Auto: when two or more NVIDIA graphics cards are detected, llama-server spreads layers by free VRAM. Disabled: use one card only. Manual: use the split settings below." />
                                                                        <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" FontSize="11" Text="Split mode" IsVisible="{Binding ShowLocalMultiGpuManualSettings}" />
                                                                        <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding LocalSplitModeOptions}" SelectedItem="{Binding LocalVariantSplitMode}" IsVisible="{Binding ShowLocalMultiGpuManualSettings}" ToolTip.Tip="How llama-server spreads the model across graphics cards. Layer is usually best for two cards." />
                                                                        <TextBlock Grid.Row="1" Grid.Column="4" VerticalAlignment="Center" FontSize="11" Text="Main GPU" IsVisible="{Binding ShowLocalMultiGpuManualSettings}" />
                                                                        <ComboBox Grid.Row="1" Grid.Column="5" ItemsSource="{Binding LocalMainGpuOptions}" SelectedItem="{Binding LocalVariantMainGpu}" IsVisible="{Binding ShowLocalMultiGpuManualSettings}" ToolTip.Tip="Which graphics card owns intermediate results. Auto lets llama-server choose." />
                                                                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontSize="11" Text="Tensor split" IsVisible="{Binding ShowLocalMultiGpuManualSettings}" />
                                                                        <TextBox Grid.Row="2"
                                                                                 Grid.Column="1"
                                                                                 Grid.ColumnSpan="5"
                                                                                 IsVisible="{Binding ShowLocalMultiGpuManualSettings}"
                                                                                 Text="{Binding LocalVariantTensorSplit}"
                                                                                 PlaceholderText="Auto or 50,50"
                                                                                 ToolTip.Tip="Comma-separated share per graphics card, for example 60,40. Auto lets llama-server or AI-FluxMux choose." />
                                                                            </Grid>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <Border Padding="8,6" CornerRadius="5" BorderBrush="{DynamicResource FluxTintOrangeBorder}" BorderThickness="1" Background="{DynamicResource FluxTintOrangeBackground}">
                                                                        <StackPanel Spacing="6">
                                                                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="Prompt and CPU" />
                                                                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                                                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontSize="11" Text="Threads" />
                                                                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding LocalThreadOptions}" SelectedItem="{Binding LocalVariantOverrideThreads}" ToolTip.Tip="How many processor cores to use when writing the answer. AutoTune usually aims for about half of your cores. More is not always faster." />
                                                                        <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" FontSize="11" Text="Batch threads" />
                                                                        <ComboBox Grid.Row="0" Grid.Column="3" ItemsSource="{Binding LocalThreadBatchOptions}" SelectedItem="{Binding LocalVariantThreadsBatch}" ToolTip.Tip="How many processor cores to use while reading your question. More can be faster if the rest of the PC is not busy." />
                                                                        <TextBlock Grid.Row="0" Grid.Column="4" VerticalAlignment="Center" FontSize="11" Text="Batch size" />
                                                                        <ComboBox Grid.Row="0" Grid.Column="5" ItemsSource="{Binding LocalBatchSizeOptions}" SelectedItem="{Binding LocalVariantBatchSize}" ToolTip.Tip="How much of the question is processed at once. Larger can start answering sooner, but uses more graphics memory." />

                                                                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontSize="11" Text="Micro-batch" />
                                                                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding LocalUbatchSizeOptions}" SelectedItem="{Binding LocalVariantUbatchSize}" ToolTip.Tip="A smaller bite if the question is too big to fit in graphics memory at once. Lower this if reading the question fails because memory ran out." />
                                                                        <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" FontSize="11" Text="Multi-user" />
                                                                        <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding LocalOnOffOptions}" SelectedItem="{Binding LocalVariantMultiUserMode}" ToolTip.Tip="Allow more than one question at a time. This does not make a single answer faster, and each extra question uses graphics memory." />
                                                                            </Grid>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <Border Padding="8,6" CornerRadius="5" BorderBrush="{DynamicResource FluxTintPurpleBorder}" BorderThickness="1" Background="{DynamicResource FluxTintPurpleBackground}">
                                                                        <StackPanel Spacing="6">
                                                                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="Chat format" />
                                                                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="8" RowSpacing="6">
                                                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" Text="Template" />
                                                                        <ComboBox Grid.Column="1" ItemsSource="{Binding LocalChatTemplateOptions}" SelectedItem="{Binding LocalVariantChatTemplate}" ToolTip.Tip="Auto uses the format stored in the local model. Pick a named format only for older models. Newer Qwen models must stay on Auto or they may ignore instructions from the Client app." />
                                                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" Text="Chat parser" />
                                                                        <ComboBox Grid.Column="3" ItemsSource="{Binding LocalChatParserOptions}" SelectedItem="{Binding LocalVariantChatParser}" ToolTip.Tip="How chat messages are read. Leave the default unless answers look garbled. Skip parsing is a last resort." />
                                                                        <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="11" Text="Unban tokens" />
                                                                        <ComboBox Grid.Column="5" ItemsSource="{Binding LocalOnOffOptions}" SelectedItem="{Binding LocalVariantUnbanTokensMode}" ToolTip.Tip="Allow some words llama-server would otherwise block. This is a real llama-server option (--unbantokens) when llama-server's help lists it; AI-FluxMux only sends it then. AutoTune may turn this on for some chat formats." />
                                                                            </Grid>
                                                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                                                <TextBlock FontSize="12"
                                                                                           FontWeight="SemiBold"
                                                                                           VerticalAlignment="Center"
                                                                                           Text="Reply style" />
                                                                                <TextBlock FontSize="11"
                                                                                           Opacity="0.72"
                                                                                           VerticalAlignment="Center"
                                                                                           Text="next message · no reload"
                                                                                           ToolTip.Tip="Temperature, max tokens, and Reasoning apply on the next Client-app message while this profile is loaded. llama-server is not reloaded." />
                                                                            </StackPanel>
                                                                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="8" RowSpacing="6">
                                                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" Text="Temperature" />
                                                                        <NumericUpDown Grid.Column="1" Minimum="0" Maximum="2" Increment="0.05" Value="{Binding LocalVariantTemperature}" ToolTip.Tip="How mixed the wording is. Lower is more repeatable. Higher is more varied. Does not make answers faster." />
                                                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" Text="Max tokens" />
                                                                        <ComboBox Grid.Column="3" ItemsSource="{Binding LocalMaxTokenOptions}" SelectedItem="{Binding LocalVariantMaxTokens}" ToolTip.Tip="How long one answer can be. Shorter answers may stop in the middle of a reply. AutoTune and the priority arrows will not lower this. Save keeps it." />
                                                                        <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="11" Text="Reasoning" />
                                                                        <ComboBox Grid.Column="5" ItemsSource="{Binding LocalReasoningOptions}" SelectedItem="{Binding LocalVariantReasoning}" ToolTip.Tip="Whether the model writes a hidden thinking step before answering. Off is usually better for the Client app. Use the Quick Select list for Off, Low, Medium, or XHigh on the running row." />
                                                                            </Grid>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Grid>
                                                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="6">
                                                                <Button Grid.Column="0" Content="Revert changes" VerticalAlignment="Center" Command="{Binding RevertLocalVariantCommand}" ToolTip.Tip="Throw away unsaved edits and put back the last saved settings." />
                                                                <Button Grid.Column="1" Content="Use model defaults" VerticalAlignment="Center" Command="{Binding UseLocalModelDefaultsCommand}" views:MarkedText.Tip="Load this model's starting settings as unsaved edits. Click **Save profile** to keep them." />
                                                                <Button Grid.Column="2"
                                                                        VerticalAlignment="Center"
                                                                        IsEnabled="{Binding CanValidateActiveLocalProfile}"
                                                                        Command="{Binding ValidateLocalProfileToEndpointCommand}"
                                                                        CommandParameter="{Binding SelectedLocalVariantItem}"
                                                                        ToolTip.Tip="Starts this local model with these settings and sends a short test the same way the Client app would. If it answers, it can be chosen in Quick Select.">
                                                                    <TextBlock Text="Validate to endpoint" TextWrapping="NoWrap" />
                                                                </Button>
                                                                <Button Grid.Column="3"
                                                                        VerticalAlignment="Center"
                                                                        IsEnabled="{Binding IsLocalVariantEditable}"
                                                                        Command="{Binding SaveLocalVariantCommand}">
                                                                    <TextBlock Text="Save profile" TextWrapping="NoWrap" />
                                                                </Button>
                                                                <TextBox Grid.Column="4"
                                                                         Classes="profileName"
                                                                         IsEnabled="{Binding IsLocalVariantEditable}"
                                                                         Text="{Binding LocalVariantDraftName}"
                                                                         PlaceholderText="New profile name"
                                                                         ToolTip.Tip="Type a new name, then click Rename." />
                                                                <Button Grid.Column="5"
                                                                        Content="Rename"
                                                                        VerticalAlignment="Center"
                                                                        IsEnabled="{Binding IsLocalVariantEditable}"
                                                                        Command="{Binding RenameLocalVariantCommand}" />
                                                                <Button Grid.Column="6"
                                                                        Content="Delete"
                                                                        VerticalAlignment="Center"
                                                                        IsEnabled="{Binding IsLocalVariantEditable}"
                                                                        Command="{Binding DeleteLocalVariantCommand}"
                                                                        CommandParameter="{Binding SelectedLocalVariantItem}"
                                                                        ToolTip.Tip="Deletes this copy from AI-FluxMux. If this is the default, the whole local model and its copies are removed from AI-FluxMux. The local model on disk is not deleted." />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" HorizontalAlignment="Stretch">
                                                                <Button Grid.Column="0" Content="Make New Variant" Command="{Binding AddGuidedProfileVariantCommand}" CommandParameter="Local" views:MarkedText.Tip="Creates a new model profile variant that starts with a copy of this profile's settings. Type a name in the box first. Change at least one setting, then **Save profile** — AI-FluxMux will not keep two variants with the same settings package." />
                                                                <TextBox Grid.Column="1" Classes="profileName" Text="{Binding NewProfileVariantName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Name your variant first" ToolTip.Tip="Type a name here, then click Make New Variant. AI-FluxMux will tell you if this box is empty." />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" HorizontalAlignment="Stretch">
                                                                <Panel Grid.Column="0" VerticalAlignment="Center">
                                                                    <TextBlock Classes="profileStatusIcon"
                                                                               Text="⚠"
                                                                               Foreground="#DC2626"
                                                                               IsVisible="{Binding SelectedLocalVariantItem.ShowMissingFileWarning, FallbackValue=False, TargetNullValue=False}" />
                                                                    <TextBlock Classes="profileStatusIcon"
                                                                               Text="✓"
                                                                               Foreground="#16A34A"
                                                                               IsVisible="{Binding SelectedLocalVariantItem.ShowValidatedCheck, FallbackValue=False, TargetNullValue=False}" />
                                                                </Panel>
                                                                <TextBlock Grid.Column="1"
                                                                           FontSize="11"
                                                                           TextWrapping="Wrap"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxHeight="40"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{Binding SelectedLocalVariantItem.EndpointStatusForeground}"
                                                                           Text="{Binding SelectedLocalVariantItem.EndpointStatusText}" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
        </DataTemplate>
        <ControlTheme x:Key="DiagnosticsSashTheme" TargetType="GridSplitter">
            <Setter Property="Background" Value="{DynamicResource FluxChromeBackground}" />
            <Setter Property="MinHeight" Value="12" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel Background="{TemplateBinding Background}">
                        <Border x:Name="SashHoverLine"
                                Height="4"
                                CornerRadius="2"
                                VerticalAlignment="Center"
                                Background="{DynamicResource FluxSashHover}"
                                IsHitTestVisible="False"
                                Opacity="0">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.10" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <StackPanel x:Name="SashDots"
                                    Orientation="Horizontal"
                                    Spacing="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <shapes:Ellipse Width="4" Height="4" Fill="{DynamicResource FluxSashGrip}" />
                            <shapes:Ellipse Width="4" Height="4" Fill="{DynamicResource FluxSashGrip}" />
                            <shapes:Ellipse Width="4" Height="4" Fill="{DynamicResource FluxSashGrip}" />
                        </StackPanel>
                    </Panel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#SashHoverLine">
                <Setter Property="Opacity" Value="0.85" />
            </Style>
            <Style Selector="^:pressed /template/ Border#SashHoverLine">
                <Setter Property="Opacity" Value="0.85" />
            </Style>
        </ControlTheme>
    </Window.Resources>

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock.reorderGrip">
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Opacity" Value="0.72" />
            <Setter Property="Cursor" Value="SizeAll" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Grid.vramCaution TextBlock">
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="Opacity" Value="0.62" />
        </Style>
        <Style Selector="Border.slotRuntimeChrome.activeRuntimeLive">
            <Setter Property="Background" Value="{DynamicResource FluxQuickSelectLiveBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FluxQuickSelectLiveBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.slotRuntimeChrome.activeRuntimeAmber">
            <Setter Property="BorderBrush" Value="{DynamicResource FluxTintAmberBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.slotRuntimeChrome.activeRuntimeFault">
            <Setter Property="Background" Value="{DynamicResource FluxQuickSelectFaultBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FluxTintOrangeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.slotRuntimeChrome.standbyHotLive">
            <Setter Property="Background" Value="{DynamicResource FluxQuickSelectStandbyBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FluxQuickSelectStandbyBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.slotRuntimeChrome.standbyHotAmber">
            <Setter Property="BorderBrush" Value="{DynamicResource FluxTintAmberBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.slotLoadingFill">
            <Setter Property="Background" Value="{DynamicResource FluxTintAmberBackground}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.45" Easing="CubicEaseInOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.slotRuntimeChrome.standbyHotFault">
            <Setter Property="Background" Value="{DynamicResource FluxQuickSelectFaultBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FluxTintOrangeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.headerLockButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style Selector="Button.headerLockButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF" />
        </Style>
        <Style Selector="Border.profileHeaderChrome">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="1" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.22" />
                    <BrushTransition Property="Background" Duration="0:0:0.22" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.profileHeaderChrome:pointerover">
            <Setter Property="BorderBrush" Value="#93C5FD" />
            <Setter Property="Background" Value="#2260A5FA" />
        </Style>
        <Style Selector="Border.profileHeaderChrome.profileSelected">
            <Setter Property="BorderBrush" Value="#2563EB" />
            <Setter Property="Background" Value="#332563EB" />
        </Style>
        <Style Selector="Border.profileHeaderChrome.profileExpanded">
            <Setter Property="BorderBrush" Value="#16A34A" />
        </Style>
        <Style Selector="Border.profileHeaderChrome.profileSelected.profileExpanded">
            <Setter Property="BorderBrush" Value="#1D4ED8" />
            <Setter Property="Background" Value="#332563EB" />
        </Style>
        <Style Selector="Border.profileHeaderChrome.profileSelected:pointerover">
            <Setter Property="BorderBrush" Value="#1D4ED8" />
        </Style>
        <Style Selector="Border.profileEditingBadge">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
        </Style>
        <Style Selector="Border.corporateLogoBadge">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.comboLogoChip">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="2" />
        </Style>
        <Style Selector="Image.corporateLogo">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Image.appLogo">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Height" Value="44" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.appLogoBadge">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Image.helpCopyrightLogo">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
        <Style Selector="TabControl.mainTabs /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Height" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleBar">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel > TextBlock">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="WindowDrawnDecorations /template/ Button#PART_FullScreenButton">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Width" Value="0" />
        </Style>
        <Style Selector="TabStrip#MainTabStrip TabStripItem">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TabStrip#MainTabStrip TabStripItem:selected">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TabStrip#MainTabStrip TabStripItem:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Height" Value="0" />
        </Style>
        <Style Selector="TextBlock.profileStatusIcon">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="LineHeight" Value="24" />
        </Style>
        <Style Selector="TextBox.profileName">
            <Setter Property="MinLines" Value="1" />
            <Setter Property="MaxLines" Value="4" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="TextBox.diagnosticTerminal">
            <Setter Property="Background" Value="#101828" />
            <Setter Property="Foreground" Value="#D1FADF" />
            <Setter Property="BorderBrush" Value="#344054" />
            <Setter Property="SelectionBrush" Value="#175CD3" />
            <Setter Property="SelectionForegroundBrush" Value="White" />
            <Setter Property="MinLines" Value="2" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="TextBox.diagnosticTerminal:pointerover">
            <Setter Property="Background" Value="#101828" />
            <Setter Property="Foreground" Value="#D1FADF" />
            <Setter Property="BorderBrush" Value="#475467" />
        </Style>
        <Style Selector="TextBox.diagnosticTerminal:focus">
            <Setter Property="Background" Value="#101828" />
            <Setter Property="Foreground" Value="#D1FADF" />
            <Setter Property="BorderBrush" Value="#53B1FD" />
        </Style>
        <Style Selector="TextBox.diagnosticTerminal:focus-within">
            <Setter Property="Background" Value="#101828" />
            <Setter Property="Foreground" Value="#D1FADF" />
            <Setter Property="BorderBrush" Value="#53B1FD" />
        </Style>
    </Window.Styles>

    <Panel>
    <LayoutTransformControl x:Name="LayoutScaler">
        <LayoutTransformControl.LayoutTransform>
            <ScaleTransform ScaleX="1" ScaleY="1" />
        </LayoutTransformControl.LayoutTransform>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="5*" MinHeight="160" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Padding="18,8,0,8"
                Background="{DynamicResource FluxChromeBackground}"
                BorderBrush="{DynamicResource FluxCardBorder}"
                BorderThickness="0,0,0,1">
        <Grid x:Name="HeaderChrome"
              ColumnDefinitions="Auto,*,Auto"
              LayoutUpdated="HeaderChrome_LayoutUpdated">
            <Border Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Background="Transparent"
                    WindowDecorationProperties.ElementRole="TitleBar" />
            <Border Grid.Column="0"
                    Classes="appLogoBadge"
                    Margin="2,0,0,0"
                    VerticalAlignment="Center"
                    WindowDecorationProperties.ElementRole="User"
                    ToolTip.Tip="AI-FluxMux">
                <ctrl:AnimatedAppLogo IsPlaying="{Binding IsModelActive}" />
            </Border>
            <TabStrip x:Name="MainTabStrip"
                      Grid.Column="1"
                      Margin="12,0,8,0"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      WindowDecorationProperties.ElementRole="User"
                      SelectedIndex="{Binding SelectedMainTabIndex}">
                <TabStrip.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="0" />
                    </ItemsPanelTemplate>
                </TabStrip.ItemsPanel>
                <TabStripItem ToolTip.Tip="Start, reload, or stop models you have already tested. This is the day-to-day tab.">Quick Select</TabStripItem>
                <TabStripItem ToolTip.Tip="The port the Client app connects to, where local models live, which program runs them, and cloud API keys.">Servers</TabStripItem>
                <TabStripItem ToolTip.Tip="Create model profiles for each local model or cloud model, then test that they actually answer before they appear in Quick Select.">Model Profiles</TabStripItem>
                <TabStripItem ToolTip.Tip="Lab tests: how well a chat survives switching between two tested models (two locals, local and cloud, or two clouds). This unloads and reloads; it is not everyday routing.">Live-Switch Testing</TabStripItem>
                <TabStripItem ToolTip.Tip="Checks llama-server, the model folder, the graphics card, paths, and cloud keys.">Environment</TabStripItem>
                <TabStripItem>Help</TabStripItem>
            </TabStrip>
            <Panel x:Name="CaptionButtonSpacer"
                   Grid.Column="2"
                   MinWidth="138"
                   IsHitTestVisible="False" />
        </Grid>
        </Border>

        <TabControl x:Name="MainTabs"
                    Grid.Row="1"
                    Classes="mainTabs"
                    Margin="14,4,14,0"
                    HorizontalAlignment="Stretch"
                    ClipToBounds="True"
                    Background="{DynamicResource FluxPaneBackground}"
                    SelectedIndex="{Binding SelectedMainTabIndex}"
                    SelectionChanged="OnMainTabsSelectionChanged">
            <TabItem Header="Quick Select" ToolTip.Tip="Start, reload, or stop models you have already tested. This is the day-to-day tab.">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10" Margin="0,8,0,8">
                        <views:OptionInfoNote InfoId="quickselect.intro"
                                              NoteText="Quick Select only runs profiles that already passed **Validate to endpoint** on the Model Profiles tab. Choose a validated profile in a slot, click **Save**, then **Launch**. A newly validated copy is offered on the first empty row. You cannot add another slot while a populated slot is still unsaved." />
                        <WrapPanel Orientation="Horizontal">
                            <StackPanel Spacing="2" Margin="0,0,16,4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <CheckBox VerticalAlignment="Center"
                                              IsChecked="{Binding RequestRoutingEnabled}"
                                              ToolTip.Tip="Off: only one model answers at a time. On: a ready local and a ready cloud can both take turns on Port; AI-FluxMux asks before a switch, and Cloud Usage Mode sets how often cloud is offered." />
                                    <TextBlock VerticalAlignment="Center" Text="Route requests" />
                                </StackPanel>
                                <views:OptionInfoNote InfoId="quickselect.route_requests"
                                                      StartDismissed="True"
                                                      NoteText="Off: only one model answers at a time. On: a ready local and a ready cloud can both take turns on Port; AI-FluxMux asks before a switch, and **Cloud Usage Mode** sets how often cloud is offered." />
                            </StackPanel>
                            <StackPanel Spacing="2" Margin="0,0,16,4"
                                        IsVisible="{Binding RequestRoutingEnabled}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <CheckBox VerticalAlignment="Center"
                                              IsChecked="{Binding InterventionPopupsEnabled}"
                                              views:MarkedText.Tip="When **Route requests** needs a decision (**Keep current model — end this turn**, **Keep current model — this turn continues**, or **Switch to** the other ready model; **Load suggested model profile**; **Compact**), open a small always-on-top window so it is not hidden behind Harness or another Client app. The same buttons stay on Diagnostics." />
                                    <TextBlock VerticalAlignment="Center" Text="Pop up routing prompts" />
                                </StackPanel>
                                <views:OptionInfoNote InfoId="quickselect.popup_routing"
                                                      StartDismissed="True"
                                                      NoteText="When **Route requests** needs a decision (**Keep current model — end this turn**, **Keep current model — this turn continues**, or **Switch to** the other ready model; **Load suggested model profile**; **Compact**), open a small always-on-top window so it is not hidden behind Harness or another Client app. The same buttons stay on Diagnostics." />
                            </StackPanel>
                            <StackPanel Spacing="2" Margin="0,0,0,4"
                                        IsVisible="{Binding RequestRoutingEnabled}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock VerticalAlignment="Center" FontSize="11" Text="Cloud Usage Mode" />
                                    <ComboBox MinWidth="160"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              ItemsSource="{Binding CloudRoutingCapacityOptions}"
                                              SelectedItem="{Binding SelectedCloudRoutingCapacity}"
                                              ToolTip.Tip="How freely to spend your cloud subscription. Normal: large or clearly cloud-named requests may go to the ready cloud model. Low: stay on the loaded local unless it is down or the prompt asks for cloud. Hold: stay on the loaded local while it is working (if local is down, cloud can still be used). On Low or Hold, AI-FluxMux may ask before loading a different local model." />
                                </StackPanel>
                                <views:OptionInfoNote InfoId="quickselect.cloud_usage"
                                                      NoteText="Cloud Usage Mode sets how often (or if) routing can direct a selected cloud model to take a chat turn (fast). Prompted local routing (slower) will still apply when cloud is not used." />
                            </StackPanel>
                        </WrapPanel>
                        <views:OptionInfoNote InfoId="quickselect.hot_routing"
                                              NoteText="{Binding RequestRoutingModeText}" />
                        <ItemsControl x:Name="QuickSelectSlotList"
                                      ItemsSource="{Binding QuickSelectSlots}"
                                      views:ReorderMoveAnimation.Enable="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RouteSlotViewModel">
                                    <GroupBox>
                                        <GroupBox.Header>
                                            <DockPanel LastChildFill="True">
                                                <TextBlock Classes="reorderGrip"
                                                           DockPanel.Dock="Left"
                                                           Margin="0,0,8,0"
                                                           Text="⋮⋮"
                                                           ToolTip.Tip="Drag to reorder this Quick Select row."
                                                           PointerPressed="OnQuickSelectSlotGripPressed"
                                                           PointerMoved="OnQuickSelectSlotGripMoved"
                                                           PointerReleased="OnQuickSelectSlotGripReleased"
                                                           PointerCaptureLost="OnQuickSelectSlotGripCaptureLost" />
                                                <TextBlock VerticalAlignment="Center" Text="{Binding DisplayName}" />
                                            </DockPanel>
                                        </GroupBox.Header>
                                        <Border Classes="slotRuntimeChrome"
                                                Classes.activeRuntimeLive="{Binding IsActiveRuntimeLive}"
                                                Classes.activeRuntimeAmber="{Binding IsActiveRuntimeAmber}"
                                                Classes.activeRuntimeFault="{Binding IsActiveRuntimeFault}"
                                                Classes.standbyHotLive="{Binding IsStandbyHotLive}"
                                                Classes.standbyHotAmber="{Binding IsStandbyHotAmber}"
                                                Classes.standbyHotFault="{Binding IsStandbyHotFault}"
                                                CornerRadius="6">
                                        <Grid>
                                        <Border Classes="slotLoadingFill"
                                                IsVisible="{Binding IsLoadingRuntimeSlot}"
                                                Opacity="{Binding LoadingPulseOpacity}"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                CornerRadius="6" />
                                        <Grid Margin="8"
                                              ColumnDefinitions="Auto,*,Auto"
                                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                              ColumnSpacing="10"
                                              RowSpacing="8">
                                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Validated profile" />
                                            <ComboBox Grid.Row="0"
                                                      Grid.Column="1"
                                                      Classes="quickSelectProfile"
                                                      ItemsSource="{Binding AvailableValidatedProfiles}"
                                                      SelectedItem="{Binding SelectedValidatedProfile}"
                                                      PlaceholderText="Choose a validated Model Profiles entry"
                                                      ItemTemplate="{StaticResource ValidatedProfileOptionTemplate}"
                                                      MaxDropDownHeight="480"
                                                      ToolTip.Tip="Only models that passed the 'Validate to endpoint' test on Model Profiles. Scroll if the list is long. ⚠ means this profile is not trusted right now: the last connection failed, settings were saved after the last successful Validate, or a local model is missing from the folder.">
                                                <ComboBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel />
                                                    </ItemsPanelTemplate>
                                                </ComboBox.ItemsPanel>
                                            </ComboBox>
                                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                                <Button Content="Save"
                                                        IsEnabled="{Binding CanSaveSlot}"
                                                        Command="{Binding SaveSlotCommand}"
                                                        ToolTip.Tip="Saves which model this row should Launch. Two rows cannot use the same named profile. Model profile variants of the same local model (temperature, max tokens, Images) can each have their own row." />
                                                <Button Content="Delete Slot" Command="{Binding DeleteSlotCommand}" views:MarkedText.Tip="Removes this shortcut row. The model is not stopped, your saved Model Profiles are not deleted, and the chat in the Client app is not erased. Click **Stop** first if you want to unload this row's model." />
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Spacing="2"
                                                        IsVisible="{Binding ShowActiveRuntimeStatus}">
                                                <TextBlock FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding ActiveRuntimeTelemetryBrush}"
                                                           Text="{Binding ActiveRuntimeStatusText}" />
                                                <TextBlock TextWrapping="Wrap"
                                                           FontSize="11"
                                                           Foreground="{Binding ActiveRuntimeTelemetryBrush}"
                                                           Text="{Binding ActiveRuntimeTelemetryText}"
                                                           IsVisible="{Binding ShowActiveRuntimeTelemetry}" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                                       TextWrapping="Wrap" FontSize="11"
                                                       Text="{Binding AttributeSummary}"
                                                       IsVisible="{Binding ShowSlotFacts}" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                                       TextWrapping="Wrap" FontSize="11" Opacity="0.72"
                                                       Text="{Binding ProfileSyncNote}"
                                                       IsVisible="{Binding ShowProfileSyncNote}" />
                                            <TextBlock Grid.Row="4"
                                                       Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       Text="Temperature"
                                                       IsVisible="{Binding ShowRequestOverlay}" />
                                            <WrapPanel Grid.Row="4"
                                                       Grid.Column="1"
                                                       Grid.ColumnSpan="2"
                                                       Orientation="Horizontal"
                                                       IsVisible="{Binding ShowRequestOverlay}">
                                                <NumericUpDown MinWidth="88"
                                                               Margin="0,0,16,4"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Center"
                                                               Minimum="0"
                                                               Maximum="2"
                                                               Increment="0.05"
                                                               Value="{Binding RequestTemperature}"
                                                               ToolTip.Tip="How mixed the wording is. Lower is more repeatable. Higher is more varied. Applies on the next Client-app message while this row is loaded." />
                                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,4">
                                                    <TextBlock VerticalAlignment="Center" FontSize="11" Text="Max tokens" />
                                                    <ComboBox MinWidth="96"
                                                              HorizontalAlignment="Left"
                                                              VerticalAlignment="Center"
                                                              ItemsSource="{Binding RequestMaxTokenOptions}"
                                                              SelectedItem="{Binding RequestMaxTokens}"
                                                              ToolTip.Tip="How long one answer can be. Applies on the next Client-app message while this row is loaded." />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                                                    <TextBlock VerticalAlignment="Center" FontSize="11" Text="Reasoning" />
                                                    <ComboBox MinWidth="96"
                                                              HorizontalAlignment="Left"
                                                              VerticalAlignment="Center"
                                                              ItemsSource="{Binding RequestReasoningOptions}"
                                                              SelectedItem="{Binding RequestReasoning}"
                                                              views:MarkedText.Tip="How much the local model thinks before it answers. **Off** is what a Client-app tool loop wants — the next message can run a test or command instead of spending Max tokens on a think. **Low**, **Medium**, and **XHigh** turn thinking on for this row. **XHigh** can use the whole reply budget before any tool call." />
                                                </StackPanel>
                                            </WrapPanel>
                                            <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasSavedAssignment}">
                                                        <Button Content="Launch" Command="{Binding LaunchCommand}" IsEnabled="{Binding CanLaunchSavedAssignment}" views:MarkedText.Tip="Starts this row's saved model. If you changed the dropdown, click **Save** first. If ⚠ is showing, run **Validate to endpoint** on Model Profiles first." />
                                                        <Button Content="Restart" Command="{Binding RestartCommand}" IsEnabled="{Binding CanLaunchSavedAssignment}" views:MarkedText.Tip="Loads this row's model again. If ⚠ is showing, run **Validate to endpoint** on Model Profiles first. Local: you wait, and the new load starts without the in-memory reading of this chat, so it may grasp less of what you already discussed (the Client app still has the messages and will usually send them again). Cloud: reconnects to the provider; the Client app's chat is unchanged." />
                                                        <Button Content="Stop" Command="{Binding StopCommand}" ToolTip.Tip="Stops this row's running model. Local: frees graphics memory and drops the in-memory reading of this chat. Cloud: disconnects that cloud model. The chat stays in the Client app; AI-FluxMux does not store that conversation." />
                                                    </StackPanel>
                                                    <Border IsVisible="{Binding IsStandbyHotSlot}"
                                                            Background="{DynamicResource FluxQuickSelectStandbyBackground}"
                                                            BorderBrush="{DynamicResource FluxQuickSelectStandbyBorder}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="8,4"
                                                            VerticalAlignment="Center"
                                                            ToolTip.Tip="This model is launched and ready.">
                                                        <TextBlock FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding ActiveRuntimeTelemetryBrush}"
                                                                   Text="{Binding ActiveRuntimeStatusText}" />
                                                    </Border>
                                                    <Border IsVisible="{Binding ShowHarnessOperationalControls}"
                                                            Background="{DynamicResource FluxTintPurpleBackground}"
                                                            BorderBrush="{DynamicResource FluxTintPurpleBorder}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="8,4"
                                                            VerticalAlignment="Center"
                                                            ToolTip.Tip="Experimental. Starts or opens DeepSeek Harness web chat for the active slot after Launch. Does not replace Launch — the local model must be running first.">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock VerticalAlignment="Center"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Opacity="0.88"
                                                                       Text="DeepSeek Harness launcher (experimental)" />
                                                            <Button Content="{Binding ElementName=RootWindow, Path=DataContext.HarnessWebChatButtonText}"
                                                                    Command="{Binding ElementName=RootWindow, Path=DataContext.StartHarnessWebCommand}"
                                                                    ToolTip.Tip="{Binding ElementName=RootWindow, Path=DataContext.HarnessWebChatButtonTooltip}" />
                                                            <Button Content="Stop Harness web"
                                                                    Command="{Binding ElementName=RootWindow, Path=DataContext.StopHarnessWebCommand}"
                                                                    ToolTip.Tip="{Binding ElementName=RootWindow, Path=DataContext.HarnessStopButtonTooltip}" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock TextWrapping="Wrap"
                                                           FontSize="11"
                                                           Opacity="0.82"
                                                           Text="{Binding ElementName=RootWindow, Path=DataContext.HarnessStopUnavailableHint}"
                                                           IsVisible="{Binding ElementName=RootWindow, Path=DataContext.ShowHarnessStopUnavailableHint}" />
                                            </StackPanel>
                                        </Grid>
                                        </Grid>
                                        </Border>
                                    </GroupBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Spacing="4" IsVisible="{Binding ShowQuickSelectSlotAddButton}">
                            <Button HorizontalAlignment="Left"
                                    IsEnabled="{Binding CanAddQuickSelectSlots}"
                                    Content="Add New Slot"
                                    Command="{Binding AddQuickSelectSlotCommand}"
                                    ToolTip.Tip="{Binding QuickSelectSlotAddButtonTooltip}" />
                            <TextBlock FontSize="11"
                                       Opacity="0.75"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding ShowQuickSelectSlotAddBlockedText}"
                                       Text="{Binding QuickSelectSlotAddBlockedText}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Servers" ToolTip.Tip="The port the Client app connects to, where local models live, which program runs them, and cloud API keys.">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10" Margin="0,8,0,8">
                        <GroupBox Header="Shared Connection Settings (Global)">
                            <StackPanel Margin="8" Spacing="10">
                                <Border Background="{DynamicResource FluxServersTintOrangeBackground}" BorderBrush="{DynamicResource FluxServersTintOrangeBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel Spacing="8">
                                        <TextBlock FontWeight="SemiBold" Text="Endpoint settings" />
                                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Port" />
                                            <NumericUpDown Grid.Column="1" MinWidth="120" Value="{Binding OrchestratorPort}" Minimum="1" Maximum="65534" ToolTip.Tip="OpenAI-compatible model API for the Client app (Port). AI-FluxMux also uses the daemon port — the private listen port for llama-server (usually Port+1). Do not point the Client app at the daemon port." />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Client app" />
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding EndpointAppOptions}"
                                                      SelectedItem="{Binding SelectedEndpointApp}"
                                                      ToolTip.Tip="Extra setup notes only. Cline, Harness, and other OpenAI Compatible clients can all use the same Port at once — you do not nominate who is talking. Routing dialogs always cover both Cline and Harness. DeepSeek Harness adds a launcher on Quick Select and a web UI port below." />
                                            <TextBlock Grid.Column="2"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       FontSize="11"
                                                       Opacity="0.85"
                                                       Text="{Binding EndpointModelAddressText}" />
                                        </Grid>
                                        <views:OptionInfoNote InfoId="servers.endpoint_intro"
                                                              NoteText="{Binding EndpointSettingsIntroText}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Export Endpoint adapters"
                                                    Command="{Binding ExportEndpointAdaptersCommand}"
                                                    ToolTip.Tip="Save Port, Client app, Harness web port, and EndpointAdapters JSON to a file you keep. No API keys or model profiles. Use this before a hand-edit, and keep a copy so a reinstall can Import it." />
                                            <Button Content="Import Endpoint adapters"
                                                    Command="{Binding ImportEndpointAdaptersCommand}"
                                                    ToolTip.Tip="Restore those fields from an export or from endpoint-adapters.example.json. Makes a timestamped backup of fluxmux_config.json first. Does not import cloud keys or model profiles." />
                                        </StackPanel>
                                        <Border IsVisible="{Binding ShowClineEndpointHint}"
                                                Background="{DynamicResource FluxMutedBackground}"
                                                BorderBrush="{DynamicResource FluxMutedBorder}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10">
                                            <StackPanel Spacing="8">
                                                <TextBlock FontWeight="SemiBold" Text="Cline (VS Code)" />
                                                <TextBlock TextWrapping="Wrap" Opacity="0.88" Text="{Binding ClineSettingsStatusText}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Content="Install guide (Cline)"
                                                            Command="{Binding OpenExternalLinkCommand}"
                                                            CommandParameter="https://marketplace.visualstudio.com/items?itemName=saoudrizwan.claude-dev"
                                                            ToolTip.Tip="Cline on the Visual Studio Marketplace. Install it from the Extensions panel of VS Code. AI-FluxMux does not install Cline." />
                                                    <Button Content="Cline docs"
                                                            Command="{Binding OpenExternalLinkCommand}"
                                                            CommandParameter="https://docs.cline.bot/"
                                                            ToolTip.Tip="Official Cline documentation." />
                                                    <Button Content="Open Cline releases"
                                                            Command="{Binding OpenExternalLinkCommand}"
                                                            CommandParameter="https://github.com/cline/cline/releases"
                                                            ToolTip.Tip="GitHub releases for Cline. AI-FluxMux does not install or upgrade Cline." />
                                                </StackPanel>
                                                <views:OptionInfoNote InfoId="servers.cline_hint"
                                                                      NoteText="{Binding ClineEndpointHintText}" />
                                            </StackPanel>
                                        </Border>
                                        <Border IsVisible="{Binding ShowGenericEndpointHint}"
                                                Background="{DynamicResource FluxMutedBackground}"
                                                BorderBrush="{DynamicResource FluxMutedBorder}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8">
                                            <views:OptionInfoNote InfoId="servers.generic_hint"
                                                                  NoteText="{Binding GenericEndpointHintText}" />
                                        </Border>
                                        <Border IsVisible="{Binding ShowHarnessServersPanel}"
                                                Background="{DynamicResource FluxServersTintPurpleBackground}"
                                                BorderBrush="{DynamicResource FluxServersTintPurpleBorder}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10">
                                            <StackPanel Spacing="8">
                                                <TextBlock FontWeight="SemiBold" Text="DeepSeek Harness (experimental)" />
                                                <TextBlock TextWrapping="Wrap" Opacity="0.88" Text="{Binding HarnessInstalledVersionText}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Content="Install guide (DeepSeek)"
                                                            Command="{Binding OpenExternalLinkCommand}"
                                                            CommandParameter="https://github.com/deepseek-ai/deepseek-harness#run-from-npm"
                                                            ToolTip.Tip="DeepSeek Harness install (Node.js, npx @deepseek-ai/dsh, or build from source)." />
                                                    <Button Content="Harness docs"
                                                            Command="{Binding OpenExternalLinkCommand}"
                                                            CommandParameter="https://deepseek-harness.github.io/deepseek-harness/"
                                                            ToolTip.Tip="Official DeepSeek Harness documentation." />
                                                    <Button Content="Open Harness releases"
                                                            Command="{Binding OpenHarnessReleasesCommand}"
                                                            ToolTip.Tip="GitHub releases for DeepSeek Harness. AI-FluxMux does not install or upgrade dsh." />
                                                </StackPanel>
                                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Harness web UI port" />
                                                    <NumericUpDown Grid.Column="1"
                                                                   MinWidth="120"
                                                                   Value="{Binding HarnessWebPort}"
                                                                   Minimum="1"
                                                                   Maximum="65534"
                                                                   ToolTip.Tip="Browser chat address bookmark. Default 3080. AI-FluxMux does not listen on this port." />
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Content="Copy settings.yaml"
                                                            Command="{Binding CopyHarnessSettingsYamlCommand}"
                                                            ToolTip.Tip="Copies a freshly generated FluxMux provider block for the loaded profile to the clipboard (not a copy of the on-disk file)." />
                                                    <Button Content="Write settings.yaml"
                                                            Command="{Binding WriteHarnessSettingsYamlCommand}"
                                                            ToolTip.Tip="Merges a freshly generated FluxMux provider block into %USERPROFILE%\.dsh\settings.yaml — same path as automatic sync; use to retry." />
                                                </StackPanel>
                                                <views:OptionInfoNote InfoId="servers.harness_summary"
                                                                      NoteText="{Binding HarnessServersSummaryText}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource FluxServersTintGreenBackground}" BorderBrush="{DynamicResource FluxServersTintGreenBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel Spacing="8">
                                        <TextBlock FontWeight="SemiBold" Text="Local model server" />
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Model Directory" />
                                            <TextBox Grid.Column="1" Text="{Binding LocalModelDirectory}" ToolTip.Tip="Put your local models here. Every local shortcut uses this same folder." />
                                            <Button Grid.Column="2" Content="Browse" Command="{Binding BrowseModelDirectoryCommand}" ToolTip.Tip="Choose the folder that holds your local models." />
                                        </Grid>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.78" Text="{Binding LocalModelDiscoveryText}" />
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="llama-server installation" />
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding InstalledLocalServerOptions}"
                                                      SelectedItem="{Binding SelectedInstalledLocalServer}"
                                                      PlaceholderText="No llama-server installation found"
                                                      ToolTip.Tip="The program AI-FluxMux starts and stops to run local models. Pick a detected install, or Browse if yours is not listed." />
                                            <Button Grid.Column="2"
                                                    Content="Browse"
                                                    Command="{Binding BrowseLocalServerExecutableCommand}"
                                                    ToolTip.Tip="Point to a llama-server.exe AI-FluxMux did not find automatically (for example a portable copy)." />
                                        </Grid>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.78" Text="{Binding LocalServerInstallationText}" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Content="Test Server Readiness"
                                                    Command="{Binding TestLocalServerReadinessCommand}"
                                                    ToolTip.Tip="Checks that llama-server is installed, the model folder exists, and the ports from Endpoint settings are free. Does not start a local model." />
                                        </StackPanel>
                                        <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Left"
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0">
                                            <CheckBox VerticalAlignment="Center"
                                                      Content="Port rules"
                                                      IsChecked="{Binding PortRules.Enabled}"
                                                      ToolTip.Tip="When Port rules are on, they watch for conditions that can derail a Client-app turn on local models, and can pause runaway looping. Turn them off to simply forward turns to llama-server without intervention. Cloud models do not use Port rules." />
                                            <views:HelpTopicLink TopicId="{x:Static svc:HelpTopicIds.PortRules}"
                                                                 ToolTip.Tip="Open the Port rules Help topic." />
                                        </StackPanel>
                                        <Expander Classes="fieldHeight"
                                                  Header="Advanced"
                                                  IsExpanded="False"
                                                  ToolTip.Tip="How a local Client-app chat is sent on to llama-server: Compact when Context fills, optionally pause a tool loop or hang, and retry a load. One checkbox turns off the outlined group it sits in. Cloud models do not use these.">
                                            <Expander.Resources>
                                                <x:Double x:Key="ExpanderMinHeight">32</x:Double>
                                                <Thickness x:Key="ExpanderHeaderPadding">8,0,0,0</Thickness>
                                                <Thickness x:Key="ExpanderChevronMargin">8,0,8,0</Thickness>
                                            </Expander.Resources>
                                            <StackPanel Spacing="10" Margin="0,8,0,0"
                                                        Grid.IsSharedSizeScope="True"
                                                        IsEnabled="{Binding PortRules.Enabled}">
                                                <TextBlock TextWrapping="Wrap"
                                                           FontSize="11"
                                                           Opacity="0.85"
                                                           Text="One checkbox turns off the outlined group it sits in. Compact, omit, and Max pictures only change the pack forwarded to llama-server. The Client app still has the full chat. Client-app max tokens and Stop strings are a choice, not on/off." />
                                                <StackPanel.Styles>
                                                    <Style Selector="NumericUpDown">
                                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                    </Style>
                                                    <Style Selector="ComboBox">
                                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                    </Style>
                                                    <Style Selector="Border.portRuleGroup">
                                                        <Setter Property="Background" Value="{DynamicResource FluxMutedBackground}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource FluxMutedBorder}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Setter Property="CornerRadius" Value="4" />
                                                        <Setter Property="Padding" Value="8" />
                                                    </Style>
                                                </StackPanel.Styles>
                                                <Border Classes="portRuleGroup">
                                                    <StackPanel Spacing="8">
                                                        <DockPanel>
                                                            <views:HelpTopicLink DockPanel.Dock="Right"
                                                                                 TopicId="{x:Static svc:HelpTopicIds.PortRules}"
                                                                                 ToolTip.Tip="Open the Port rules Help topic." />
                                                            <CheckBox FontWeight="SemiBold"
                                                                      Content="Compact"
                                                                      IsChecked="{Binding PortRules.CompactEnabled}"
                                                                      ToolTip.Tip="When off, AI-FluxMux does not shorten older turns forwarded to llama-server. The Client app still has the full chat." />
                                                        </DockPanel>
                                                        <Grid ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto" RowSpacing="6"
                                                              IsEnabled="{Binding PortRules.CompactEnabled}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleLabelA" />
                                                                <ColumnDefinition Width="*" SharedSizeGroup="PortRuleFieldA" />
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleLabelB" />
                                                                <ColumnDefinition Width="*" SharedSizeGroup="PortRuleFieldB" />
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleLabelC" />
                                                                <ColumnDefinition Width="*" SharedSizeGroup="PortRuleFieldC" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Watermark %"
                                                                       ToolTip.Tip="Compact when the forwarded prompt reaches this percent of Context, or when Context is already filling." />
                                                            <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="50" Maximum="95"
                                                                           Value="{Binding PortRules.CompactWatermarkPercent}" />
                                                            <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Text="Keep turns"
                                                                       ToolTip.Tip="Recent conversational turns left intact when Compact shortens older history." />
                                                            <NumericUpDown Grid.Row="0" Grid.Column="3" Minimum="4" Maximum="24"
                                                                           Value="{Binding PortRules.CompactKeepTurns}" />
                                                            <TextBlock Grid.Row="0" Grid.Column="4" VerticalAlignment="Center" Text="Tool keep turns"
                                                                       ToolTip.Tip="When the chat has tools, Compact keeps at least this many recent turns." />
                                                            <NumericUpDown Grid.Row="0" Grid.Column="5" Minimum="6" Maximum="32"
                                                                           Value="{Binding PortRules.CompactToolKeepTurns}" />
                                                            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Headroom"
                                                                       ToolTip.Tip="Tokens reserved so prompt plus reply still fit Context after Compact or a max-tokens clamp." />
                                                            <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="64" Maximum="4096"
                                                                           Value="{Binding PortRules.CompactHeadroom}" />
                                                            <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Text="Preserved user chars"
                                                                       ToolTip.Tip="How much of an older user task Compact may pin when that turn would otherwise drop." />
                                                            <NumericUpDown Grid.Row="1" Grid.Column="3" Minimum="500" Maximum="20000"
                                                                           Value="{Binding PortRules.CompactPreservedUserChars}" />
                                                            <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="6"
                                                                      VerticalAlignment="Center"
                                                                      Content="After Compact, skip prefix cache this turn"
                                                                      IsChecked="{Binding PortRules.SkipPrefixCacheAfterCompact}"
                                                                      ToolTip.Tip="Compact breaks the prompt prefix. This turn sends cache_prompt false. Session --no-cache-prompt stays on the model profile." />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <Border Classes="portRuleGroup">
                                                    <StackPanel Spacing="8">
                                                        <DockPanel>
                                                            <views:HelpTopicLink DockPanel.Dock="Right"
                                                                                 TopicId="{x:Static svc:HelpTopicIds.PortRules}"
                                                                                 ToolTip.Tip="Open the Port rules Help topic." />
                                                            <CheckBox FontWeight="SemiBold"
                                                                      Content="Omit"
                                                                      IsChecked="{Binding PortRules.OmitEnabled}"
                                                                      ToolTip.Tip="When off, older tool bodies stay in the pack forwarded to llama-server. Mill counts still see every result. The Client app still has the full output." />
                                                        </DockPanel>
                                                        <Grid ColumnSpacing="8" RowDefinitions="Auto" RowSpacing="6"
                                                              IsEnabled="{Binding PortRules.OmitEnabled}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleLabelA" />
                                                                <ColumnDefinition Width="*" SharedSizeGroup="PortRuleFieldA" />
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleLabelB" />
                                                                <ColumnDefinition Width="*" SharedSizeGroup="PortRuleFieldB" />
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleLabelC" />
                                                                <ColumnDefinition Width="*" SharedSizeGroup="PortRuleFieldC" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Keep recent results"
                                                                       ToolTip.Tip="Full tool bodies kept. Older ones are stubbed so llama-server still sees that the call ran." />
                                                            <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="4" Maximum="64"
                                                                           Value="{Binding PortRules.KeepRecentResults}" />
                                                            <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Text="Pin latest shell"
                                                                       ToolTip.Tip="Recent shell results pinned even when omit is dropping other bodies." />
                                                            <NumericUpDown Grid.Row="0" Grid.Column="3" Minimum="1" Maximum="16"
                                                                           Value="{Binding PortRules.PinLatestShellResults}" />
                                                            <TextBlock Grid.Row="0" Grid.Column="4" VerticalAlignment="Center" Text="Min chars to omit"
                                                                       ToolTip.Tip="Tool bodies shorter than this stay forwarded." />
                                                            <NumericUpDown Grid.Row="0" Grid.Column="5" Minimum="80" Maximum="2000"
                                                                           Value="{Binding PortRules.MinResultCharsToClear}" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <Grid ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Row="0" Grid.Column="0" Classes="portRuleGroup">
                                                        <StackPanel Spacing="4">
                                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                                <CheckBox VerticalAlignment="Center" Content="Mill at omitted"
                                                                          IsChecked="{Binding PortRules.MillAtOmittedEnabled}"
                                                                          ToolTip.Tip="End this Client-app turn when this many older tool results were omitted and the last tools are not a closed loop." />
                                                                <NumericUpDown Grid.Column="1" Minimum="8" Maximum="128"
                                                                               IsEnabled="{Binding PortRules.MillAtOmittedEnabled}"
                                                                               Value="{Binding PortRules.RunawayOmittedResults}" />
                                                                <views:HelpTopicLink Grid.Column="2"
                                                                                     TopicId="{x:Static svc:HelpTopicIds.PortRules}"
                                                                                     ToolTip.Tip="Open the Port rules Help topic." />
                                                            </Grid>
                                                            <TextBlock FontSize="11" Opacity="0.75"
                                                                       IsVisible="{Binding PortRules.MillAtOmittedTally, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                                                       Text="{Binding PortRules.MillAtOmittedTally}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Row="0" Grid.Column="1" Classes="portRuleGroup">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                            <CheckBox VerticalAlignment="Center" Content="Closed-loop lookback"
                                                                      IsChecked="{Binding PortRules.ClosedLoopLookbackEnabled}"
                                                                      ToolTip.Tip="How many recent tools FluxMux inspects. When off, Mill at omitted ends the turn at its count without that check." />
                                                            <NumericUpDown Grid.Column="1" Minimum="2" Maximum="16"
                                                                           IsEnabled="{Binding PortRules.ClosedLoopLookbackEnabled}"
                                                                           Value="{Binding PortRules.ClosedLoopMillLookback}" />
                                                            <views:HelpTopicLink Grid.Column="2"
                                                                                 TopicId="{x:Static svc:HelpTopicIds.PortRules}"
                                                                                 ToolTip.Tip="Open the Port rules Help topic." />
                                                        </Grid>
                                                    </Border>
                                                    <Border Grid.Row="0" Grid.Column="2" Classes="portRuleGroup">
                                                        <StackPanel Spacing="4">
                                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                                <CheckBox VerticalAlignment="Center" Content="Closed-loop mill ceiling"
                                                                          IsChecked="{Binding PortRules.ClosedLoopCeilingEnabled}"
                                                                          ToolTip.Tip="Last-resort pause when this many older tool results were omitted, even if the last tools still look useful. A valid closed loop may pass Mill at omitted (32) and keep going until this ceiling." />
                                                                <NumericUpDown Grid.Column="1" Minimum="32" Maximum="512"
                                                                               IsEnabled="{Binding PortRules.ClosedLoopCeilingEnabled}"
                                                                               Value="{Binding PortRules.ClosedLoopRunawayOmittedResults}" />
                                                                <views:HelpTopicLink Grid.Column="2"
                                                                                     TopicId="{x:Static svc:HelpTopicIds.PortRules}"
                                                                                     ToolTip.Tip="Open the Port rules Help topic." />
                                                            </Grid>
                                                            <TextBlock FontSize="11" Opacity="0.75"
                                                                       IsVisible="{Binding PortRules.ClosedLoopCeilingTally, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                                                       Text="{Binding PortRules.ClosedLoopCeilingTally}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Classes="portRuleGroup">
                                                        <StackPanel Spacing="8">
                                                            <DockPanel>
                                                                <views:HelpTopicLink DockPanel.Dock="Right"
                                                                                     TopicId="{x:Static svc:HelpTopicIds.PortRules}"
                                                                                     ToolTip.Tip="Open the Port rules Help topic." />
                                                                <CheckBox FontWeight="SemiBold"
                                                                          Content="Rapid-churn"
                                                                          IsChecked="{Binding PortRules.RapidChurnEnabled}"
                                                                          ToolTip.Tip="End this Client-app turn when tools arrive closer together than Seconds, this many times in a row, after omitted has passed Mill at omitted." />
                                                            </DockPanel>
                                                            <TextBlock FontSize="11" Opacity="0.75"
                                                                       IsVisible="{Binding PortRules.RapidChurnTally, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                                                       Text="{Binding PortRules.RapidChurnTally}" />
                                                            <Grid ColumnSpacing="8" ColumnDefinitions="Auto,*,Auto,*"
                                                                  IsEnabled="{Binding PortRules.RapidChurnEnabled}">
                                                                <TextBlock VerticalAlignment="Center" Text="Seconds"
                                                                           ToolTip.Tip="Turns closer together than this, with omitted past the mill count, count as rapid churn." />
                                                                <NumericUpDown Grid.Column="1" Minimum="1" Maximum="15"
                                                                               Value="{Binding PortRules.RapidChurnSeconds}" />
                                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Consecutive"
                                                                           ToolTip.Tip="How many rapid turns in a row end this Client-app turn even when the lookback looks like a closed loop." />
                                                                <NumericUpDown Grid.Column="3" Minimum="2" Maximum="12"
                                                                               Value="{Binding PortRules.RapidChurnConsecutive}" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Row="1" Grid.Column="2" Classes="portRuleGroup">
                                                        <StackPanel Spacing="4">
                                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                                <CheckBox VerticalAlignment="Center" Content="Observe-only mill"
                                                                          IsChecked="{Binding PortRules.ObserveOnlyMillEnabled}"
                                                                          ToolTip.Tip="End this Client-app turn when this many recent tools are screenshot/python/run with no file edit, even before Mill at omitted." />
                                                                <NumericUpDown Grid.Column="1" Minimum="4" Maximum="24"
                                                                               IsEnabled="{Binding PortRules.ObserveOnlyMillEnabled}"
                                                                               Value="{Binding PortRules.ObserveOnlyMillCount}" />
                                                                <views:HelpTopicLink Grid.Column="2"
                                                                                     TopicId="{x:Static svc:HelpTopicIds.PortRules}"
                                                                                     ToolTip.Tip="Open the Port rules Help topic." />
                                                            </Grid>
                                                            <TextBlock FontSize="11" Opacity="0.75"
                                                                       IsVisible="{Binding PortRules.ObserveOnlyTally, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                                                       Text="{Binding PortRules.ObserveOnlyTally}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Row="2" Grid.Column="0" Classes="portRuleGroup">
                                                        <StackPanel Spacing="4">
                                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                                <CheckBox VerticalAlignment="Center" Content="Max pictures"
                                                                          IsChecked="{Binding PortRules.MaxPicturesEnabled}"
                                                                          ToolTip.Tip="Oldest pictures are dropped from the pack forwarded to llama-server. The Client app still has the album." />
                                                                <NumericUpDown Grid.Column="1" Minimum="1" Maximum="8"
                                                                               IsEnabled="{Binding PortRules.MaxPicturesEnabled}"
                                                                               Value="{Binding PortRules.MaxForwardedImages}" />
                                                                <views:HelpTopicLink Grid.Column="2"
                                                                                     TopicId="{x:Static svc:HelpTopicIds.PortRules}"
                                                                                     ToolTip.Tip="Open the Port rules Help topic." />
                                                            </Grid>
                                                            <TextBlock FontSize="11" Opacity="0.75"
                                                                       IsVisible="{Binding PortRules.MaxPicturesTally, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                                                       Text="{Binding PortRules.MaxPicturesTally}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Row="2" Grid.Column="1" Classes="portRuleGroup">
                                                        <StackPanel Spacing="4">
                                                            <DockPanel>
                                                                <views:HelpTopicLink DockPanel.Dock="Right"
                                                                                     TopicId="{x:Static svc:HelpTopicIds.PortRules}"
                                                                                     ToolTip.Tip="Open the Port rules Help topic." />
                                                                <CheckBox VerticalAlignment="Center" Content="Repeated command"
                                                                          IsChecked="{Binding PortRules.RepeatedCommandEnabled}"
                                                                          ToolTip.Tip="End this Client-app turn when the Client app sends the same shell command again without reading the last result." />
                                                            </DockPanel>
                                                            <TextBlock FontSize="11" Opacity="0.75"
                                                                       IsVisible="{Binding PortRules.RepeatedCommandTally, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                                                       Text="{Binding PortRules.RepeatedCommandTally}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Row="2" Grid.Column="2" Classes="portRuleGroup">
                                                        <StackPanel Spacing="4">
                                                            <DockPanel>
                                                                <views:HelpTopicLink DockPanel.Dock="Right"
                                                                                     TopicId="{x:Static svc:HelpTopicIds.PortRules}"
                                                                                     ToolTip.Tip="Open the Port rules Help topic." />
                                                                <CheckBox VerticalAlignment="Center" Content="Diagnostic dump"
                                                                          IsChecked="{Binding PortRules.DiagnosticDumpEnabled}"
                                                                          ToolTip.Tip="End this Client-app turn when the Client app dumps a large diagnostic artifact instead of editing a project file." />
                                                            </DockPanel>
                                                            <TextBlock FontSize="11" Opacity="0.75"
                                                                       IsVisible="{Binding PortRules.DumpTally, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                                                       Text="{Binding PortRules.DumpTally}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>

                                                <Border Classes="portRuleGroup">
                                                    <StackPanel Spacing="8">
                                                        <DockPanel>
                                                            <views:HelpTopicLink DockPanel.Dock="Right"
                                                                                 TopicId="{x:Static svc:HelpTopicIds.PortRules}"
                                                                                 ToolTip.Tip="Open the Port rules Help topic." />
                                                            <CheckBox FontWeight="SemiBold"
                                                                      Content="Hang"
                                                                      IsChecked="{Binding PortRules.HangEnabled}"
                                                                      ToolTip.Tip="When off, AI-FluxMux does not open the hang prompt or abort a quiet llama-server stream." />
                                                        </DockPanel>
                                                        <TextBlock FontSize="11" Opacity="0.75"
                                                                   IsVisible="{Binding PortRules.HangTally, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                                                   Text="{Binding PortRules.HangTally}" />
                                                        <Grid ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="6"
                                                              IsEnabled="{Binding PortRules.HangEnabled}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleLabelA" />
                                                                <ColumnDefinition Width="*" SharedSizeGroup="PortRuleFieldA" />
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleLabelB" />
                                                                <ColumnDefinition Width="*" SharedSizeGroup="PortRuleFieldB" />
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleLabelC" />
                                                                <ColumnDefinition Width="*" SharedSizeGroup="PortRuleFieldC" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="First-byte seconds"
                                                                       ToolTip.Tip="Open the hang prompt if llama-server sends nothing for this long (non-thinking turns)." />
                                                            <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="5" Maximum="120"
                                                                           Value="{Binding PortRules.FirstByteSeconds}" />
                                                            <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Text="Think tokens / sec"
                                                                       ToolTip.Tip="Used to wait out a thinking budget before the hang prompt." />
                                                            <NumericUpDown Grid.Row="0" Grid.Column="3" Minimum="5" Maximum="80"
                                                                           Value="{Binding PortRules.ThinkTokensPerSecond}" />
                                                            <TextBlock Grid.Row="0" Grid.Column="4" VerticalAlignment="Center" Text="Max think first-byte"
                                                                       ToolTip.Tip="Cap on how long a thinking model may sit before the hang prompt." />
                                                            <NumericUpDown Grid.Row="0" Grid.Column="5" Minimum="30" Maximum="300"
                                                                           Value="{Binding PortRules.MaxThinkFirstByteSeconds}" />
                                                            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Stall seconds"
                                                                       ToolTip.Tip="Open the hang prompt if llama-server goes silent mid-stream for this long." />
                                                            <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="10" Maximum="180"
                                                                           Value="{Binding PortRules.StallSeconds}" />
                                                            <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Text="Wait-longer seconds"
                                                                       ToolTip.Tip="Extra quiet time if you choose to keep this turn open." />
                                                            <NumericUpDown Grid.Row="1" Grid.Column="3" Minimum="15" Maximum="180"
                                                                           Value="{Binding PortRules.WaitLongerSeconds}" />
                                                            <TextBlock Grid.Row="1" Grid.Column="4" VerticalAlignment="Center" Text="Decision seconds"
                                                                       ToolTip.Tip="How long the hang prompt waits for a choice before ending the turn." />
                                                            <NumericUpDown Grid.Row="1" Grid.Column="5" Minimum="10" Maximum="120"
                                                                           Value="{Binding PortRules.DecisionSeconds}" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <Border Classes="portRuleGroup">
                                                    <StackPanel Spacing="8">
                                                        <DockPanel>
                                                            <views:HelpTopicLink DockPanel.Dock="Right"
                                                                                 TopicId="{x:Static svc:HelpTopicIds.PortRules}"
                                                                                 ToolTip.Tip="Open the Port rules Help topic." />
                                                            <CheckBox FontWeight="SemiBold"
                                                                      Content="503"
                                                                      IsChecked="{Binding PortRules.Loading503Enabled}"
                                                                      ToolTip.Tip="Retry llama-server Loading model / 503 so the Client app does not mark Port dead during a cold load. FluxMux's own unused Port 503 is not retried." />
                                                        </DockPanel>
                                                        <TextBlock FontSize="11" Opacity="0.75"
                                                                   IsVisible="{Binding PortRules.Loading503Tally, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                                                   Text="{Binding PortRules.Loading503Tally}" />
                                                        <Grid ColumnSpacing="8" ColumnDefinitions="Auto,*,Auto,*"
                                                              IsEnabled="{Binding PortRules.Loading503Enabled}">
                                                            <TextBlock VerticalAlignment="Center" Text="Retries"
                                                                       ToolTip.Tip="Retry llama-server Loading model / 503 this many times. FluxMux's own unused Port 503 is not retried." />
                                                            <NumericUpDown Grid.Column="1" Minimum="0" Maximum="12"
                                                                           Value="{Binding PortRules.LoadingRetryCount}" />
                                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Delay seconds"
                                                                       ToolTip.Tip="Wait this long between Loading model retries. Total wait is capped." />
                                                            <NumericUpDown Grid.Column="3" Minimum="1" Maximum="10"
                                                                           Value="{Binding PortRules.LoadingRetryDelaySeconds}" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <Border Classes="portRuleGroup">
                                                    <DockPanel>
                                                    <views:HelpTopicLink DockPanel.Dock="Right"
                                                                         TopicId="{x:Static svc:HelpTopicIds.PortRules}"
                                                                         ToolTip.Tip="Open the Port rules Help topic." />
                                                    <Grid ColumnSpacing="8" RowDefinitions="Auto" ColumnDefinitions="Auto,*,Auto,*">
                                                        <TextBlock VerticalAlignment="Center" Text="Client-app max tokens"
                                                                   ToolTip.Tip="Whether the profile overlay, the Client app, or the smaller of the two sets max tokens. Reply is still clamped so prompt plus reply fit Context." />
                                                        <ComboBox Grid.Column="1"
                                                                  ItemsSource="{Binding PortRules.ClientMaxTokensModeOptions}"
                                                                  SelectedItem="{Binding PortRules.SelectedClientMaxTokensMode}" />
                                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Stop strings"
                                                                   ToolTip.Tip="Pass Client-app stop through, or ignore a list that can short-loop or cut thinking." />
                                                        <ComboBox Grid.Column="3"
                                                                  ItemsSource="{Binding PortRules.StopHygieneModeOptions}"
                                                                  SelectedItem="{Binding PortRules.SelectedStopHygieneMode}" />
                                                    </Grid>
                                                    </DockPanel>
                                                </Border>

                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Content="Save Port rules"
                                                            Command="{Binding PortRules.SaveCommand}"
                                                            ToolTip.Tip="Write port_forwarding_rules.json next to fluxmux_config.json and use these numbers on the next Client-app turn." />
                                                    <Button Content="Load Port rules"
                                                            Command="{Binding PortRules.LoadSavedCommand}"
                                                            ToolTip.Tip="Throw away unsaved edits and put back the last saved Port rules file. If that file is missing, show the built-in defaults." />
                                                    <Button Content="Revert to defaults"
                                                            Command="{Binding PortRules.ResetCommand}"
                                                            ToolTip.Tip="Fill the built-in Compact, omit, mill, hang, 503, cache, max tokens, and stop numbers. Save Port rules to keep them, or Load Port rules to put the last saved file back." />
                                                </StackPanel>
                                                <TextBlock TextWrapping="Wrap"
                                                           FontSize="11"
                                                           Opacity="0.85"
                                                           IsVisible="{Binding PortRules.StatusText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                                           views:MarkedText.Source="{Binding PortRules.StatusText}" />
                                                <TextBlock TextWrapping="Wrap"
                                                           FontSize="11"
                                                           Opacity="0.85"
                                                           Text="Every Client app on Port shares these numbers. Save applies on the next local turn without reloading llama-server." />
                                            </StackPanel>
                                        </Expander>
                                        </DockPanel>
                                        <TextBlock TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Opacity="0.85"
                                                   Text="When Port rules are on, they watch for conditions that can derail a Client-app turn on local models, and can pause runaway looping. Turn them off to simply forward turns to llama-server without intervention. Cloud models do not use Port rules." />
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource FluxServersTintBlueBackground}" BorderBrush="{DynamicResource FluxServersTintBlueBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel Spacing="8">
                                        <TextBlock FontWeight="SemiBold" Text="Cloud provider" />
                                        <Grid ColumnDefinitions="Auto,*,Auto,2*,Auto,Auto" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Cloud AI Model Provider" />
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding CloudProviders}"
                                                      SelectedItem="{Binding SelectedCredentialCloudProvider}"
                                                      ItemTemplate="{StaticResource CloudProviderOptionTemplate}"
                                                      ToolTip.Tip="Which cloud company this key is for. Changing this does not switch which model is running." />
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="API Key" />
                                            <TextBox Grid.Column="3"
                                                     Text="{Binding CloudApiKeyEntry}"
                                                     PasswordChar="*"
                                                     PlaceholderText="Paste or type API key for selected provider"
                                                     ToolTip.Tip="Secret from the cloud company. Asterisks mean a key is already saved for this company. Paste a new key to replace it. Which models you can use depends on your paid plan with them." />
                                            <Button Grid.Column="4" Content="Validate Cloud Key" Command="{Binding ValidateCloudCommand}" ToolTip.Tip="Asks the cloud company if this key works. Paste or save the key first." />
                                            <Button Grid.Column="5" Content="Save Key" Command="{Binding SaveCloudApiKeyCommand}" ToolTip.Tip="Stores the key on this computer. Asterisks stay in the box to show a key is saved, without showing the real key." />
                                        </Grid>
                                        <TextBlock TextWrapping="Wrap" Text="{Binding CloudCredentialsHelpText}" Opacity="0.75" FontSize="11" />
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding ShowCustomOpenAiCompatibleSettings}">
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Base URL" />
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding CustomCompatEndpoint}"
                                                     PlaceholderText="https://host:port/v1"
                                                     ToolTip.Tip="Web address of this custom cloud-style server. Include /v1 if that server uses it. This is not a model name." />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,Auto" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Name" />
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding NewCustomCloudProviderName}"
                                                     PlaceholderText="Required name (e.g. Work vLLM)"
                                                     ToolTip.Tip="Required display name for this OpenAI-compatible server. Saved into the custom provider registry and shown in Provider lists." />
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Base URL" />
                                            <TextBox Grid.Column="3"
                                                     Text="{Binding NewCustomCloudProviderEndpoint}"
                                                     PlaceholderText="https://api.example.com/v1"
                                                     ToolTip.Tip="Base URL for the named custom provider. Required with Name when you Add custom provider." />
                                            <Button Grid.Column="4"
                                                    Content="Add custom provider"
                                                    Command="{Binding AddCustomCloudProviderCommand}"
                                                    ToolTip.Tip="Registers this named OpenAI-compatible provider in the custom registry (CustomCloudProviders) so it stays in Provider lists with its own URL and key." />
                                            <Button Grid.Column="5"
                                                    Content="Remove custom"
                                                    Command="{Binding RemoveCustomCloudProviderCommand}"
                                                    IsEnabled="{Binding CanRemoveSelectedCustomCloudProvider}"
                                                    ToolTip.Tip="Removes the selected named custom provider when no Model Profiles still use it." />
                                        </Grid>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.75"
                                                   Text="Google/Gemini, Anthropic, OpenAI, and Copilot GitHub only need the key. Built-in OpenAI-compatible providers (Groq, DeepSeek, OpenRouter, Together, Fireworks, Mistral, xAI, Cerebras, Perplexity, Cohere, DeepInfra, SambaNova, NVIDIA, Hugging Face, Hyperbolic, Ollama, LM Studio) appear with usual base URLs — paste each key and Save Key. Any other server needs a Name and Base URL — Add custom provider writes it into the registry." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Model Profiles" ToolTip.Tip="Create model profiles for each local model or cloud model, then test that they actually answer before they appear in Quick Select.">
                <ScrollViewer x:Name="ModelProfilesScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12" Margin="0,8,0,8">
                        <Border Grid.Row="0"
                                Background="{DynamicResource FluxMutedBackground}"
                                BorderBrush="{DynamicResource FluxMutedBorder}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8">
                            <StackPanel Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="Model profile pack" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Export model profiles"
                                            Command="{Binding ExportModelProfilesCommand}"
                                            ToolTip.Tip="Save LocalProfiles and CloudProfiles to a file you keep. No API keys. Validate stamps are stripped. This file is not the live store." />
                                    <Button Content="Import model profiles"
                                            Command="{Binding ImportModelProfilesCommand}"
                                            ToolTip.Tip="Writes a pre-import export next to fluxmux_config.json first, then patches from the chosen pack. Rejects secrets, scripts, and a full fluxmux_config.json. Skips a local row when the .gguf is not in the Model Directory, or when Images is on and no vision projector (mmproj) is found. Does not overwrite a live row that already exists with different settings. If rows are added, also saves fluxmux_config.json.bak-profiles-…. Each skip is listed on Diagnostics." />
                                </StackPanel>
                                <TextBlock FontSize="11"
                                           Opacity="0.85"
                                           TextWrapping="Wrap"
                                           Text="Export writes a temporary JSON pack (no API keys). Import patches the live fluxmux_config.json with pack contents, but only if the pack coding is clean. Any imported profiles with existing name but different settings are skipped; profiles with existing settings but different name are skipped. See Help: Model profile packs." />
                            </StackPanel>
                        </Border>
                        <GroupBox Grid.Row="1" Header="Cloud Profiles">
                            <StackPanel Spacing="10" Margin="8">
                                <Border Background="{DynamicResource FluxMutedBackground}"
                                        BorderBrush="{DynamicResource FluxMutedBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,8">
                                    <StackPanel Spacing="8">
                                        <TextBlock FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource FluxHeadingForeground}"
                                                   Text="Create a cloud model profile" />
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" RowSpacing="6">
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Provider" />
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding CloudProviders}"
                                                      SelectedItem="{Binding NewCloudProfileProvider}"
                                                      ItemTemplate="{StaticResource CloudProviderOptionTemplate}"
                                                      MaxDropDownHeight="480"
                                                      ToolTip.Tip="Cloud company for a new default. Save that company's API key on the Servers tab first." />
                                            <Button Grid.Column="2"
                                                    Content="Refresh Models"
                                                    Command="{Binding RefreshNewCloudProfileModelsCommand}"
                                                    ToolTip.Tip="Downloads this company's current model names using your saved key. If yours is missing, paste the name in the box below." />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Model id" />
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding NewCloudProfileModels}"
                                                      SelectedItem="{Binding NewCloudProfileSelectedModel}"
                                                      ToolTip.Tip="The short name the company uses for the model, not a website address." />
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Or paste id" />
                                            <TextBox Grid.Column="3"
                                                     PlaceholderText="gemini-2.5-flash or gpt-4.1"
                                                     Text="{Binding NewCloudProfileCustomModelId}"
                                                     ToolTip.Tip="Type or paste a model name if Refresh Models did not list it." />
                                            <Button Grid.Column="4"
                                                    Content="Create new cloud model profile"
                                                    Command="{Binding CreateNewCloudModelProfileCommand}"
                                                    views:MarkedText.Tip="Creates a locked default for this cloud model. Run **Validate to endpoint** before it can be used in Quick Select." />
                                        </Grid>
                                        <TextBlock FontSize="11"
                                                   Opacity="0.88"
                                                   Foreground="{DynamicResource FluxSecondaryForeground}"
                                                   TextWrapping="Wrap"
                                                   views:MarkedText.Source="{Binding CloudModelIdHelpText}" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Spacing="6">
                                    <TextBlock FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="Existing cloud profiles" />
                                <ListBox x:Name="CloudVariantList"
                                         Classes="profileTree"
                                         ItemsSource="{Binding CloudVariantTreeItems}"
                                         SelectedItem="{Binding SelectedCloudVariantItem}"
                                         AutoScrollToSelectedItem="False"
                                         HorizontalAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.Styles>
                                        <Style Selector="ListBox /template/ ScrollViewer">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="AllowAutoHide" Value="True" />
                                        </Style>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CloudVariantTreeItemViewModel">
                                            <Expander Classes="profileExpander" HorizontalAlignment="Stretch" Margin="{Binding RowMargin}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Expanded="VariantExpander_Expanded" Collapsing="VariantExpander_Collapsing" Padding="0" BorderThickness="0">
                                                <Expander.Header>
                                            <Border Classes="profileHeaderChrome"
                                                            Classes.profileSelected="{Binding IsSelected}"
                                                            Classes.profileExpanded="{Binding IsExpanded}"
                                                            HorizontalAlignment="Stretch"
                                                            ToolTip.Tip="{Binding ProfileParadigmTooltip}">
                                                    <Border MinHeight="36" Padding="6,4" CornerRadius="6" Background="{Binding HeaderBackground}" BorderBrush="{Binding HeaderBorderBrush}" BorderThickness="1" HorizontalAlignment="Stretch">
                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" HorizontalAlignment="Stretch">
                                                            <Panel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Classes="profileStatusIcon"
                                                                           Text="⚠"
                                                                           Foreground="#F87171"
                                                                           IsVisible="{Binding ShowMissingFileWarning, FallbackValue=False, TargetNullValue=False}"
                                                                           ToolTip.Tip="{Binding MissingFileWarningTooltip}" />
                                                                <TextBlock Classes="profileStatusIcon"
                                                                           Text="✓"
                                                                           Foreground="#4ADE80"
                                                                           IsVisible="{Binding ShowValidatedCheck, FallbackValue=False, TargetNullValue=False}"
                                                                           ToolTip.Tip="{Binding EndpointStatusText}" />
                                                            </Panel>
                                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <Border Classes="corporateLogoBadge"
                                                                            IsVisible="{Binding HasLogo, FallbackValue=False}"
                                                                            ToolTip.Tip="{Binding LogoCompanyName}">
                                                                        <Image Classes="corporateLogo"
                                                                               Source="{Binding LogoAssetKey, Converter={x:Static vm:CorporateLogoImageConverter.Instance}}" />
                                                                    </Border>
                                                                    <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{Binding HeaderForeground}" Text="{Binding DisplayName}" />
                                                                </StackPanel>
                                                                <TextBlock FontSize="10" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{Binding HeaderMutedForeground}" Text="{Binding SettingsSummary}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="180">
                                                                <TextBlock FontSize="10"
                                                                           FontStyle="Italic"
                                                                           TextAlignment="Right"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="{Binding HeaderMutedForeground}"
                                                                           Text="{Binding RoleLabel}" />
                                                                <Border Classes="profileEditingBadge"
                                                                        HorizontalAlignment="Right"
                                                                        IsVisible="{Binding ShowEditingMarker, FallbackValue=False}">
                                                                    <TextBlock Text="editing this profile"
                                                                               FontSize="10"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#F8FAFC" />
                                                                </Border>
                                                            </StackPanel>
                                                            <Button Grid.Column="3"
                                                                    Classes="headerLockButton"
                                                                    IsVisible="{Binding ShowDefaultLockToggle, FallbackValue=False}"
                                                                    ToolTip.Tip="{Binding DefaultLockTooltip}">
                                                                <Panel Width="20" Height="20">
                                                                    <Viewbox IsVisible="{Binding ShowLockedPadlock, FallbackValue=False}" Stretch="Uniform">
                                                                        <Canvas Width="16" Height="16">
                                                                            <Path Stroke="{Binding HeaderForeground}" StrokeThickness="1.5" StrokeLineCap="Round" Fill="Transparent"
                                                                                  Data="M 4.5,7.4 V 5.1 C 4.5,3.2 6.2,1.8 8,1.8 C 9.8,1.8 11.5,3.2 11.5,5.1 V 7.4" />
                                                                            <Path Fill="{Binding HeaderForeground}" Data="M 3.1,7.4 H 12.9 V 14.3 C 12.9,14.8 12.5,15.2 12,15.2 H 4 C 3.5,15.2 3.1,14.8 3.1,14.3 Z" />
                                                                        </Canvas>
                                                                    </Viewbox>
                                                                    <Viewbox IsVisible="{Binding ShowUnlockedPadlock, FallbackValue=False}" Stretch="Uniform">
                                                                        <Canvas Width="16" Height="16">
                                                                            <Path Stroke="{Binding HeaderForeground}" StrokeThickness="1.5" StrokeLineCap="Round" Fill="Transparent"
                                                                                  Data="M 4.5,7.4 V 5.1 C 4.5,3.2 6.2,1.8 8,1.8 C 9.8,1.8 11.5,3.2 11.5,5.1 V 3.4" />
                                                                            <Path Fill="{Binding HeaderForeground}" Data="M 3.1,7.4 H 12.9 V 14.3 C 12.9,14.8 12.5,15.2 12,15.2 H 4 C 3.5,15.2 3.1,14.8 3.1,14.3 Z" />
                                                                        </Canvas>
                                                                    </Viewbox>
                                                                </Panel>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                    </Border>
                                                </Expander.Header>
                                                <ContentControl HorizontalAlignment="Stretch"
                                                                Content="{Binding InlineEditor}"
                                                                ContentTemplate="{StaticResource CloudProfileEditorTemplate}" />
                                            </Expander>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                    <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap" views:MarkedText.Source="Locked default model profiles appear in the list after Creation. Click the padlock to unlock and edit, rename, or replace AI-FluxMux auto settings; click it again to lock. Provider and Model id live in Detailed settings and save with **Save profile**. If **Validate to endpoint** fails, change those fields, **Save profile**, then **Validate to endpoint** again. On successful validation, the profile becomes an available set up option for the Quick Select tab. **Make New Variant** copies the current profile for tweaking as a new model profile variant, with a different settings package. Deleting a default model profile removes that model and all its variants from AI-FluxMux after confirmation." />
                                </StackPanel>


                            </StackPanel>
                        </GroupBox>

                        <GroupBox Grid.Row="2" Header="Local Profiles">
                            <StackPanel Spacing="10" Margin="8">
                                <Border Background="{DynamicResource FluxMutedBackground}"
                                        BorderBrush="{DynamicResource FluxMutedBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,8">
                                    <StackPanel Spacing="8">
                                        <TextBlock FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource FluxHeadingForeground}"
                                                   Text="Create a local model profile" />
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Local model" />
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding LocalProfiles}"
                                                      SelectedItem="{Binding NewLocalProfileModel}"
                                                      ToolTip.Tip="Local models found in the folder you set on the Servers tab." />
                                            <Button Grid.Column="2"
                                                    Content="Create new local model profile"
                                                    Command="{Binding CreateNewLocalModelProfileCommand}"
                                                    views:MarkedText.Tip="Creates a locked default for this local model. Run **Validate to endpoint** before it can be used in Quick Select." />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <StackPanel Spacing="6">
                                    <TextBlock FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="Existing local profiles" />
                                <ListBox x:Name="LocalVariantList"
                                         Classes="profileTree"
                                         ItemsSource="{Binding LocalVariantTreeItems}"
                                         SelectedItem="{Binding SelectedLocalVariantItem}"
                                         AutoScrollToSelectedItem="False"
                                         HorizontalAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.Styles>
                                        <Style Selector="ListBox /template/ ScrollViewer">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="AllowAutoHide" Value="True" />
                                        </Style>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CloudVariantTreeItemViewModel">
                                            <Expander Classes="profileExpander" HorizontalAlignment="Stretch" Margin="{Binding RowMargin}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Expanded="VariantExpander_Expanded" Collapsing="VariantExpander_Collapsing" Padding="0" BorderThickness="0">
                                                <Expander.Header>
                                            <Border Classes="profileHeaderChrome"
                                                            Classes.profileSelected="{Binding IsSelected}"
                                                            Classes.profileExpanded="{Binding IsExpanded}"
                                                            HorizontalAlignment="Stretch"
                                                            ToolTip.Tip="{Binding ProfileParadigmTooltip}">
                                                    <Border MinHeight="36" Padding="6,4" CornerRadius="6" Background="{Binding HeaderBackground}" BorderBrush="{Binding HeaderBorderBrush}" BorderThickness="1" HorizontalAlignment="Stretch">
                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" HorizontalAlignment="Stretch">
                                                            <Panel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Classes="profileStatusIcon"
                                                                           Text="⚠"
                                                                           Foreground="#F87171"
                                                                           IsVisible="{Binding ShowMissingFileWarning, FallbackValue=False, TargetNullValue=False}"
                                                                           ToolTip.Tip="{Binding MissingFileWarningTooltip}" />
                                                                <TextBlock Classes="profileStatusIcon"
                                                                           Text="✓"
                                                                           Foreground="#4ADE80"
                                                                           IsVisible="{Binding ShowValidatedCheck, FallbackValue=False, TargetNullValue=False}"
                                                                           ToolTip.Tip="{Binding EndpointStatusText}" />
                                                            </Panel>
                                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <Border Classes="corporateLogoBadge"
                                                                            IsVisible="{Binding HasLogo, FallbackValue=False}"
                                                                            ToolTip.Tip="{Binding LogoCompanyName}">
                                                                        <Image Classes="corporateLogo"
                                                                               Source="{Binding LogoAssetKey, Converter={x:Static vm:CorporateLogoImageConverter.Instance}}" />
                                                                    </Border>
                                                                    <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{Binding HeaderForeground}" Text="{Binding DisplayName}" />
                                                                </StackPanel>
                                                                <TextBlock FontSize="10" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{Binding HeaderMutedForeground}" Text="{Binding SettingsSummary}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="180">
                                                                <TextBlock FontSize="10"
                                                                           FontStyle="Italic"
                                                                           TextAlignment="Right"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="{Binding HeaderMutedForeground}"
                                                                           Text="{Binding RoleLabel}" />
                                                                <Border Classes="profileEditingBadge"
                                                                        HorizontalAlignment="Right"
                                                                        IsVisible="{Binding ShowEditingMarker, FallbackValue=False}">
                                                                    <TextBlock Text="editing this profile"
                                                                               FontSize="10"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#F8FAFC" />
                                                                </Border>
                                                            </StackPanel>
                                                            <Button Grid.Column="3"
                                                                    Classes="headerLockButton"
                                                                    IsVisible="{Binding ShowDefaultLockToggle, FallbackValue=False}"
                                                                    ToolTip.Tip="{Binding DefaultLockTooltip}">
                                                                <Panel Width="20" Height="20">
                                                                    <Viewbox IsVisible="{Binding ShowLockedPadlock, FallbackValue=False}" Stretch="Uniform">
                                                                        <Canvas Width="16" Height="16">
                                                                            <Path Stroke="{Binding HeaderForeground}" StrokeThickness="1.5" StrokeLineCap="Round" Fill="Transparent"
                                                                                  Data="M 4.5,7.4 V 5.1 C 4.5,3.2 6.2,1.8 8,1.8 C 9.8,1.8 11.5,3.2 11.5,5.1 V 7.4" />
                                                                            <Path Fill="{Binding HeaderForeground}" Data="M 3.1,7.4 H 12.9 V 14.3 C 12.9,14.8 12.5,15.2 12,15.2 H 4 C 3.5,15.2 3.1,14.8 3.1,14.3 Z" />
                                                                        </Canvas>
                                                                    </Viewbox>
                                                                    <Viewbox IsVisible="{Binding ShowUnlockedPadlock, FallbackValue=False}" Stretch="Uniform">
                                                                        <Canvas Width="16" Height="16">
                                                                            <Path Stroke="{Binding HeaderForeground}" StrokeThickness="1.5" StrokeLineCap="Round" Fill="Transparent"
                                                                                  Data="M 4.5,7.4 V 5.1 C 4.5,3.2 6.2,1.8 8,1.8 C 9.8,1.8 11.5,3.2 11.5,5.1 V 3.4" />
                                                                            <Path Fill="{Binding HeaderForeground}" Data="M 3.1,7.4 H 12.9 V 14.3 C 12.9,14.8 12.5,15.2 12,15.2 H 4 C 3.5,15.2 3.1,14.8 3.1,14.3 Z" />
                                                                        </Canvas>
                                                                    </Viewbox>
                                                                </Panel>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                    </Border>
                                                </Expander.Header>
                                                <ContentControl HorizontalAlignment="Stretch"
                                                                Content="{Binding InlineEditor}"
                                                                ContentTemplate="{StaticResource LocalProfileEditorTemplate}" />
                                            </Expander>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                    <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap" views:MarkedText.Source="Locked default model profiles appear in the list after Creation. Click the padlock to unlock and edit, rename, or replace AI-FluxMux auto settings; click it again to lock. If **Validate to endpoint** fails, change the settings, **Save profile**, then **Validate to endpoint** again. On successful validation, the profile becomes an available set up option for the Quick Select tab. **Make New Variant** copies the current profile for tweaking as a new model profile variant, with a different settings package. Deleting a default model profile removes that model and all its variants from AI-FluxMux after confirmation." />
                                </StackPanel>


                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Live-Switch Testing" ToolTip.Tip="Lab tests: how well a chat survives switching between two tested models (two locals, local and cloud, or two clouds). This unloads and reloads; it is not everyday routing.">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10" Margin="0,8,0,8">
                        <GroupBox Header="Profile switch guidance">
                            <StackPanel Margin="8" Spacing="8">
                                <TextBlock TextWrapping="Wrap"
                                           Text="This is for testing task continuity when switching between any two model profiles in one chat. This allows you to compare one pairing with another with different model profile settings." />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Model switch performance testing">
                            <StackPanel Margin="8" Spacing="8">
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Profile A" />
                                    <ComboBox Grid.Row="0"
                                              Grid.Column="1"
                                              ItemsSource="{Binding SwitchBenchmarkProfiles}"
                                              SelectedItem="{Binding SelectedSwitchBenchmarkProfileA}"
                                              ItemTemplate="{StaticResource SwitchBenchmarkProfileOptionTemplate}"
                                              ToolTip.Tip="First tested model in the switch. Local or cloud. ⚠ means this profile is not trusted right now: last connection failed, settings were saved after Validate, or a local model is missing." />

                                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Profile B" />
                                    <ComboBox Grid.Row="1"
                                              Grid.Column="1"
                                              ItemsSource="{Binding SwitchBenchmarkProfiles}"
                                              SelectedItem="{Binding SelectedSwitchBenchmarkProfileB}"
                                              ItemTemplate="{StaticResource SwitchBenchmarkProfileOptionTemplate}"
                                              ToolTip.Tip="Second tested model in the switch. Local or cloud. ⚠ means this profile is not trusted right now: last connection failed, settings were saved after Validate, or a local model is missing." />

                                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" Text="Focus" />
                                    <TextBox Grid.Row="2"
                                             Grid.Column="1"
                                             Text="{Binding SwitchBenchmarkFocusText}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             PlaceholderText="Describe the continuity or context-retention scenario to test." />

                                    <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="Order" />
                                    <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding SwitchBenchmarkOrderOptions}"
                                                  SelectedItem="{Binding SelectedSwitchBenchmarkOrder}" />
                                        <Button Grid.Column="1"
                                                Content="Run test"
                                                Command="{Binding RunSwitchBenchmarkCommand}" />
                                    </Grid>
                                </Grid>
                                <TextBlock TextWrapping="Wrap"
                                           FontSize="11"
                                           Opacity="0.75"
                                           Text="Nominate any two cloud or local model profiles; one as Profile A and one as Profile B. (Only profiles that have been validated to endpoint in their respective settings panels are offered.) The benchmark will launch Profile A with a nominal task, hand the chat to Profile B, then return it to Profile A and then score how well the task anchors survived the round trip." />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" RowSpacing="8">
                                    <TextBlock Grid.Column="0" VerticalAlignment="Top" Text="Result" />
                                    <TextBox Grid.Column="1"
                                             IsReadOnly="True"
                                             Text="{Binding SwitchBenchmarkResultText}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap" />
                                </Grid>
                                <StackPanel Spacing="4">
                                    <TextBlock FontWeight="SemiBold" Text="Summary" />
                                    <TextBlock TextWrapping="Wrap" Text="{Binding SwitchBenchmarkSummaryText}" />
                                    <TextBlock FontWeight="SemiBold" Text="Recommendation" />
                                    <TextBlock TextWrapping="Wrap" Text="{Binding SwitchBenchmarkRecommendationText}" />
                                </StackPanel>
                                <Expander Header="Advanced details" IsExpanded="False">
                                    <TextBox IsReadOnly="True"
                                             Text="{Binding SwitchBenchmarkAdvancedDetailsText}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                </Expander>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Environment" ToolTip.Tip="Checks llama-server, the model folder, the graphics card, paths, and cloud keys.">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Margin="0,8,0,8">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Content="Refresh" Command="{Binding CheckDependenciesCommand}" ToolTip.Tip="Check again after you change folders, keys, or hardware." />
                            <Button Content="Capture Known-Good Snapshot" Command="{Binding CaptureDependencyBaselineCommand}" ToolTip.Tip="After things work, save today's llama-server version and paths so you can compare later." />
                            <Button Content="Export Report" Command="{Binding ExportDependencyBomCommand}" ToolTip.Tip="Save this environment check as a file you can share." />
                        </StackPanel>

                        <GroupBox Header="AI-FluxMux updates">
                            <StackPanel Margin="8" Spacing="8">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <TextBlock VerticalAlignment="Center" Text="Update feed URL" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding UpdateFeedUrl}"
                                             PlaceholderText="https://…/fluxmux-updates.json"
                                             ToolTip.Tip="Full http or https address of an AI-FluxMux update JSON file. Not required until you have a public host." />
                                </Grid>
                                <TextBlock TextWrapping="Wrap"
                                           FontSize="11"
                                           Opacity="0.85"
                                           Text="Paste a feed URL when you have a public host. Leave this blank until then. The feed is a small JSON file: it can name a newer AI-FluxMux download, and it can replace Help.html (llama.cpp links, Harness yaml, and similar) without a new build. A sample file is fluxmux-updates.example.json in the AI-FluxMux folder." />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Check for updates"
                                            Command="{Binding CheckForUpdatesCommand}">
                                        <ToolTip.Tip>
                                            <TextBlock TextWrapping="Wrap" MaxWidth="420"
                                                       Text="Reads the feed URL if one is set (Help.html and the AI-FluxMux download link). Also checks llama.cpp nightlies for a newer zip of the same Windows CUDA / Vulkan / CPU family as the llama-server folder already in use, and reads this PC's DeepSeek Harness version against npm latest / next. Confirm the llama-server folder is still the correct install to update — hardware may have changed. AI-FluxMux never extracts over the current folder and does not install or upgrade DeepSeek Harness." />
                                        </ToolTip.Tip>
                                    </Button>
                                    <Button Content="Open download page"
                                            Command="{Binding OpenUpdateDownloadCommand}"
                                            IsVisible="{Binding UpdateDownloadAvailable}"
                                            ToolTip.Tip="Opens the download address from the feed. AI-FluxMux does not replace its own program file." />
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" Opacity="0.88" Text="{Binding UpdateCheckStatusText}" />
                                <TextBlock FontWeight="SemiBold" Text="llama-server" />
                                <TextBlock TextWrapping="Wrap" Opacity="0.88" Text="{Binding LlamaServerUpdateStatusText}" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="Open matching llama-server zip"
                                            Margin="0,0,8,6"
                                            Command="{Binding OpenLlamaServerZipCommand}"
                                            IsVisible="{Binding LlamaServerZipAvailable}">
                                        <ToolTip.Tip>
                                            <TextBlock TextWrapping="Wrap" MaxWidth="420"
                                                       Text="Opens the zip that matches this llama-server folder's family. Confirm that family is still correct for this PC before extracting — hardware may have changed. Extract into a new folder. Keep the old one until Launch works." />
                                        </ToolTip.Tip>
                                    </Button>
                                    <Button Content="Open matching CUDA DLLs zip"
                                            Margin="0,0,8,6"
                                            Command="{Binding OpenLlamaCudartZipCommand}"
                                            IsVisible="{Binding LlamaCudartZipAvailable}">
                                        <ToolTip.Tip>
                                            <TextBlock TextWrapping="Wrap" MaxWidth="420"
                                                       Text="Opens the CUDA DLLs zip that matches this llama-server folder. Confirm CUDA 12 vs 13 still matches this GPU before extracting — hardware may have changed. Extract beside the new llama-server folder, not over the working install." />
                                        </ToolTip.Tip>
                                    </Button>
                                    <Button Content="Open matching llama.cpp release"
                                            Margin="0,0,8,6"
                                            Command="{Binding OpenLlamaReleasePageCommand}"
                                            IsVisible="{Binding LlamaReleasePageAvailable}">
                                        <ToolTip.Tip>
                                            <TextBlock TextWrapping="Wrap" MaxWidth="420"
                                                       Text="Opens the llama.cpp nightly that matches this install's family. Confirm the zip you pick is still the right one for this PC — hardware may have changed. Do not use a CPU or Vulkan zip if this folder is CUDA." />
                                        </ToolTip.Tip>
                                        </Button>
                                    </WrapPanel>
                                <TextBlock FontWeight="SemiBold" Text="DeepSeek Harness" />
                                <TextBlock TextWrapping="Wrap" Opacity="0.88" Text="{Binding HarnessUpdateStatusText}" />
                                <Button HorizontalAlignment="Left"
                                        Content="Open Harness releases"
                                        Command="{Binding OpenHarnessReleasesCommand}">
                                    <ToolTip.Tip>
                                        <TextBlock TextWrapping="Wrap" MaxWidth="420"
                                                   Text="Opens GitHub releases for DeepSeek Harness. AI-FluxMux does not install or upgrade dsh. Back up %USERPROFILE%\.dsh first if you update; preview builds can change on-disk settings." />
                                    </ToolTip.Tip>
                                </Button>
                            </StackPanel>
                        </GroupBox>

                        <Border Background="{DynamicResource FluxTintBlueBackground}" BorderBrush="{DynamicResource FluxTintBlueBorder}" BorderThickness="1" Padding="10">
                            <TextBlock TextWrapping="Wrap" Text="{Binding DependencySummary}" />
                        </Border>

                        <Border Background="{DynamicResource FluxMutedBackground}" BorderBrush="{DynamicResource FluxMutedBorder}" BorderThickness="1" Padding="10">
                            <TextBlock TextWrapping="Wrap" Text="{Binding DependencyScopeHelpText}" />
                        </Border>

                        <Border Background="{DynamicResource FluxTintAmberBackground}" BorderBrush="{DynamicResource FluxTintAmberBorder}" BorderThickness="1" Padding="10">
                            <StackPanel Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="Update guidance" />
                                <TextBlock TextWrapping="Wrap" Text="{Binding DependencyPinPolicyText}" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource FluxMutedBackground}" BorderBrush="{DynamicResource FluxMutedBorder}" BorderThickness="1" Padding="10">
                            <StackPanel Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="Known-good environment comparison (optional)" />
                                <TextBlock TextWrapping="Wrap" Text="{Binding DependencyDriftSummaryText}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" Text="Reference links:" />
                            <Button Content="llama.cpp"
                                Command="{Binding OpenExternalLinkCommand}"
                                CommandParameter="https://github.com/ggml-org/llama.cpp/releases"
                                ToolTip.Tip="Opens the official llama.cpp download page in your browser." />
                        </StackPanel>

                        <GroupBox Header="Local runtime" ToolTip.Tip="The program that runs local models.">
                            <StackPanel Margin="8" Spacing="4">
                                <Grid ColumnDefinitions="2.6*,1.1*,2.2*,2.1*" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0" FontWeight="Bold" Text="Component" />
                                    <TextBlock Grid.Column="1" FontWeight="Bold" Text="Minimum" />
                                    <TextBlock Grid.Column="2" FontWeight="Bold" Text="Installed" />
                                    <TextBlock Grid.Column="3" FontWeight="Bold" Text="Status" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding CoreDependencyRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding RowBackground}" ToolTip.Tip="{Binding Guidance}">
                                                <Grid ColumnDefinitions="2.6*,1.1*,2.2*,2.1*" ColumnSpacing="6" Margin="0,2,0,2">
                                                    <TextBlock Grid.Column="0" TextWrapping="Wrap" Text="{Binding Dependency}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Minimum}" />
                                                    <TextBlock Grid.Column="2" TextWrapping="Wrap" Text="{Binding Installed}" />
                                                    <TextBlock Grid.Column="3" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Status}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Active route requirements" ToolTip.Tip="Keys and files needed for the cloud company and local model you are using.">
                            <StackPanel Margin="8" Spacing="4">
                                <Grid ColumnDefinitions="1.8*,1.8*,2.5*,2.9*" ColumnSpacing="4">
                                    <TextBlock Grid.Column="0" FontWeight="Bold" Text="Provider connection" />
                                    <TextBlock Grid.Column="1" FontWeight="Bold" Text="Connection" />
                                    <TextBlock Grid.Column="2" FontWeight="Bold" Text="Required file(s)" />
                                    <TextBlock Grid.Column="3" FontWeight="Bold" Text="Required field(s)" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding ProviderRequirementRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding RowBackground}" ToolTip.Tip="{Binding Guidance}">
                                                <Grid ColumnDefinitions="1.8*,1.8*,2.5*,2.9*" ColumnSpacing="4" Margin="0,2,0,2">
                                                    <TextBlock Grid.Column="0" TextWrapping="Wrap" Text="{Binding Provider}" />
                                                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{Binding Sdk}" />
                                                    <TextBlock Grid.Column="2" TextWrapping="Wrap" Text="{Binding RequiredFiles}" />
                                                    <TextBlock Grid.Column="3" TextWrapping="Wrap" Text="{Binding RequiredFields}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Configured paths" ToolTip.Tip="Folders and files AI-FluxMux is set to use. A missing path only matters for the kind of model you are starting.">
                            <StackPanel Margin="8" Spacing="4">
                                <Grid ColumnDefinitions="2.2*,1.1*,3.7*,1.2*" ColumnSpacing="4">
                                    <TextBlock Grid.Column="0" FontWeight="Bold" Text="Component" />
                                    <TextBlock Grid.Column="1" FontWeight="Bold" Text="Type" />
                                    <TextBlock Grid.Column="2" FontWeight="Bold" Text="Resolved path" />
                                    <TextBlock Grid.Column="3" FontWeight="Bold" Text="Status" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding HardRequiredPathRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding RowBackground}" ToolTip.Tip="{Binding Guidance}">
                                                <Grid ColumnDefinitions="2.2*,1.1*,3.7*,1.2*" ColumnSpacing="4" Margin="0,2,0,2">
                                                    <TextBlock Grid.Column="0" Text="{Binding Component}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Kind}" />
                                                    <TextBlock Grid.Column="2" TextWrapping="Wrap" Text="{Binding ResolvedPath}" />
                                                    <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="{Binding Status}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Runtime diagnostics files" ToolTip.Tip="Log files created after you run related tests. 'Not yet generated' is normal until that test has run.">
                            <StackPanel Margin="8" Spacing="4">
                                <Grid ColumnDefinitions="2.2*,1.1*,3.7*,1.2*" ColumnSpacing="4">
                                    <TextBlock Grid.Column="0" FontWeight="Bold" Text="Component" />
                                    <TextBlock Grid.Column="1" FontWeight="Bold" Text="Type" />
                                    <TextBlock Grid.Column="2" FontWeight="Bold" Text="Resolved path" />
                                    <TextBlock Grid.Column="3" FontWeight="Bold" Text="Status" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding RuntimePathRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding RowBackground}" ToolTip.Tip="{Binding Guidance}">
                                                <Grid ColumnDefinitions="2.2*,1.1*,3.7*,1.2*" ColumnSpacing="4" Margin="0,2,0,2">
                                                    <TextBlock Grid.Column="0" Text="{Binding Component}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Kind}" />
                                                    <TextBlock Grid.Column="2" TextWrapping="Wrap" Text="{Binding ResolvedPath}" />
                                                    <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="{Binding Status}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Local model capability estimate" ToolTip.Tip="Guesses from filenames whether a model can see pictures. Not proven until you Launch.">
                            <StackPanel Margin="8" Spacing="4">
                                <Grid ColumnDefinitions="2.8*,1.0*,1.8*,3.4*" ColumnSpacing="4">
                                    <TextBlock Grid.Column="0" FontWeight="Bold" Text="Model" />
                                    <TextBlock Grid.Column="1" FontWeight="Bold" Text="Format" />
                                    <TextBlock Grid.Column="2" FontWeight="Bold" Text="Vision support" />
                                    <TextBlock Grid.Column="3" FontWeight="Bold" Text="Notes" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding LocalModelCapabilityRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding RowBackground}" ToolTip.Tip="{Binding Guidance}">
                                                <Grid ColumnDefinitions="2.8*,1.0*,1.8*,3.4*" ColumnSpacing="4" Margin="0,2,0,2">
                                                    <TextBlock Grid.Column="0" TextWrapping="Wrap" Text="{Binding Model}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Format}" />
                                                    <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="{Binding VisionSupport}" />
                                                    <TextBlock Grid.Column="3" TextWrapping="Wrap" Text="{Binding Notes}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Install guides" ToolTip.Tip="Official download pages.">
                            <StackPanel Margin="8" Spacing="4">
                                <ItemsControl ItemsSource="{Binding CoreInstallGuideRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource FluxMutedBorder}" Padding="0,4" Background="{Binding RowBackground}" ToolTip.Tip="{Binding Guidance}">
                                                <StackPanel Spacing="2">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Dependency}" />
                                                    <TextBlock TextWrapping="Wrap" Text="{Binding InstallOrUpdate}" />
                                                    <Button HorizontalAlignment="Left"
                                                            Command="{Binding ElementName=RootWindow, Path=DataContext.OpenExternalLinkCommand}"
                                                            CommandParameter="{Binding Source}"
                                                            ToolTip.Tip="Open this official page in your browser.">
                                                        <TextBlock TextWrapping="Wrap" Text="{Binding Source}" />
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Help">
                <Grid ColumnDefinitions="260,10,*" Margin="0,8,0,8" Loaded="OnHelpChromeLoaded">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                        <TextBox x:Name="HelpSearchBox"
                                 PlaceholderText="Search Help"
                                 ToolTip.Tip="Type to filter the index. Matching topics stay in the list; click one to jump. Press Enter to jump to the first match."
                                 TextChanged="OnHelpSearchTextChanged"
                                 KeyDown="OnHelpSearchKeyDown" />
                        <TextBlock x:Name="HelpSearchStatus"
                                   Grid.Row="1"
                                   FontSize="11"
                                   Opacity="0.72"
                                   TextWrapping="Wrap"
                                   Text="Pick a topic, or search." />
                        <ListBox x:Name="HelpIndexList"
                                 Grid.Row="2"
                                 SelectionChanged="OnHelpIndexSelectionChanged">
                            <ListBox.Styles>
                                <!-- Section banners label the topics under them; they are not destinations. -->
                                <Style Selector="ListBoxItem" x:DataType="views:HelpTopicEntry">
                                    <Setter Property="IsHitTestVisible" Value="{Binding IsTopic}" />
                                    <Setter Property="Focusable" Value="{Binding IsTopic}" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="views:HelpTopicEntry">
                                    <Panel>
                                        <TextBlock Text="{Binding Title}"
                                                   IsVisible="{Binding IsSection}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource FluxSecondaryForeground}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Title}"
                                                   IsVisible="{Binding IsTopic}"
                                                   TextWrapping="Wrap" />
                                    </Panel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <ScrollViewer x:Name="HelpBodyScroll"
                                  Grid.Column="2"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="HelpBodyPanel" Margin="14,0,8,24">
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <GridSplitter Grid.Row="2"
                      Theme="{StaticResource DiagnosticsSashTheme}"
                      ResizeDirection="Rows"
                      HorizontalAlignment="Stretch"
                      ToolTip.Tip="Drag to make the log area taller or shorter." />

        <Border Grid.Row="3"
                Padding="14,6,14,14"
                ClipToBounds="True"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource FluxChromeBackground}"
                BorderBrush="{DynamicResource FluxChromeEdge}"
                BorderThickness="0,1,0,0">
            <Grid RowDefinitions="Auto,*" RowSpacing="3">
                <StackPanel Grid.Row="0" Spacing="4">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,*" ColumnSpacing="6" ClipToBounds="True">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Diagnostics" />
                        <shapes:Ellipse Grid.Column="1"
                                        Width="14"
                                        Height="14"
                                        VerticalAlignment="Center"
                                        Margin="4,0,8,0"
                                        Fill="{Binding ActiveRouteStatusBrush}"
                                        Opacity="{Binding ActiveRouteStatusOpacity}"
                                        Stroke="#344054"
                                        StrokeThickness="1"
                                        ToolTip.Tip="{Binding ActiveRouteStatusTooltip}" />
                        <TextBlock Grid.Column="2"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   ClipToBounds="True"
                                   Text="{Binding ActiveRouteStatusLabel}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding ActiveRouteStatusTooltip}" />
                        <CheckBox Grid.Column="3"
                                  VerticalAlignment="Center"
                                  FontSize="11"
                                  IsChecked="{Binding GenerationSpeedTelemetryEnabled}"
                                  Content="Reply speed"
                                  ToolTip.Tip="Show tokens per second for Client-app replies passing through AI-FluxMux. Local models use llama-server timings when available; cloud uses stream estimates. Turn off to skip stream parsing and reduce overhead on long replies." />
                        <TextBlock Grid.Column="4"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Opacity="0.82"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding GenerationSpeedText}"
                                   IsVisible="{Binding ShowGenerationSpeedText}" />
                    </Grid>
                    <TextBlock FontSize="11"
                               Opacity="0.78"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding LastRouteExplanationText}"
                               IsVisible="{Binding ShowLastRouteExplanationText}"
                               ToolTip.Tip="Settings for the loaded model profile that the name row does not show: Images, Reasoning, Context, GPU, temperature, and max tokens. Compact is for the last Client-app turn on this model." />
                    <Border IsVisible="{Binding HealthReportVisible}"
                            Background="{DynamicResource FluxTintAmberBackground}"
                            BorderBrush="{DynamicResource FluxTintAmberBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,6">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Content="Dismiss"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding DismissHealthReportCommand}"
                                    views:MarkedText.Tip="Hide this health note. Click **Health** again if you want a fresh check." />
                            <TextBlock views:MarkedText.Source="{Binding HealthReportText}"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Border IsVisible="{Binding CloudRecommendVisible}"
                            Background="{DynamicResource FluxTintAmberBackground}"
                            BorderBrush="{DynamicResource FluxTintAmberBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,6">
                        <StackPanel Spacing="8">
                            <TextBlock views:MarkedText.Source="{Binding CloudRecommendText}"
                                       TextWrapping="Wrap"
                                       FontSize="12" />
                            <TextBlock Text="{Binding RecoveryHarnessRelaunchHint}"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Opacity="0.88"
                                       IsVisible="{Binding RecoveryHarnessRelaunchVisible}" />
                            <WrapPanel>
                                <Button Content="{Binding RecoveryWaitLongerLabel}"
                                        Margin="0,0,8,4"
                                        IsVisible="{Binding RecoveryWaitLongerVisible}"
                                        Command="{Binding ContinueWaitingRecoveryCommand}"
                                        views:MarkedText.Tip="{Binding RecoveryWaitLongerTooltip}" />
                                <Button Content="{Binding RecoveryResumeLabel}"
                                        Margin="0,0,8,4"
                                        Command="{Binding ResumeCurrentModelRecoveryCommand}"
                                        views:MarkedText.Tip="{Binding RecoveryResumeTooltip}" />
                                <Button Content="{Binding RecoverySteerLabel}"
                                        Margin="0,0,8,4"
                                        IsVisible="{Binding RecoverySteerVisible}"
                                        Command="{Binding SteerPortRuleRecoveryCommand}"
                                        views:MarkedText.Tip="{Binding RecoverySteerTooltip}" />
                                <Button Content="{Binding RecoverySwitchLocalLabel}"
                                        Margin="0,0,8,4"
                                        IsVisible="{Binding RecoverySwitchLocalVisible}"
                                        Command="{Binding SwitchRecoveryLocalCommand}"
                                        ToolTip.Tip="{Binding RecoverySwitchLocalTooltip}" />
                                <Button Content="{Binding RecoverySwitchCloudLabel}"
                                        Margin="0,0,8,4"
                                        IsVisible="{Binding RecoverySwitchCloudVisible}"
                                        Command="{Binding ApproveCloudRecommendCommand}"
                                        ToolTip.Tip="{Binding RecoverySwitchCloudTooltip}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border IsVisible="{Binding LocalReloadRecommendVisible}"
                            Background="{DynamicResource FluxTintBlueBackground}"
                            BorderBrush="{DynamicResource FluxTintBlueBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,6"
                            views:MarkedText.Tip="{Binding LocalReloadRecommendTooltip}">
                        <StackPanel Spacing="8">
                            <TextBlock views:MarkedText.Source="{Binding LocalReloadRecommendText}"
                                       TextWrapping="Wrap"
                                       FontSize="12" />
                            <WrapPanel>
                                <Button Content="Compact"
                                        Margin="0,0,8,4"
                                        IsVisible="{Binding LocalReloadCompactVisible}"
                                        Command="{Binding CompactLocalReloadRecommendCommand}"
                                        ToolTip.Tip="Shorten older turns that AI-FluxMux forwards to the local model, but only when this chat is actually filling the loaded Context. The Client app still has the full chat. If the suggested model profile's Context is too small for this chat, Compact also loads that model profile." />
                                <Button Content="Load suggested model profile"
                                        Margin="0,0,8,4"
                                        IsVisible="{Binding LocalReloadLoadVisible}"
                                        Command="{Binding ApproveLocalReloadRecommendCommand}"
                                        views:MarkedText.Tip="Unload the model profile that is running now and start the suggested model profile named in the blue note. The new local starts without the in-memory reading of this chat. If that model profile's Context is smaller than this chat, the next turn may still fail unless you **Compact** first." />
                                <Button Content="Keep current model profile"
                                        Margin="0,0,8,4"
                                        Command="{Binding DeclineLocalReloadRecommendCommand}"
                                        ToolTip.Tip="Keep the local model profile that is already loaded. Hide this suggestion for 15 minutes. Does not shorten what AI-FluxMux forwards." />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border IsVisible="{Binding RecoveryReplacementVisible}"
                            Background="{DynamicResource FluxMutedBackground}"
                            BorderBrush="{DynamicResource FluxMutedBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,6">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Text="Or choose a different model" />
                                <ComboBox x:Name="RecoveryReplacementChooser"
                                          Grid.Column="1"
                                          ItemsSource="{Binding RecoveryReplacementOptions}"
                                          SelectedItem="{Binding SelectedRecoveryReplacement}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="2"
                                        Content="Switch to selected"
                                        VerticalAlignment="Center"
                                        Command="{Binding ApplyRecoveryReplacementCommand}"
                                        ToolTip.Tip="Load or route to the model you picked. The note says whether this Client-app chat can continue." />
                            </Grid>
                            <TextBlock Text="{Binding RecoveryReplacementAdvice}"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Opacity="0.88" />
                        </StackPanel>
                    </Border>
                    <Border Background="#101828"
                            BorderBrush="#344054"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,6">
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                            <ContentControl Grid.Column="0"
                                            Content="{Binding GpuVramGauge}"
                                            ContentTemplate="{StaticResource LiveUtilizationGaugeTemplate}" />
                            <ContentControl Grid.Column="1"
                                            Content="{Binding GpuUtilGauge}"
                                            ContentTemplate="{StaticResource LiveUtilizationGaugeTemplate}" />
                            <ContentControl Grid.Column="2"
                                            Content="{Binding RamGauge}"
                                            ContentTemplate="{StaticResource LiveUtilizationGaugeTemplate}" />
                            <ContentControl Grid.Column="3"
                                            Content="{Binding CpuGauge}"
                                            ContentTemplate="{StaticResource LiveUtilizationGaugeTemplate}" />
                        </Grid>
                    </Border>
                    </StackPanel>
                    <Grid Grid.Row="1" RowDefinitions="*,Auto" RowSpacing="4" MinHeight="66">
                        <TextBox x:Name="DiagnosticTerminal"
                                 Classes="diagnosticTerminal"
                                 Grid.Row="0"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 Text="{Binding DiagnosticTerminalText}"
                                 TextWrapping="Wrap"
                                 FontFamily="Cascadia Mono,Consolas"
                                 FontSize="11"
                                 Foreground="#D1FADF"
                                 Background="#101828"
                                 BorderBrush="#344054"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackground">#101828</SolidColorBrush>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver">#101828</SolidColorBrush>
                                <SolidColorBrush x:Key="TextControlBackgroundFocused">#101828</SolidColorBrush>
                                <SolidColorBrush x:Key="TextControlBackgroundDisabled">#101828</SolidColorBrush>
                                <SolidColorBrush x:Key="TextControlForeground">#D1FADF</SolidColorBrush>
                                <SolidColorBrush x:Key="TextControlForegroundPointerOver">#D1FADF</SolidColorBrush>
                                <SolidColorBrush x:Key="TextControlForegroundFocused">#D1FADF</SolidColorBrush>
                                <SolidColorBrush x:Key="TextControlForegroundDisabled">#D1FADF</SolidColorBrush>
                            </TextBox.Resources>
                        </TextBox>
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                <Button x:Name="GpuVramButton"
                                        Content="GPU &amp; VRAM"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Click="GpuVramButton_Click"
                                        ToolTip.Tip="VRAM usage, display adapters, and tips for freeing graphics memory." />
                                <Popup x:Name="GpuVramPopup"
                                       DataContext="{Binding #RootWindow.DataContext}"
                                       PlacementTarget="{Binding #GpuVramButton}"
                                       Placement="Top"
                                       IsLightDismissEnabled="False"
                                       OverlayDismissEventPassThrough="True"
                                       Opened="GpuVramPopup_Opened">
                                    <ThemeVariantScope x:Name="GpuVramThemeScope">
                                    <Border Padding="10"
                                            CornerRadius="6"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource FluxMutedBorder}"
                                            Background="{DynamicResource FluxCardBackground}"
                                            BoxShadow="0 8 24 0 #40000000">
                                        <LayoutTransformControl>
                                            <LayoutTransformControl.LayoutTransform>
                                                <ScaleTransform ScaleX="{Binding UiScaleFactor}"
                                                                ScaleY="{Binding UiScaleFactor}" />
                                            </LayoutTransformControl.LayoutTransform>
                                            <ScrollViewer MaxWidth="520"
                                                          MaxHeight="420"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          VerticalScrollBarVisibility="Auto">
                                                <StackPanel Spacing="8" Margin="2">
                                                    <TextBlock Text="GPU &amp; VRAM"
                                                               FontSize="15"
                                                               FontWeight="SemiBold" />
                                                    <Border Height="1"
                                                            Margin="0,0,0,2"
                                                            Background="{DynamicResource FluxMutedBorder}" />
                                                    <TextBlock IsVisible="{Binding GpuVramScanning}"
                                                               Opacity="0.82"
                                                               Text="{x:Static vm:MainViewModel.GpuVramScanningText}" />
                                                    <views:OptionInfoNote IsVisible="{Binding ShowDesktopGpuPreference}"
                                                                          InfoId="gpuvram.desktop_gpu"
                                                                          StartDismissed="True"
                                                                          NoteText="Local AI models benefit from as much VRAM as possible.&#10;&#8226; To stop Windows allocating your main GPU card's VRAM to other apps and system processes, you can try the experimental tool below, to make them use your motherboard GPU &amp; shared ordinary system RAM instead, next time they are launched.&#10;&#8226; In the Windows GPU affinity setting below, select **Motherboard GPU**, click **Apply**, then restart Windows (for best results - you can instead just restart individual apps, but this is usually less thorough).&#10;&#8226; A BIOS setting change is usually required before the motherboard graphics chip can run alongside the main graphics card. Do this first.&#10;&#8226; Monitors should be plugged into the motherboard graphics ports, not the main GPU ports. Typically they can be left there even when you switch back – in normal **Discrete GPU** mode, Windows can still usually route everything to the main GPU card via those ports (with a very small performance hit).&#10;&#8226; If you can't or don't wish to use your on-board motherboard graphics, you can still try closing any unused browser windows and idle apps you started, then click **Refresh VRAM** below to see how much memory comes free. Only close web pages and apps you opened yourself. Ending Windows background processes could freeze or crash your PC.&#10;&#8226; Note that AI-FluxMux will show up as a VRAM using process (for obvious reasons) whichever GPU affinity mode is set. Don't close this!&#10;&#8226; Your motherboard graphics chip and its ports will likely not match the performance or features of your discrete graphics card for 3D speed, refresh rate, HDR, or how many displays you can connect. Apply **Discrete GPU** mode and restart again, when you need that extra functionality back." />
                                                    <StackPanel Spacing="8"
                                                                IsVisible="{Binding !ShowDesktopGpuPreference}">
                                                        <TextBlock TextWrapping="Wrap" Opacity="0.82"
                                                                   views:MarkedText.Source="If you can't or don't wish to use your on-board motherboard graphics, you can still try closing any unused browser windows and idle apps you started, then click **Refresh VRAM** below to see how much memory comes free. Only close web pages and apps you opened yourself. Ending Windows background processes could freeze or crash your PC." />
                                                        <TextBlock TextWrapping="Wrap" Opacity="0.82"
                                                                   views:MarkedText.Source="Note that AI-FluxMux will show up as a VRAM using process (for obvious reasons) whichever GPU affinity mode is set. Don't close this!" />
                                                    </StackPanel>
                                                    <StackPanel Spacing="4">
                                                        <TextBlock FontWeight="SemiBold" Text="Display adapters (currently detected)" />
                                                        <Border BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="8"
                                                                BorderBrush="{DynamicResource TextControlBorderBrush}">
                                                            <StackPanel Spacing="4">
                                                                <Grid ColumnSpacing="8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="1.6*" />
                                                                        <ColumnDefinition Width="{Binding ShowGpuAdapterStatusColumn, Converter={x:Static vm:BoolToCollapsedGridLengthConverter.Instance}}" />
                                                                        <ColumnDefinition Width="2.4*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock FontWeight="SemiBold" Text="Adapter" />
                                                                    <TextBlock Grid.Column="1"
                                                                               FontWeight="SemiBold"
                                                                               Text="Status"
                                                                               Margin="0,0,8,0"
                                                                               IsVisible="{Binding ShowGpuAdapterStatusColumn}" />
                                                                    <TextBlock Grid.Column="2"
                                                                               FontWeight="SemiBold"
                                                                               Text="Comments" />
                                                                </Grid>
                                                                <TextBlock IsVisible="{Binding GpuVramScanning}"
                                                                           Opacity="0.82"
                                                                           Text="{x:Static vm:MainViewModel.GpuVramScanningText}" />
                                                                <ItemsControl IsVisible="{Binding ShowGpuAdapterList}"
                                                                              ItemsSource="{Binding GpuAdapterRows}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="svc:DisplayAdapterListItem">
                                                                            <Grid ColumnSpacing="8" Margin="0,2">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="1.6*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                    <ColumnDefinition Width="2.4*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{Binding NameLabel}"
                                                                                           TextWrapping="Wrap" />
                                                                                <TextBlock Grid.Column="1"
                                                                                           Text="{Binding StatusLabel}"
                                                                                           Margin="0,0,8,0"
                                                                                           Opacity="0.85"
                                                                                           IsVisible="{Binding DataContext.ShowGpuAdapterStatusColumn, ElementName=RootWindow}" />
                                                                                <TextBlock Grid.Column="2"
                                                                                           Text="{Binding NotesLabel}"
                                                                                           TextWrapping="Wrap"
                                                                                           Opacity="0.85" />
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <TextBlock IsVisible="{Binding ShowGpuAdapterEmptyMessage}"
                                                                           Opacity="0.82"
                                                                           TextWrapping="Wrap"
                                                                           Text="No display adapters detected, or PowerShell query failed." />
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Spacing="4"
                                                                IsVisible="{Binding ShowDesktopGpuPreference}">
                                                        <TextBlock FontWeight="SemiBold"
                                                                   Text="{x:Static svc:WindowsGpuPreference.AffinityModeLabel}" />
                                                        <Grid ColumnDefinitions="*,Auto"
                                                              ColumnSpacing="8">
                                                            <ComboBox MinWidth="200"
                                                                      HorizontalAlignment="Left"
                                                                      VerticalAlignment="Center"
                                                                      ItemsSource="{Binding DesktopGpuChoices}"
                                                                      SelectedItem="{Binding SelectedDesktopGpu}"
                                                                      IsEnabled="{Binding !DesktopGpuBusy}"
                                                                      views:MarkedText.Tip="Select **Motherboard GPU** or **Discrete GPU**. Click **Apply**, then restart Windows. llama-server stays on **Discrete GPU** mode." />
                                                            <Button Grid.Column="1"
                                                                    Content="Apply"
                                                                    Command="{Binding ApplyDesktopGpuCommand}"
                                                                    views:MarkedText.Tip="Write **Windows GPU affinity**, then restart Windows so apps pick it up." />
                                                        </Grid>
                                                        <TextBlock views:MarkedText.Source="{Binding DesktopGpuStatusText}"
                                                                   TextWrapping="Wrap"
                                                                   Opacity="0.85"
                                                                   IsVisible="{Binding DesktopGpuStatusText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                                                    </StackPanel>
                                                    <StackPanel Spacing="4">
                                                        <TextBlock FontWeight="SemiBold" Text="VRAM usage" />
                                                        <Border BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="8"
                                                                MinHeight="120"
                                                                BorderBrush="{DynamicResource TextControlBorderBrush}">
                                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                                          HorizontalScrollBarVisibility="Disabled"
                                                                          views:MarkedText.Tip="How full each graphics card is, and which programs are using graphics memory. Close unused apps, then click **Refresh VRAM** to see the change.">
                                                                <StackPanel Grid.IsSharedSizeScope="True">
                                                                    <TextBlock IsVisible="{Binding GpuVramScanning}"
                                                                               Opacity="0.82"
                                                                               Text="{x:Static vm:MainViewModel.GpuVramScanningText}" />
                                                                    <TextBlock IsVisible="{Binding !GpuVramScanning}"
                                                                               Text="{Binding VramStatusText}"
                                                                               TextWrapping="Wrap" />
                                                                    <TextBlock Margin="0,16,0,4"
                                                                               IsVisible="{Binding GpuVramScanning}"
                                                                               Text="Programs using the main graphics card:"
                                                                               TextWrapping="Wrap" />
                                                                    <TextBlock Margin="0,0,0,10"
                                                                               IsVisible="{Binding GpuVramScanning}"
                                                                               Opacity="0.82"
                                                                               Text="{x:Static vm:MainViewModel.GpuVramScanningText}" />
                                                                    <TextBlock Margin="0,16,0,10"
                                                                               IsVisible="{Binding HasVramProcessList}"
                                                                               Text="{Binding VramProcessListHeaderText}"
                                                                               TextWrapping="Wrap" />
                                                                    <ItemsControl IsVisible="{Binding !GpuVramScanning}"
                                                                                  ItemsSource="{Binding VramProcessRows}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="svc:VramProcessListItem">
                                                                                <Grid Margin="0,1"
                                                                                      Classes.vramCaution="{Binding IsCaution}">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="VramMb" />
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="VramCount" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock Grid.Column="0"
                                                                                               Text="{Binding MemoryLabel}"
                                                                                               HorizontalAlignment="Right"
                                                                                               Margin="0,0,12,0" />
                                                                                    <TextBlock Grid.Column="1"
                                                                                               Text="{Binding NameLabel}"
                                                                                               TextWrapping="Wrap"
                                                                                               TextTrimming="CharacterEllipsis" />
                                                                                    <TextBlock Grid.Column="2"
                                                                                               Text="{Binding CountLabel}"
                                                                                               Margin="12,0,0,0"
                                                                                               TextWrapping="Wrap" />
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </ScrollViewer>
                                                        </Border>
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                            <Button Grid.Column="0"
                                                                    HorizontalAlignment="Left"
                                                                    Content="Refresh VRAM"
                                                                    Command="{Binding RefreshVramStatusCommand}"
                                                                    IsEnabled="{Binding !GpuVramScanning}"
                                                                    views:MarkedText.Tip="Update graphics-memory numbers after you close apps or move the display." />
                                                            <Button Grid.Column="1"
                                                                    HorizontalAlignment="Right"
                                                                    Content="Close"
                                                                    Click="GpuVramPopupClose_Click"
                                                                    ToolTip.Tip="Close this panel. It stays open while you close apps and refresh VRAM." />
                                                        </Grid>
                                                    </StackPanel>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </LayoutTransformControl>
                                    </Border>
                                    </ThemeVariantScope>
                                </Popup>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="{StaticResource IdleTimeoutTooltip}">
                                    <CheckBox VerticalAlignment="Center" Content="Idle timeout" IsChecked="{Binding IdleTimeoutEnabled}" ToolTip.Tip="{StaticResource IdleTimeoutTooltip}" />
                                    <NumericUpDown MinWidth="72"
                                                   Value="{Binding IdleTimeoutMinutes}"
                                                   Minimum="1"
                                                   Maximum="240"
                                                   IsEnabled="{Binding IdleTimeoutEnabled}"
                                                   ToolTip.Tip="{StaticResource IdleTimeoutTooltip}" />
                                    <TextBlock VerticalAlignment="Center" Text="min" />
                                </StackPanel>
                                <Button Content="Health"
                                        Margin="0,0,6,0"
                                        Command="{Binding CheckConnectionHealthCommand}"
                                        ToolTip.Tip="Pings the model that is actually running and writes what is wrong (and how to fix it) in the log above. If Route requests is on, checks both the loaded local and the ready cloud." />
                                <Button Content="Copy log"
                                        Margin="0,0,6,0"
                                        Command="{Binding CopyDiagnosticTerminalCommand}"
                                        ToolTip.Tip="Copy the Diagnostics log so you can paste it elsewhere. Lines name llama-server, AI-FluxMux, AutoTune, or the cloud model when that is what wrote them." />
                                <Button Content="Clear"
                                        Command="{Binding ClearDiagnosticTerminalCommand}"
                                        ToolTip.Tip="Erase the log on this screen." />
                            </WrapPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                <TextBlock VerticalAlignment="Center" Opacity="0.6" Text="UI scale" />
                                <ComboBox VerticalAlignment="Center"
                                          ItemsSource="{Binding UiScaleOptions}"
                                          SelectedItem="{Binding SelectedUiScale}"
                                          ToolTip.Tip="Make the whole window smaller so more fits on screen. Nothing is hidden." />
                                <TextBlock VerticalAlignment="Center" Opacity="0.6" Text="UI theme" />
                                <ComboBox VerticalAlignment="Center"
                                          ItemsSource="{Binding UiThemeOptions}"
                                          SelectedItem="{Binding SelectedUiTheme}"
                                          ToolTip.Tip="Light or dark window chrome. Diagnostics log stays dark either way." />
                            </StackPanel>
                        </Grid>
                    </Grid>
            </Grid>
        </Border>
    </Grid>
    </LayoutTransformControl>
    <Canvas x:Name="DragGhostLayer"
            IsHitTestVisible="False" />
    </Panel>

</Window>



