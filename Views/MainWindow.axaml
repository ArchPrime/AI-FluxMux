<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FluxMux.Avalonia.ViewModels"
        xmlns:views="using:FluxMux.Avalonia.Views"
        xmlns:svc="using:FluxMux.Avalonia.Services"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:ctrl="using:FluxMux.Avalonia.Controls"
    xmlns:shapes="using:Avalonia.Controls.Shapes"
    xmlns:upc="using:FluxMux.Updates.Core"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
        x:Class="FluxMux.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:Name="RootWindow"
        Icon="/Assets/Logos/AI-FluxMux.ico"
    Title="{x:Static upc:FluxMuxAppInfo.ProductTitle}"
    MinWidth="640"
    MinHeight="600"
        WindowStartupLocation="Manual"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="Full"
        Background="{DynamicResource FluxPaneBackground}">

    <Window.Resources>
        <vm:StringToVisibilityConverter x:Key="StringToVisibility" />
        <x:String x:Key="IdleTimeoutTooltip">Set how many idle minutes before AI-FluxMux stops the local model. This saves power, and frees VRAM for other apps. A reply that is still being prepared does not count as idle, even if that turn takes a long time. While a reply is being worked on, AI-FluxMux asks Windows to stay awake so the turn can finish. Note however that if using a laptop, closing the lid can still trigger sleep. Windows can also sleep when no reply is in progress. After the PC wakes, idle time includes the time spent asleep. After an idle timeout, when you send the next chat, the local model must reload and rebuild the context from the chat history, which is slower and risks reduced model understanding of what was most pertinent. Leave the idle timeout setting off to keep the local model loaded and ready in memory.</x:String>
        <DataTemplate x:Key="CloudProviderOptionTemplate" x:DataType="x:String">
            <TextBlock Text="{Binding Converter={x:Static vm:CloudProviderDisplayConverter.Instance}}" />
        </DataTemplate>
        <DataTemplate x:Key="LiveUtilizationGaugeTemplate" x:DataType="vm:LiveUtilizationGaugeViewModel">
            <Border Background="Transparent" ToolTip.Tip="{Binding Tooltip}">
                <StackPanel Spacing="2">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="{DynamicResource FluxFontSizeCaption}"
                                   FontWeight="SemiBold"
                                   Foreground="#E4E7EC"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Badge}"
                                   FontSize="{DynamicResource FluxFontSizeSmall}"
                                   Opacity="0.72"
                                   Foreground="#D0D5DD"
                                   TextWrapping="NoWrap" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <ctrl:SegmentedUtilizationGauge Percent="{Binding Percent}"
                                                        VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding PercentText}"
                                   FontSize="{DynamicResource FluxFontSizeBody}"
                                   FontWeight="SemiBold"
                                   Foreground="#F9FAFB"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding DetailText}"
                               FontSize="{DynamicResource FluxFontSizeSmall}"
                               Opacity="0.78"
                               Foreground="#D0D5DD"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ValidatedProfileOptionTemplate" x:DataType="vm:ValidatedQuickSelectProfileOption">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="profileStatusIcon"
                           Text="⚠"
                           Foreground="#DC2626"
                           IsVisible="{Binding ShowMissingFileWarning, FallbackValue=False, TargetNullValue=False}"
                           ToolTip.Tip="{Binding MissingFileWarningTooltip}" />
                <Border Classes="corporateLogoBadge comboLogoChip"
                        IsVisible="{Binding HasLogo, FallbackValue=False}"
                        ToolTip.Tip="{Binding LogoCompanyName}">
                    <Image Classes="corporateLogo"
                           Source="{Binding LogoAssetKey, Converter={x:Static vm:CorporateLogoImageConverter.Instance}}" />
                </Border>
                <TextBlock Text="{Binding DisplayName}"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="SwitchBenchmarkProfileOptionTemplate" x:DataType="vm:SwitchBenchmarkProfileOption">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="profileStatusIcon"
                           Text="⚠"
                           Foreground="#DC2626"
                           IsVisible="{Binding ShowMissingFileWarning, FallbackValue=False, TargetNullValue=False}"
                           ToolTip.Tip="{Binding MissingFileWarningTooltip}" />
                <Border Classes="corporateLogoBadge comboLogoChip"
                        IsVisible="{Binding HasLogo, FallbackValue=False}"
                        ToolTip.Tip="{Binding LogoCompanyName}">
                    <Image Classes="corporateLogo"
                           Source="{Binding LogoAssetKey, Converter={x:Static vm:CorporateLogoImageConverter.Instance}}" />
                </Border>
                <TextBlock Text="{Binding DisplayName}"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="CloudProfileEditorTemplate" x:DataType="vm:MainViewModel">
<Border HorizontalAlignment="Stretch" Margin="0,4,0,0" Padding="8,6" CornerRadius="6" BorderBrush="{DynamicResource FluxCardBorder}" BorderThickness="1" Background="{DynamicResource FluxCardBackground}">
                                                        <StackPanel Spacing="10" HorizontalAlignment="Stretch">
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" HorizontalAlignment="Stretch">
                                                                <StackPanel Grid.Column="0" Width="{DynamicResource FluxProfileWizardWidth}" Spacing="8" IsEnabled="{Binding IsCloudVariantEditable}">
                                                                    <StackPanel Spacing="2">
                                                                        <TextBlock FontSize="{DynamicResource FluxFontSizeHeading}" FontWeight="SemiBold" Text="User priorities wizard" />
                                                                        <TextBlock FontSize="{DynamicResource FluxFontSizeCaption}" FontWeight="Normal" Opacity="0.75" Text="(use this if in doubt)" />
                                                                    </StackPanel>
                                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                                    <ListBox Grid.Column="0"
                                                                             x:Name="CloudPriorityListBox"
                                                                             ItemsSource="{Binding CloudPriorityOrder}"
                                                                             SelectedItem="{Binding SelectedCloudPriority}"
                                                                             MinHeight="175"
                                                                             SelectionMode="Single"
                                                                             views:ReorderMoveAnimation.Enable="True"
                                                                             PointerPressed="PriorityListBox_PointerPressed"
                                                                             PointerMoved="PriorityListBox_PointerMoved"
                                                                             PointerReleased="PriorityListBox_PointerReleased"
                                                                             PointerCaptureLost="PriorityListBox_PointerCaptureLost">
                                                                        <ListBox.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <StackPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ListBox.ItemsPanel>
                                                                        <ListBox.Styles>
                                                                            <Style Selector="ListBoxItem">
                                                                                <Setter Property="Margin" Value="0,0,0,5" />
                                                                                <Setter Property="Padding" Value="7,5" />
                                                                                <Setter Property="CornerRadius" Value="5" />
                                                                                <Setter Property="Background" Value="{DynamicResource FluxListItemBackground}" />
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource FluxListItemBorder}" />
                                                                                <Setter Property="BorderThickness" Value="1" />
                                                                            </Style>
                                                                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                                                                <Setter Property="Background" Value="{DynamicResource FluxListItemHoverBackground}" />
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource FluxListItemHoverBorder}" />
                                                                            </Style>
                                                                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                                                                <Setter Property="Background" Value="{DynamicResource FluxListItemSelectedBackground}" />
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource FluxListItemSelectedBorder}" />
                                                                                <Setter Property="BorderThickness" Value="2" />
                                                                            </Style>
                                                                        </ListBox.Styles>
                                                                        <ListBox.ItemTemplate>
                                                                            <DataTemplate x:DataType="x:String">
                                                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="2,3">
                                                                                    <TextBlock Classes="reorderGrip"
                                                                                               Grid.Column="0"
                                                                                               Text="⋮⋮"
                                                                                               ToolTip.Tip="Drag to change how important this goal is. The up and down buttons do the same."
                                                                                               PointerPressed="PriorityListBox_PointerPressed"
                                                                                               PointerMoved="PriorityListBox_PointerMoved"
                                                                                               PointerReleased="PriorityListBox_PointerReleased"
                                                                                               PointerCaptureLost="PriorityListBox_PointerCaptureLost" />
                                                                                    <TextBlock Grid.Column="1" FontSize="{DynamicResource FluxFontSizeCaption}" VerticalAlignment="Center" Text="{Binding}" ToolTip.Tip="{Binding Converter={x:Static vm:PriorityTooltipConverter.Instance}, ConverterParameter=cloud}" />
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ListBox.ItemTemplate>
                                                                    </ListBox>
                                                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                                                        <Button Content="↑" Command="{Binding MoveCloudPriorityUpCommand}" ToolTip.Tip="Makes this goal more important and updates the settings below." />
                                                                        <Button Content="↓" Command="{Binding MoveCloudPriorityDownCommand}" ToolTip.Tip="Makes this goal less important and updates the settings below." />
                                                                    </StackPanel>
                                                                    </Grid>
                                                                    <StackPanel Spacing="4">
                                                                        <Button HorizontalAlignment="Left"
                                                                                Content="AutoTune"
                                                                                ToolTip.Tip="Sets this cloud profile's options to match your priority list above. **Save profile** keeps the result; **Revert changes** discards it."
                                                                                Command="{Binding ApplyCloudIntentPresetCommand}" />
                                                                        <TextBlock FontSize="{DynamicResource FluxFontSizeCaption}" TextWrapping="Wrap" views:MarkedText.Source="{Binding CloudIntentPresetInfoText}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Spacing="8" IsEnabled="{Binding IsCloudVariantEditable}">
                                                                    <TextBlock FontSize="{DynamicResource FluxFontSizeHeading}" FontWeight="SemiBold" Text="Detailed settings" />
                                                                    <!-- Label and value pairs that wrap: each takes the widest label and value in this group (shared sizes), so columns line up and a narrow pane gives fewer per row instead of cutting values off (27 Nov). -->
                                                                    <WrapPanel Orientation="Horizontal" Grid.IsSharedSizeScope="True">
                                                                        <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Provider" />
                                                                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding CloudProviders}" SelectedItem="{Binding CloudFamilyProviderDraft}" ToolTip.Tip="Which cloud company this profile uses. Saved with the rest of the profile." />
                                                                        </Grid>
                                                                        <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Model id" />
                                                                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding CloudFamilyModelIdChoices}" SelectedItem="{Binding CloudFamilyModelIdDraft}" ToolTip.Tip="The model id this profile talks to. Saved with the rest of the profile." />
                                                                        </Grid>
                                                                        <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Paste" />
                                                                            <TextBox Grid.Column="1" HorizontalAlignment="Stretch" PlaceholderText="gpt-4.1" Text="{Binding CloudFamilyModelIdPaste}" views:MarkedText.Tip="Optional model id if it is not in the list. Click **Save profile** to apply." />
                                                                        </Grid>
                                                                        <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Context" />
                                                                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding CloudContextWindowChoices}" SelectedItem="{Binding CloudVariantContextWindow}" ToolTip.Tip="How much of the chat the cloud model can keep in mind. Shorter means it forgets earlier details sooner." />
                                                                        </Grid>
                                                                        <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Max tokens" />
                                                                            <NumericUpDown Grid.Column="1" HorizontalAlignment="Stretch" Minimum="128" Maximum="65536" Increment="128" Value="{Binding CloudVariantMaxTokens}" ToolTip.Tip="How long one answer can be. Shorter answers may stop in the middle of a reply." />
                                                                        </Grid>
                                                                        <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Temp" />
                                                                            <NumericUpDown Grid.Column="1" HorizontalAlignment="Stretch" Minimum="0" Maximum="2" Increment="0.05" Value="{Binding CloudVariantTemperature}" ToolTip.Tip="How mixed the wording is. Lower is more repeatable. Higher is more varied. Does not make answers faster." />
                                                                        </Grid>
                                                                        <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Reasoning" />
                                                                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding CloudReasoningModeOptions}" SelectedItem="{Binding CloudVariantReasoningMode}" ToolTip.Tip="Quick answers versus slower, more careful thinking when the company supports it." />
                                                                        </Grid>
                                                                        <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Response" />
                                                                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding CloudResponseFormatOptions}" SelectedItem="{Binding CloudVariantResponseFormat}" ToolTip.Tip="Ordinary text, or a structured layout if this model supports it." />
                                                                        </Grid>
                                                                        <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Effort" />
                                                                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding CloudReasoningEffortChoices}" SelectedItem="{Binding CloudVariantOpenAiReasoningEffort}" ToolTip.Tip="How hard the cloud model tries on tough questions. Higher can be better, slower, and cost more." />
                                                                        </Grid>
                                                                    </WrapPanel>
                                                                </StackPanel>
                                                            </Grid>
                                                            <TextBlock FontSize="{DynamicResource FluxFontSizeSmall}" Opacity="0.75" TextWrapping="Wrap" Text="{Binding CloudVariantFootprintText}" />
                                                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="6">
                                                                <Button Grid.Column="0" Content="Revert changes" VerticalAlignment="Center" Command="{Binding RevertCloudVariantCommand}" ToolTip.Tip="Throw away unsaved edits and put back the last saved settings." />
                                                                <Button Grid.Column="1" Content="Use model defaults" VerticalAlignment="Center" Command="{Binding UseCloudModelDefaultsCommand}" views:MarkedText.Tip="Load this model's starting settings as unsaved edits. Click **Save profile** to keep them." />
                                                                <Button Grid.Column="2"
                                                                        VerticalAlignment="Center"
                                                                        IsEnabled="{Binding CanValidateActiveCloudProfile}"
                                                                        Command="{Binding ValidateCloudProfileToEndpointCommand}"
                                                                        CommandParameter="{Binding SelectedCloudVariantItem}"
                                                                        ToolTip.Tip="Tests the saved profile on the Provider and Model id you saved. Save profile first if you changed those fields.">
                                                                    <TextBlock Text="Validate to endpoint" TextWrapping="NoWrap" />
                                                                </Button>
                                                                <Button Grid.Column="3"
                                                                        VerticalAlignment="Center"
                                                                        IsEnabled="{Binding IsCloudVariantEditable}"
                                                                        Command="{Binding SaveCloudVariantCommand}">
                                                                    <TextBlock Text="Save profile" TextWrapping="NoWrap" />
                                                                </Button>
                                                                <TextBox Grid.Column="4"
                                                                         Classes="profileName"
                                                                         IsEnabled="{Binding IsCloudVariantEditable}"
                                                                         Text="{Binding CloudVariantDraftName}"
                                                                         PlaceholderText="New profile name"
                                                                         ToolTip.Tip="Type a new name, then click Rename." />
                                                                <Button Grid.Column="5"
                                                                        Content="Rename"
                                                                        VerticalAlignment="Center"
                                                                        IsEnabled="{Binding IsCloudVariantEditable}"
                                                                        Command="{Binding RenameCloudVariantCommand}" />
                                                                <Button Grid.Column="6"
                                                                        Content="Delete"
                                                                        VerticalAlignment="Center"
                                                                        IsEnabled="{Binding CanDeleteActiveCloudProfile}"
                                                                        Command="{Binding DeleteCloudVariantCommand}"
                                                                        CommandParameter="{Binding SelectedCloudVariantItem}"
                                                                        ToolTip.Tip="Deletes this copy from AI-FluxMux. If this is the default, the whole cloud model and its copies are removed from AI-FluxMux. A profile that lost its model id can be deleted without unlocking. Nothing is deleted at the cloud company." />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" HorizontalAlignment="Stretch">
                                                                <Button Grid.Column="0" Content="Make New Variant" Command="{Binding AddGuidedProfileVariantCommand}" CommandParameter="Cloud" views:MarkedText.Tip="Creates a new model profile variant that starts with a copy of this profile's settings. Type a name in the box first. Change at least one setting, then **Save profile** — AI-FluxMux will not keep two variants with the same settings package." />
                                                                <TextBox Grid.Column="1" Classes="profileName" Text="{Binding NewProfileVariantName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding CloudNewVariantPlaceholder}" ToolTip.Tip="Type a name here, then click Make New Variant. AI-FluxMux will tell you if this box is empty." />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" HorizontalAlignment="Stretch">
                                                                <Panel Grid.Column="0" VerticalAlignment="Center">
                                                                    <TextBlock Classes="profileStatusIcon"
                                                                               Text="⚠"
                                                                               Foreground="#DC2626"
                                                                               IsVisible="{Binding SelectedCloudVariantItem.ShowMissingFileWarning, FallbackValue=False, TargetNullValue=False}" />
                                                                    <TextBlock Classes="profileStatusIcon"
                                                                               Text="✓"
                                                                               Foreground="#16A34A"
                                                                               IsVisible="{Binding SelectedCloudVariantItem.ShowValidatedCheck, FallbackValue=False, TargetNullValue=False}" />
                                                                </Panel>
                                                                <TextBlock Grid.Column="1"
                                                                           FontSize="{DynamicResource FluxFontSizeCaption}"
                                                                           TextWrapping="Wrap"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxLines="2"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{Binding SelectedCloudVariantItem.EndpointStatusForeground}"
                                                                           Text="{Binding SelectedCloudVariantItem.EndpointStatusText}" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
        </DataTemplate>
        <DataTemplate x:Key="LocalProfileEditorTemplate" x:DataType="vm:MainViewModel">
<Border HorizontalAlignment="Stretch" Margin="0,4,0,0" Padding="8,6" CornerRadius="6" BorderBrush="#A7F3D0" BorderThickness="1" Background="{DynamicResource FluxCardBackground}">
                                                        <StackPanel Spacing="10" HorizontalAlignment="Stretch">
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" HorizontalAlignment="Stretch">
                                                                <StackPanel Grid.Column="0" Width="{DynamicResource FluxProfileWizardWidth}" Spacing="8" IsEnabled="{Binding IsLocalVariantEditable}">
                                                                    <StackPanel Spacing="2">
                                                                        <TextBlock FontSize="{DynamicResource FluxFontSizeHeading}" FontWeight="SemiBold" Text="User priorities wizard" />
                                                                        <TextBlock FontSize="{DynamicResource FluxFontSizeCaption}" FontWeight="Normal" Opacity="0.75" Text="(use this if in doubt)" />
                                                                    </StackPanel>
                                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                                    <ListBox Grid.Column="0"
                                                                             x:Name="LocalPriorityListBox"
                                                                             ItemsSource="{Binding LocalPriorityOrder}"
                                                                             SelectedItem="{Binding SelectedLocalPriority}"
                                                                             MinHeight="175"
                                                                             SelectionMode="Single"
                                                                             views:ReorderMoveAnimation.Enable="True"
                                                                             PointerPressed="PriorityListBox_PointerPressed"
                                                                             PointerMoved="PriorityListBox_PointerMoved"
                                                                             PointerReleased="PriorityListBox_PointerReleased"
                                                                             PointerCaptureLost="PriorityListBox_PointerCaptureLost">
                                                                        <ListBox.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <StackPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ListBox.ItemsPanel>
                                                                        <ListBox.Styles>
                                                                            <Style Selector="ListBoxItem">
                                                                                <Setter Property="Margin" Value="0,0,0,5" />
                                                                                <Setter Property="Padding" Value="7,5" />
                                                                                <Setter Property="CornerRadius" Value="5" />
                                                                                <Setter Property="Background" Value="{DynamicResource FluxListItemBackground}" />
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource FluxListItemBorder}" />
                                                                                <Setter Property="BorderThickness" Value="1" />
                                                                            </Style>
                                                                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                                                                <Setter Property="Background" Value="{DynamicResource FluxListItemHoverBackground}" />
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource FluxListItemHoverBorder}" />
                                                                            </Style>
                                                                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                                                                <Setter Property="Background" Value="{DynamicResource FluxListItemSelectedBackground}" />
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource FluxListItemSelectedBorder}" />
                                                                                <Setter Property="BorderThickness" Value="2" />
                                                                            </Style>
                                                                        </ListBox.Styles>
                                                                        <ListBox.ItemTemplate>
                                                                            <DataTemplate x:DataType="x:String">
                                                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="2,3">
                                                                                    <TextBlock Classes="reorderGrip"
                                                                                               Grid.Column="0"
                                                                                               Text="⋮⋮"
                                                                                               ToolTip.Tip="Drag to change how important this goal is. The settings below follow the list, and changing a setting by hand moves the list too."
                                                                                               PointerPressed="PriorityListBox_PointerPressed"
                                                                                               PointerMoved="PriorityListBox_PointerMoved"
                                                                                               PointerReleased="PriorityListBox_PointerReleased"
                                                                                               PointerCaptureLost="PriorityListBox_PointerCaptureLost" />
                                                                                    <TextBlock Grid.Column="1" FontSize="{DynamicResource FluxFontSizeCaption}" VerticalAlignment="Center" Text="{Binding}" ToolTip.Tip="{Binding Converter={x:Static vm:PriorityTooltipConverter.Instance}, ConverterParameter=local}" />
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ListBox.ItemTemplate>
                                                                    </ListBox>
                                                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                                                        <Button Content="↑" Command="{Binding MoveLocalPriorityUpCommand}" ToolTip.Tip="Makes this goal more important and updates GPU, context, and related launch settings below. Leaves max tokens, temperature, reasoning, and chat format you already set." />
                                                                        <Button Content="↓" Command="{Binding MoveLocalPriorityDownCommand}" ToolTip.Tip="Makes this goal less important and updates GPU, context, and related launch settings below. Leaves max tokens, temperature, reasoning, and chat format you already set." />
                                                                    </StackPanel>
                                                                    </Grid>
                                                                    <StackPanel Spacing="4">
                                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                <CheckBox IsChecked="{Binding LocalVariantExtendContextIntoRam}"
                                                                                          VerticalAlignment="Center"
                                                                                          Content="Extend context into RAM (YaRN)"
                                                                                          ToolTip.Tip="Let the model keep more chat in mind than the graphics card can hold, by borrowing ordinary computer memory. The part that fits in graphics memory stays fast; the overflow is slower. AutoTune sizes the overflow from your free memory. Leave off for the fastest, shortest-context setup." />
                                                                            </StackPanel>
                                                                            <TextBlock FontSize="{DynamicResource FluxFontSizeCaption}" TextWrapping="Wrap" Foreground="{DynamicResource FluxHeadingForeground}" IsVisible="{Binding LocalYarnUntickedByWizardNote, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" Text="{Binding LocalYarnUntickedByWizardNote}" />
                                                                          <StackPanel Spacing="4" Margin="0,4,0,0">
                                                                              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding LocalVariantExtendContextIntoRam}">
                                                                                   <ComboBox ItemsSource="{Binding LocalYarnMaxContextWizardOptions}"
                                                                                              SelectedIndex="{Binding SelectedYarnContextWizardIndex}"
                                                                                              MinWidth="130"
                                                                                              MaxWidth="{DynamicResource FluxReadableTextMaxWidth}"
                                                                                              ToolTip.Tip="How far to stretch the context when Extend into RAM is on. Each option shows how much runs in fast graphics memory (VRAM) vs. slower ordinary memory (RAM). Auto picks the largest size your computer memory can hold. Orange means the overflow is large enough to run slowly; red means it may not fit.">
                                                                                     <ComboBox.ItemTemplate>
                                                                                         <DataTemplate>
                                                                                             <TextBlock Text="{Binding Display}"
                                                                                                        Foreground="{Binding RiskLevel, Converter={x:Static views:YarnContextRiskToBrushConverter.Instance}}" />
                                                                                         </DataTemplate>
                                                                                     </ComboBox.ItemTemplate>
                                                                                     <ComboBox.SelectionBoxItemTemplate>
                                                                                         <DataTemplate>
                                                                                             <TextBlock Text="{Binding Display}"
                                                                                                        Foreground="{Binding RiskLevel, Converter={x:Static views:YarnContextRiskToBrushConverter.Instance}}" />
                                                                                         </DataTemplate>
                                                                                     </ComboBox.SelectionBoxItemTemplate>
                                                                                 </ComboBox>
                                                                              </StackPanel>
                                                                               <TextBlock FontSize="{DynamicResource FluxFontSizeCaption}"
                                                                                          TextWrapping="Wrap"
                                                                                          Foreground="{DynamicResource FluxHeadingForeground}"
                                                                                          IsVisible="{Binding LocalYarnMaxContextAdvisoryText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                                                                          Text="{Binding LocalYarnMaxContextAdvisoryText}" />
                                                                              <StackPanel Spacing="4" IsVisible="{Binding ShowLocalKvCacheWizardChoice}">
                                                                                  <TextBlock FontSize="{DynamicResource FluxFontSizeCaption}" FontWeight="SemiBold" Text="KV cache for the extended context" />
                                                                                  <ComboBox ItemsSource="{Binding LocalKvCacheWizardOptions}"
                                                SelectedIndex="{Binding SelectedKvCacheWizardIndex}"
                                                MinWidth="130"
                                                MaxWidth="{DynamicResource FluxReadableTextMaxWidth}"
                                                ToolTip.Tip="Precision for the extra context that spills into ordinary memory. Auto picks the best type your hardware can keep fast (shown in the dropdown). Lower precision (q4/q5) fits more context but the model may lose track of details in very long chats." />
                                                                                  <TextBlock FontSize="{DynamicResource FluxFontSizeCaption}" TextWrapping="Wrap" Text="{Binding LocalKvCacheWizardInfoText}" />
                                                                              </StackPanel>
                                                                          </StackPanel>
                                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                                            <Button VerticalAlignment="Center"
                                                                                    Content="AutoTune"
                                                                                    views:MarkedText.Tip="Fills in the launch settings from your priority list and this PC's free memory. Images, max tokens, temperature, reasoning and chat format you set yourself are left alone. Tick the box beside it to also measure real speeds on this PC. **Save profile** keeps the result; **Revert changes** discards it."
                                                                                    Command="{Binding ApplyLocalPriorityWizardCommand}"
                                                                                    CommandParameter="{Binding SelectedLocalVariantItem}" />
                                                                            <CheckBox VerticalAlignment="Center"
                                                                                      IsChecked="{Binding LocalExperimentalHardwareTuneEnabled}"
                                                                                      views:MarkedText.Tip="Also measure this PC: AutoTune reloads the model a few times and times real replies, trying Micro-batch sizes and, on MTP models, draft lengths. Only clearly faster settings are kept. The model is left running the result, unsaved: **Save profile** keeps it, **Revert changes** puts back what you had. Takes a few minutes; progress shows in Diagnostics.">
                                                                                <CheckBox.Content>
                                                                                    <TextBlock Text="Test local system for additional optimisations (experimental)"
                                                                                               TextWrapping="Wrap"
                                                                                               MaxWidth="{DynamicResource FluxSideNoteMaxWidth}"
                                                                                               FontSize="{DynamicResource FluxFontSizeCaption}" />
                                                                                </CheckBox.Content>
                                                                             </CheckBox>
                                                                         </StackPanel>
                                                                         <TextBlock FontSize="{DynamicResource FluxFontSizeCaption}" TextWrapping="Wrap" views:MarkedText.Source="{Binding LocalQuickAutoTuneInfoText}" />
                                                                         <StackPanel Spacing="4" Margin="0,4,0,0" Grid.IsSharedSizeScope="True">
                                                                             <TextBlock Text="Context management:"
                                                                                        FontSize="{DynamicResource FluxFontSizeCaption}"
                                                                                        FontWeight="SemiBold" />

                                                                              <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                  <CheckBox IsChecked="{Binding LocalVibeStateEnabled}" IsEnabled="{Binding VibeStateControlsEnabled}"
                                                                                            VerticalAlignment="Center"
                                                                                            Content="Keep session vibe (VIBE_STATE.md)"
                                                                                            ToolTip.Tip="Keeps a short note of this chat's task and your latest messages, in your own words, and passes it to the model each turn so it keeps its place after the chat is trimmed or the model restarts. Each chat keeps its own note. Hail Mary uses it to rescue a chat that ran out of room. Applies from the next message." />
                                                                              </StackPanel>

                                                                              <TextBlock Text="Context compaction controlled by:" FontSize="{DynamicResource FluxFontSizeCaption}" Margin="0,4,0,0" />
                                                                              <ComboBox ItemsSource="{Binding LocalAutoCompactModeOptions}" 
                                                                                            SelectedItem="{Binding SelectedLocalAutoCompactModeOption}"
                                                                                            HorizontalAlignment="Stretch"
                                                                                            ToolTip.Tip="Who compacts a chat that grows too long for this profile&#x27;s Context. AI-FluxMux, Port rules settings: AI-FluxMux shortens older turns using Compact in Port rules, and Launch turns Cline Auto compact off. AI-FluxMux, this profile&#x27;s settings: the same, using the Trigger and Keep settings below. Either AI-FluxMux choice works the same way for every Client app, keeps the facts of the chat and leaves room for a large next turn: recommended. The Client app: AI-FluxMux leaves the chat as the Client app sends it and only shortens it itself as a last resort at 95% of the Context. Use it only when the Client app's own shortening suits the work better, for example a Client app that keeps its own memory of the task. Applies from the next message." />
                                                                              <Border Padding="8,4" CornerRadius="5" BorderThickness="1"
                                                                                      BorderBrush="{DynamicResource FluxTintAmberBorder}" Background="{DynamicResource FluxTintAmberBackground}"
                                                                                      IsVisible="{Binding LocalAutoCompactMode, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=none}">
                                                                                  <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FluxFontSizeCaption}"
                                                                                             Text="During testing, AI-FluxMux auto compaction retained notably more fidelity than Cline or Harness auto compaction, and was faster and more space efficient than Harness, but slower and less space efficient than Cline. Your mileage may vary with other endpoints or newer versions." />
                                                                              </Border>
                                                                              <Grid ColumnSpacing="6" IsVisible="{Binding LocalAutoCompactMode, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=per-profile}">
                                                                                 <Grid.ColumnDefinitions>
                                                                                     <ColumnDefinition Width="Auto" SharedSizeGroup="CompactRowLabel" />
                                                                                     <ColumnDefinition Width="Auto" SharedSizeGroup="CompactRowField" />
                                                                                     <ColumnDefinition Width="Auto" />
                                                                                 </Grid.ColumnDefinitions>
                                                                                 <TextBlock Text="Trigger:"
                                                                                            FontSize="{DynamicResource FluxFontSizeCaption}"
                                                                                            VerticalAlignment="Center" />
                                                                                 <NumericUpDown Grid.Column="1" Minimum="60" Maximum="95" Increment="5"
                                                                                               Value="{Binding LocalAutoCompactTriggerPercent}"
                                                                                               ToolTip.Tip="Compact when the prompt reaches this percent of the model's context window. Lower = more frequent compaction, less risk of hitting the wall." />
                                                                                 <TextBlock Grid.Column="2" Text="%"
                                                                                            FontSize="{DynamicResource FluxFontSizeCaption}"
                                                                                            VerticalAlignment="Center" />
                                                                             </Grid>
                                                                             <Grid ColumnSpacing="6" IsVisible="{Binding LocalAutoCompactMode, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=per-profile}">
                                                                                 <Grid.ColumnDefinitions>
                                                                                     <ColumnDefinition Width="Auto" SharedSizeGroup="CompactRowLabel" />
                                                                                     <ColumnDefinition Width="Auto" SharedSizeGroup="CompactRowField" />
                                                                                     <ColumnDefinition Width="Auto" />
                                                                                 </Grid.ColumnDefinitions>
                                                                                 <TextBlock Text="Keep turns:"
                                                                                            FontSize="{DynamicResource FluxFontSizeCaption}"
                                                                                            VerticalAlignment="Center" />
                                                                                 <NumericUpDown Grid.Column="1" Minimum="4" Maximum="12"
                                                                                               Value="{Binding LocalAutoCompactKeepTurns}"
                                                                                               ToolTip.Tip="The fewest recent messages kept in full. Compaction keeps as many more as fit in about 60 % of the Context; older ones are summarized." />
                                                                             </Grid>
                                                                             <Grid ColumnSpacing="6" IsVisible="{Binding LocalAutoCompactMode, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=per-profile}">
                                                                                 <Grid.ColumnDefinitions>
                                                                                     <ColumnDefinition Width="Auto" SharedSizeGroup="CompactRowLabel" />
                                                                                     <ColumnDefinition Width="Auto" SharedSizeGroup="CompactRowField" />
                                                                                     <ColumnDefinition Width="Auto" />
                                                                                 </Grid.ColumnDefinitions>
                                                                                 <TextBlock Text="Tool results:"
                                                                                            FontSize="{DynamicResource FluxFontSizeCaption}"
                                                                                            VerticalAlignment="Center" />
                                                                                 <NumericUpDown Grid.Column="1" Minimum="4" Maximum="16"
                                                                                               Value="{Binding LocalAutoCompactKeepToolResults}"
                                                                                               ToolTip.Tip="Recent tool results kept. Older results get cleared." />
                                                                             </Grid>
                                                                             <Grid ColumnSpacing="6" IsVisible="{Binding LocalAutoCompactMode, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=per-profile}">
                                                                                 <Grid.ColumnDefinitions>
                                                                                     <ColumnDefinition Width="Auto" SharedSizeGroup="CompactRowLabel" />
                                                                                     <ColumnDefinition Width="Auto" SharedSizeGroup="CompactRowField" />
                                                                                     <ColumnDefinition Width="Auto" />
                                                                                 </Grid.ColumnDefinitions>
                                                                                 <TextBlock Text="Pin user:"
                                                                                            FontSize="{DynamicResource FluxFontSizeCaption}"
                                                                                            VerticalAlignment="Center" />
                                                                                 <NumericUpDown Grid.Column="1" Minimum="500" Maximum="5000" Increment="500"
                                                                                               Value="{Binding LocalAutoCompactPinUserChars}"
                                                                                               ToolTip.Tip="How much of an older user task to preserve verbatim. The model never loses sight of what it was asked to do." />
                                                                             </Grid>
                                                                         </StackPanel>
                                                                    </StackPanel>
                                                                    <StackPanel Spacing="2" Margin="0,6,0,0">
                                                                        <TextBlock FontSize="{DynamicResource FluxFontSizeCaption}" TextWrapping="Wrap" Text="{Binding LocalVariantFootprintText}" />
                                                                        <TextBlock FontSize="{DynamicResource FluxFontSizeSmall}" Opacity="0.82" TextWrapping="Wrap" Text="{Binding LocalVariantPerformanceEstimateText}" />
                                                                        <TextBlock FontSize="{DynamicResource FluxFontSizeSmall}"
                                                                                   Opacity="0.75"
                                                                                   TextWrapping="Wrap"
                                                                                   IsVisible="{Binding ShowLocalLaunchTelemetryText}"
                                                                                   Text="{Binding LocalLaunchTelemetryText}"
                                                                                   ToolTip.Tip="{Binding LocalLaunchTelemetryDetailText}" />
                                                                    </StackPanel>
                                                                    <TextBlock Margin="0,10,0,0"
                                                                               FontSize="{DynamicResource FluxFontSizeCaption}"
                                                                               TextWrapping="Wrap"
                                                                               Foreground="#C2410C"
                                                                               IsVisible="{Binding ShowLocalVariantVramWarning}"
                                                                               Text="{Binding LocalVariantVramWarningText}" />
                                                                    <TextBlock Margin="0,6,0,0"
                                                                               FontSize="{DynamicResource FluxFontSizeCaption}"
                                                                               TextWrapping="Wrap"
                                                                               Foreground="#B91C1C"
                                                                               IsVisible="{Binding ShowLocalVariantRamOverflowWarning}"
                                                                               Text="{Binding LocalVariantRamOverflowWarningText}" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Spacing="8" IsEnabled="{Binding IsLocalVariantEditable}">
                                                                    <TextBlock FontSize="{DynamicResource FluxFontSizeHeading}" FontWeight="SemiBold" Text="Detailed settings" />
                                                                    <Border Padding="8,6" CornerRadius="5" BorderBrush="{DynamicResource FluxTintAmberBorder}" BorderThickness="1" Background="{DynamicResource FluxTintAmberBackground}">
                                                                        <StackPanel Spacing="6">
                                                                            <TextBlock FontSize="{DynamicResource FluxFontSizeBody}" FontWeight="SemiBold" Text="Images" />
                                                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Enable" />
                                                                                <ComboBox Grid.Column="1" ItemsSource="{Binding LocalOnOffOptions}" SelectedItem="{Binding LocalVariantVisionEnabled}" ToolTip.Tip="On: this model can look at pictures (needs a matching extra file and uses more graphics memory). Off: text only. AutoTune does not change this — it works around the leftover graphics memory." />
                                                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Max image edge" />
                                                                                <NumericUpDown Grid.Column="3" Minimum="256" Maximum="4096" Increment="64" Value="{Binding LocalVariantVisionMaxImageEdge}" ToolTip.Tip="Largest picture size (longest side, in pixels) this model will accept. Bigger reserves more graphics memory, so AutoTune and Context have less headroom." />
                                                                            </Grid>
                                                                            <!-- Projector file: the list and Browse on one line, the path box under it at full width.
                                                                                 A long file name ("mmproj-Qwen3.8-27B-NVFP4-BF16.gguf (same folder)") left no room for the path
                                                                                 box between them, and "*,2*" columns cut the name off instead (28 Nov). -->
                                                                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Projector file" />
                                                                                <ComboBox Grid.Column="1"
                                                                                          HorizontalAlignment="Stretch"
                                                                                          VerticalAlignment="Center"
                                                                                          ItemsSource="{Binding LocalVariantVisionProjectorChoices}"
                                                                                          SelectedItem="{Binding SelectedLocalVariantVisionProjectorChoice}"
                                                                                          ToolTip.Tip="Picture helper files in the models folder that look like they belong to this model. Unrelated files are hidden. Browse if yours is missing." />
                                                                                <Button Grid.Column="2"
                                                                                        VerticalAlignment="Center"
                                                                                        Content="Browse"
                                                                                        Command="{Binding BrowseVisionProjectorCommand}"
                                                                                        ToolTip.Tip="Pick the picture-helper file if it was not found automatically." />
                                                                                <TextBox Grid.Row="1"
                                                                                         Grid.Column="1"
                                                                                         Grid.ColumnSpan="2"
                                                                                         VerticalAlignment="Center"
                                                                                         Text="{Binding LocalVariantVisionProjectorPath}"
                                                                                         PlaceholderText="Or paste a projector path"
                                                                                         ToolTip.Tip="Usually filled from the list. Browse only if the matching picture-helper file was not found." />
                                                                            </Grid>
                                                                            <TextBlock FontSize="{DynamicResource FluxFontSizeCaption}" TextWrapping="Wrap" Opacity="0.9" Text="{Binding LocalVariantImagesHeadroomNote}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <Border Padding="8,6" CornerRadius="5" BorderBrush="{DynamicResource FluxMutedBorder}" BorderThickness="1" Background="{DynamicResource FluxMutedBackground}">
                                                                        <StackPanel Spacing="6">
                                                                            <TextBlock FontSize="{DynamicResource FluxFontSizeBody}" FontWeight="SemiBold" Text="Fit and memory" />
                                                                            <!-- Label and value pairs that wrap: each takes the widest label and value in this group (shared sizes), so columns line up and a narrow pane gives fewer per row instead of cutting values off (27 Nov). -->
                                                                            <WrapPanel Orientation="Horizontal" Grid.IsSharedSizeScope="True">
                                                                                <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Context" />
                                                                                    <NumericUpDown Grid.Column="1" HorizontalAlignment="Stretch" Minimum="1024" Maximum="{Binding LocalVariantContextMax}" Increment="1024" Value="{Binding LocalVariantContext}" ToolTip.Tip="How much of the chat the model can keep in mind. More uses more graphics memory and needs a reload. AutoTune sizes this from the graphics memory left after the model and Images." />
                                                                                </Grid>
                                                                                <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Flash" />
                                                                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LocalOnOffOptions}" SelectedItem="{Binding LocalVariantFlashAttention}" ToolTip.Tip="Usually makes long chats faster and lighter on graphics memory. Leave On unless a model misbehaves with it. AutoTune turns it on for NVIDIA cards." />
                                                                                </Grid>
                                                                                <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Fit VRAM" />
                                                                                    <CheckBox Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" IsChecked="{Binding LocalVariantFitEnabled}" Content="On" ToolTip.Tip="On: shrink settings so the model still fits in graphics memory. Off: keep the sizes you set, even if that needs more graphics memory. Save keeps this choice." />
                                                                                </Grid>
                                                                                <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="KV key" />
                                                                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LocalKvCacheOptions}" SelectedItem="{Binding LocalVariantKvCacheTypeK}" ToolTip.Tip="How precisely the model remembers earlier turns. q8_0 or f16 is the most faithful. q5 or q4 fit roughly twice the Context in the same graphics memory, but recall of earlier turns is weaker: worth it when Context matters more than Fidelity. Keep KV value the same unless you are tuning on purpose." />
                                                                                </Grid>
                                                                                <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="KV value" />
                                                                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LocalKvCacheOptions}" SelectedItem="{Binding LocalVariantKvCacheTypeV}" ToolTip.Tip="How precisely the model remembers earlier turns. q8_0 or f16 is the most faithful. q5 or q4 fit roughly twice the Context in the same graphics memory, but recall of earlier turns is weaker: worth it when Context matters more than Fidelity. Keep KV key the same unless you are tuning on purpose." />
                                                                                </Grid>
                                                                                <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="SWA full" />
                                                                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LocalOnOffOptions}" SelectedItem="{Binding LocalVariantSwaFull}" ToolTip.Tip="Keeps extra chat memory on some models. Try On if long chats forget what you just said. On a model that uses a sliding window on most layers (such as Inkling) it keeps the whole Context on every layer, which takes far more graphics memory at long Context; off, the window layers stay small." />
                                                                                </Grid>
                                                                                <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Cache reuse" />
                                                                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LocalCacheReuseOptions}" SelectedItem="{Binding LocalVariantCacheReuse}" ToolTip.Tip="Reuse work from similar earlier questions so follow-ups can start sooner." />
                                                                                </Grid>
                                                                                <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Cache RAM" />
                                                                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LocalCacheRamOptions}" SelectedItem="{Binding LocalVariantCacheRam}" ToolTip.Tip="How much ordinary computer memory to keep for that reuse. Unlimited helps long back-and-forth chats. Disabled turns reuse off." />
                                                                                </Grid>
                                                                                <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Cache strategy" />
                                                                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LocalCacheStrategyOptions}" SelectedItem="{Binding LocalVariantCacheStrategy}" ToolTip.Tip="How the model reuses its work from the previous turn so the next reply starts sooner. Auto picks the right method for this model (models that read pictures or use MTP need a different one). Leave on Auto." />
                                                                                </Grid>
                                                                            </WrapPanel>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <Border Padding="8,6" CornerRadius="5" BorderBrush="{DynamicResource FluxTintGreenBorder}" BorderThickness="1" Background="{DynamicResource FluxTintGreenBackground}">
                                                                        <StackPanel Spacing="6">
                                                                            <TextBlock FontSize="{DynamicResource FluxFontSizeBody}" FontWeight="SemiBold" Text="Graphics card" />
                                                                            <!-- Label and value pairs that wrap: each takes the widest label and value in this group (shared sizes), so columns line up and a narrow pane gives fewer per row instead of cutting values off (27 Nov). -->
                                                                            <WrapPanel Orientation="Horizontal" Grid.IsSharedSizeScope="True">
                                                                                <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="GPU mode" />
                                                                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LocalGpuOffloadModeOptions}" SelectedItem="{Binding LocalVariantGpuOffloadMode}" ToolTip.Tip="Run the model on the graphics card, the ordinary processor, or both. More graphics-card use is usually faster if there is enough graphics memory." />
                                                                                </Grid>
                                                                                <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="GPU layers" />
                                                                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LocalGpuLayersChoices}" SelectedItem="{Binding LocalVariantGpuLayers}" ToolTip.Tip="How much of the model sits on the graphics card. More is usually faster if there is room. Auto lets AI-FluxMux place it. Auto is only on editable copies." />
                                                                                </Grid>
                                                                                <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Speculative" />
                                                                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LocalSpecTypeOptions}" SelectedItem="{Binding LocalVariantSpecType}" ToolTip.Tip="Lets the model guess a few words ahead and check them, so replies come out faster with exactly the same text. Use draft-mtp for models built with MTP (for example Qwen 3.x MTP files); ngram-simple helps a little on any model; Disabled turns it off." />
                                                                                </Grid>
                                                                                <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Multi-GPU" />
                                                                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LocalMultiGpuModeOptions}" SelectedItem="{Binding LocalVariantMultiGpuMode}" ToolTip.Tip="Auto: with two or more graphics cards, the model is spread across them by free memory. Disabled: use one card only. Manual: use the split settings below." />
                                                                                </Grid>
                                                                                <Grid ColumnSpacing="8" Margin="0,0,16,6" IsVisible="{Binding ShowLocalMultiGpuManualSettings}">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Split mode" />
                                                                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LocalSplitModeOptions}" SelectedItem="{Binding LocalVariantSplitMode}" ToolTip.Tip="How llama-server spreads the model across graphics cards. Layer is usually best for two cards." />
                                                                                </Grid>
                                                                                <Grid ColumnSpacing="8" Margin="0,0,16,6" IsVisible="{Binding ShowLocalMultiGpuManualSettings}">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Main GPU" />
                                                                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LocalMainGpuOptions}" SelectedItem="{Binding LocalVariantMainGpu}" ToolTip.Tip="Which graphics card owns intermediate results. Auto lets llama-server choose." />
                                                                                </Grid>
                                                                                <Grid ColumnSpacing="8" Margin="0,0,16,6" IsVisible="{Binding ShowLocalMultiGpuManualSettings}">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Tensor split" />
                                                                                    <TextBox Grid.Column="1" HorizontalAlignment="Stretch" Text="{Binding LocalVariantTensorSplit}" PlaceholderText="Auto or 50,50" ToolTip.Tip="Comma-separated share per graphics card, for example 60,40. Auto lets llama-server or AI-FluxMux choose." />
                                                                                </Grid>
                                                                            </WrapPanel>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <Border Padding="8,6" CornerRadius="5" BorderBrush="{DynamicResource FluxTintOrangeBorder}" BorderThickness="1" Background="{DynamicResource FluxTintOrangeBackground}">
                                                                        <StackPanel Spacing="6">
                                                                            <TextBlock FontSize="{DynamicResource FluxFontSizeBody}" FontWeight="SemiBold" Text="Prompt and CPU" />
                                                                            <!-- Label and value pairs that wrap: each takes the widest label and value in this group (shared sizes), so columns line up and a narrow pane gives fewer per row instead of cutting values off (27 Nov). -->
                                                                            <WrapPanel Orientation="Horizontal" Grid.IsSharedSizeScope="True">
                                                                                <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Threads" />
                                                                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LocalThreadOptions}" SelectedItem="{Binding LocalVariantOverrideThreads}" ToolTip.Tip="How many processor cores to use when writing the answer. AutoTune usually aims for about half of your cores. More is not always faster." />
                                                                                </Grid>
                                                                                <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Batch threads" />
                                                                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LocalThreadBatchOptions}" SelectedItem="{Binding LocalVariantThreadsBatch}" ToolTip.Tip="How many processor cores to use while reading your question. More can be faster if the rest of the PC is not busy." />
                                                                                </Grid>
                                                                                <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Batch size" />
                                                                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LocalBatchSizeOptions}" SelectedItem="{Binding LocalVariantBatchSize}" ToolTip.Tip="How much of a long prompt is read at once. Larger reads long chats faster but uses more graphics memory. Must be at least Micro-batch." />
                                                                                </Grid>
                                                                                <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Micro-batch" />
                                                                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LocalUbatchSizeOptions}" SelectedItem="{Binding LocalVariantUbatchSize}" ToolTip.Tip="How much of the prompt the graphics card reads per step. Larger reads long chats noticeably faster for a little more graphics memory. Lower it only if the model fails to load for lack of memory. Speed AutoTune can try sizes on this PC." />
                                                                                </Grid>
                                                                                <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Multi-user" />
                                                                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LocalOnOffOptions}" SelectedItem="{Binding LocalVariantMultiUserMode}" ToolTip.Tip="Allow more than one question at a time. This does not make a single answer faster, and each extra question uses graphics memory." />
                                                                                </Grid>
                                                                                <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Draft length" IsEnabled="{Binding IsLocalSpecDraftLengthApplicable}" />
                                                                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LocalSpecDraftNMaxOptions}" SelectedItem="{Binding LocalVariantSpecDraftNMax}" IsEnabled="{Binding IsLocalSpecDraftLengthApplicable}" ToolTip.Tip="With Speculative on draft-mtp: how many words the model guesses ahead. Higher can be faster until too many guesses are rejected; it never changes the text. Auto is 2. Speed AutoTune can find the best value for this PC. Needs a reload." />
                                                                                </Grid>
                                                                            </WrapPanel>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <Border Padding="8,6" CornerRadius="5" BorderBrush="{DynamicResource FluxTintPurpleBorder}" BorderThickness="1" Background="{DynamicResource FluxTintPurpleBackground}">
                                                                        <StackPanel Spacing="6">
                                                                            <TextBlock FontSize="{DynamicResource FluxFontSizeBody}" FontWeight="SemiBold" Text="Chat format" />
                                                                            <!-- Label and value pairs that wrap: each takes the widest label and value in this group (shared sizes), so columns line up and a narrow pane gives fewer per row instead of cutting values off (27 Nov). -->
                                                                            <WrapPanel Orientation="Horizontal" Grid.IsSharedSizeScope="True">
                                                                                <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Template" />
                                                                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LocalChatTemplateOptions}" SelectedItem="{Binding LocalVariantChatTemplate}" ToolTip.Tip="Auto uses the format stored in the local model. Pick a named format only for older models. Newer Qwen models must stay on Auto or they may ignore instructions from the Client app." />
                                                                                </Grid>
                                                                                <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Chat parser" />
                                                                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LocalChatParserOptions}" SelectedItem="{Binding LocalVariantChatParser}" ToolTip.Tip="How chat messages are read. Leave the default unless answers look garbled. Skip parsing is a last resort." />
                                                                                </Grid>
                                                                                <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Unban tokens" />
                                                                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LocalOnOffOptions}" SelectedItem="{Binding LocalVariantUnbanTokensMode}" ToolTip.Tip="Lets the model use a few special words llama-server normally blocks. Some chat formats need it, and AutoTune turns it on for those." />
                                                                                </Grid>
                                                                                <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Thinking budget" />
                                                                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LocalReasoningBudgetOptions}" SelectedItem="{Binding LocalVariantReasoningBudget}" ToolTip.Tip="The most the model may think before it answers, when Reasoning is on. Unlimited: no cap. 0: no thinking. A cap gets replies started sooner but can make answers shallower. Needs a reload." />
                                                                                </Grid>
                                                                            </WrapPanel>
                                                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                                                <TextBlock FontSize="{DynamicResource FluxFontSizeBody}"
                                                                                           FontWeight="SemiBold"
                                                                                           VerticalAlignment="Center"
                                                                                           Text="Reply style" />
                                                                                <TextBlock FontSize="{DynamicResource FluxFontSizeCaption}"
                                                                                           Opacity="0.72"
                                                                                           VerticalAlignment="Center"
                                                                                           Text="next message · no reload"
                                                                                           ToolTip.Tip="Temperature, max tokens, and Reasoning apply on the next Client-app message while this profile is loaded. llama-server is not reloaded." />
                                                                            </StackPanel>
                                                                            <!-- Label and value pairs that wrap: each takes the widest label and value in this group (shared sizes), so columns line up and a narrow pane gives fewer per row instead of cutting values off (27 Nov). -->
                                                                            <WrapPanel Orientation="Horizontal" Grid.IsSharedSizeScope="True">
                                                                                <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Temperature" />
                                                                                    <NumericUpDown Grid.Column="1" HorizontalAlignment="Stretch" Minimum="0" Maximum="2" Increment="0.05" Value="{Binding LocalVariantTemperature}" ToolTip.Tip="How mixed the wording is. Lower is more repeatable. Higher is more varied. Does not make answers faster." />
                                                                                </Grid>
                                                                                <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Max tokens" />
                                                                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LocalMaxTokenOptions}" SelectedItem="{Binding LocalVariantMaxTokens}" ToolTip.Tip="How long one answer can be. Shorter answers may stop in the middle of a reply. AutoTune and the priority arrows will not lower this. Save keeps it." />
                                                                                </Grid>
                                                                                <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Reasoning" />
                                                                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LocalReasoningOptions}" SelectedItem="{Binding LocalVariantReasoning}" ToolTip.Tip="Whether the model writes a hidden thinking step before answering. Off is usually better for the Client app. Use the Quick Select list for Off, Low, Medium, or XHigh on the running row." />
                                                                                </Grid>
                                                                            </WrapPanel>
                                                                            <Expander Classes="fieldHeight"
                                                                                      Header="Sampling · needs a reload"
                                                                                      IsExpanded="False"
                                                                                      HorizontalAlignment="Stretch"
                                                                                      ToolTip.Tip="llama-server's default word-choice settings. They apply only when the Client app does not send its own. Server default leaves llama-server's built-in value. Qwen suggests top-k 20, top-p 0.95, min-p 0, and presence penalty 1.5 for quantized models that repeat themselves.">
                                                                                <Expander.Resources>
                                                                                    <x:Double x:Key="ExpanderMinHeight">28</x:Double>
                                                                                    <Thickness x:Key="ExpanderHeaderPadding">8,0,0,0</Thickness>
                                                                                    <Thickness x:Key="ExpanderChevronMargin">8,0,8,0</Thickness>
                                                                                </Expander.Resources>
                                                                                <!-- Label and value pairs that wrap: each takes the widest label and value in this group (shared sizes), so columns line up and a narrow pane gives fewer per row instead of cutting values off (27 Nov). -->
                                                                                <WrapPanel Orientation="Horizontal" Grid.IsSharedSizeScope="True" Margin="0,6,0,0">
                                                                                    <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Top-k" />
                                                                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LocalTopKOptions}" SelectedItem="{Binding LocalVariantTopK}" ToolTip.Tip="Only the k most likely next words are considered. llama-server default 40; Qwen suggests 20." />
                                                                                    </Grid>
                                                                                    <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Top-p" />
                                                                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LocalTopPOptions}" SelectedItem="{Binding LocalVariantTopP}" ToolTip.Tip="Only the most likely words that add up to this share are considered. llama-server default 0.95." />
                                                                                    </Grid>
                                                                                    <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Min-p" />
                                                                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LocalMinPOptions}" SelectedItem="{Binding LocalVariantMinP}" ToolTip.Tip="Drops words far less likely than the best one. llama-server default 0.05; Qwen suggests 0." />
                                                                                    </Grid>
                                                                                    <Grid ColumnSpacing="8" Margin="0,0,16,6">
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                                                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="FieldValue" />
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Presence" />
                                                                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LocalPresencePenaltyOptions}" SelectedItem="{Binding LocalVariantPresencePenalty}" ToolTip.Tip="Discourages repeating words already used. Try 1.5 if a quantized model starts looping the same lines. Too high can make code worse." />
                                                                                    </Grid>
                                                                                </WrapPanel>
                                                                            </Expander>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Grid>
                                                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="6">
                                                                <Button Grid.Column="0" Content="Revert changes" VerticalAlignment="Center" Command="{Binding RevertLocalVariantCommand}" ToolTip.Tip="Throw away unsaved edits and put back the last saved settings." />
                                                                <Button Grid.Column="1" Content="Use model defaults" VerticalAlignment="Center" Command="{Binding UseLocalModelDefaultsCommand}" views:MarkedText.Tip="Load this model's starting settings as unsaved edits. Click **Save profile** to keep them." />
                                                                <Button Grid.Column="2"
                                                                        VerticalAlignment="Center"
                                                                        IsEnabled="{Binding CanValidateActiveLocalProfile}"
                                                                        Command="{Binding ValidateLocalProfileToEndpointCommand}"
                                                                        CommandParameter="{Binding SelectedLocalVariantItem}"
                                                                        ToolTip.Tip="Starts this local model with these settings and sends a short test the same way the Client app would. If it answers, it can be chosen in Quick Select.">
                                                                    <TextBlock Text="Validate to endpoint" TextWrapping="NoWrap" />
                                                                </Button>
                                                                <Button Grid.Column="3"
                                                                        VerticalAlignment="Center"
                                                                        IsEnabled="{Binding IsLocalVariantEditable}"
                                                                        Command="{Binding SaveLocalVariantCommand}">
                                                                    <TextBlock Text="Save profile" TextWrapping="NoWrap" />
                                                                </Button>
                                                                <TextBox Grid.Column="4"
                                                                         Classes="profileName"
                                                                         IsEnabled="{Binding IsLocalVariantEditable}"
                                                                         Text="{Binding LocalVariantDraftName}"
                                                                         PlaceholderText="New profile name"
                                                                         ToolTip.Tip="Type a new name, then click Rename." />
                                                                <Button Grid.Column="5"
                                                                        Content="Rename"
                                                                        VerticalAlignment="Center"
                                                                        IsEnabled="{Binding IsLocalVariantEditable}"
                                                                        Command="{Binding RenameLocalVariantCommand}" />
                                                                <Button Grid.Column="6"
                                                                        Content="Delete"
                                                                        VerticalAlignment="Center"
                                                                        IsEnabled="{Binding IsLocalVariantEditable}"
                                                                        Command="{Binding DeleteLocalVariantCommand}"
                                                                        CommandParameter="{Binding SelectedLocalVariantItem}"
                                                                        ToolTip.Tip="Deletes this copy from AI-FluxMux. If this is the default, the whole local model and its copies are removed from AI-FluxMux. The local model on disk is not deleted." />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" HorizontalAlignment="Stretch">
                                                                <Button Grid.Column="0" Content="Make New Variant" Command="{Binding AddGuidedProfileVariantCommand}" CommandParameter="Local" views:MarkedText.Tip="Creates a new model profile variant that starts with a copy of this profile's settings. Type a name in the box first. Change at least one setting, then **Save profile** — AI-FluxMux will not keep two variants with the same settings package." />
                                                                <TextBox Grid.Column="1" Classes="profileName" Text="{Binding NewProfileVariantName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding LocalNewVariantPlaceholder}" ToolTip.Tip="Type a name here, then click Make New Variant. AI-FluxMux will tell you if this box is empty." />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" HorizontalAlignment="Stretch">
                                                                <Panel Grid.Column="0" VerticalAlignment="Center">
                                                                    <TextBlock Classes="profileStatusIcon"
                                                                               Text="⚠"
                                                                               Foreground="#DC2626"
                                                                               IsVisible="{Binding SelectedLocalVariantItem.ShowMissingFileWarning, FallbackValue=False, TargetNullValue=False}" />
                                                                    <TextBlock Classes="profileStatusIcon"
                                                                               Text="✓"
                                                                               Foreground="#16A34A"
                                                                               IsVisible="{Binding SelectedLocalVariantItem.ShowValidatedCheck, FallbackValue=False, TargetNullValue=False}" />
                                                                </Panel>
                                                                <TextBlock Grid.Column="1"
                                                                           FontSize="{DynamicResource FluxFontSizeCaption}"
                                                                           TextWrapping="Wrap"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxLines="2"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{Binding SelectedLocalVariantItem.EndpointStatusForeground}"
                                                                           Text="{Binding SelectedLocalVariantItem.EndpointStatusText}" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
        </DataTemplate>
        <ControlTheme x:Key="DiagnosticsSashTheme" TargetType="GridSplitter">
            <Setter Property="Background" Value="{DynamicResource FluxChromeBackground}" />
            <Setter Property="MinHeight" Value="12" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel Background="{TemplateBinding Background}">
                        <Border x:Name="SashHoverLine"
                                Height="4"
                                CornerRadius="2"
                                VerticalAlignment="Center"
                                Background="{DynamicResource FluxSashHover}"
                                IsHitTestVisible="False"
                                Opacity="0">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.10" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <StackPanel x:Name="SashDots"
                                    Orientation="Horizontal"
                                    Spacing="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <shapes:Ellipse Width="4" Height="4" Fill="{DynamicResource FluxSashGrip}" />
                            <shapes:Ellipse Width="4" Height="4" Fill="{DynamicResource FluxSashGrip}" />
                            <shapes:Ellipse Width="4" Height="4" Fill="{DynamicResource FluxSashGrip}" />
                        </StackPanel>
                    </Panel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#SashHoverLine">
                <Setter Property="Opacity" Value="0.85" />
            </Style>
            <Style Selector="^:pressed /template/ Border#SashHoverLine">
                <Setter Property="Opacity" Value="0.85" />
            </Style>
        </ControlTheme>
        <ControlTheme x:Key="DiagnosticsVerticalSashTheme" TargetType="GridSplitter">
            <Setter Property="Background" Value="{DynamicResource FluxChromeBackground}" />
            <Setter Property="MinWidth" Value="12" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel Background="{TemplateBinding Background}">
                        <Border x:Name="SashHoverLine"
                                Width="4"
                                CornerRadius="2"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource FluxSashHover}"
                                IsHitTestVisible="False"
                                Opacity="0">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.10" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <StackPanel x:Name="SashDots"
                                    Orientation="Vertical"
                                    Spacing="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <shapes:Ellipse Width="4" Height="4" Fill="{DynamicResource FluxSashGrip}" />
                            <shapes:Ellipse Width="4" Height="4" Fill="{DynamicResource FluxSashGrip}" />
                            <shapes:Ellipse Width="4" Height="4" Fill="{DynamicResource FluxSashGrip}" />
                        </StackPanel>
                    </Panel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#SashHoverLine">
                <Setter Property="Opacity" Value="0.85" />
            </Style>
            <Style Selector="^:pressed /template/ Border#SashHoverLine">
                <Setter Property="Opacity" Value="0.85" />
            </Style>
        </ControlTheme>
    </Window.Resources>

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock.reorderGrip">
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="{DynamicResource FluxFontSizeHeading}" />
            <Setter Property="Opacity" Value="0.72" />
            <Setter Property="Cursor" Value="SizeAll" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Grid.vramCaution TextBlock">
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="Opacity" Value="0.62" />
        </Style>
        <Style Selector="Border.slotRuntimeChrome.activeRuntimeLive">
            <Setter Property="Background" Value="{DynamicResource FluxQuickSelectLiveBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FluxQuickSelectLiveBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.slotRuntimeChrome.activeRuntimeAmber">
            <Setter Property="BorderBrush" Value="{DynamicResource FluxTintAmberBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.slotRuntimeChrome.activeRuntimeFault">
            <Setter Property="Background" Value="{DynamicResource FluxQuickSelectFaultBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FluxTintOrangeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.slotRuntimeChrome.standbyHotLive">
            <Setter Property="Background" Value="{DynamicResource FluxQuickSelectStandbyBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FluxQuickSelectStandbyBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.slotRuntimeChrome.standbyHotAmber">
            <Setter Property="BorderBrush" Value="{DynamicResource FluxTintAmberBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.slotLoadingFill">
            <Setter Property="Background" Value="{DynamicResource FluxTintAmberBackground}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.45" Easing="CubicEaseInOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.slotRuntimeChrome.standbyHotFault">
            <Setter Property="Background" Value="{DynamicResource FluxQuickSelectFaultBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FluxTintOrangeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.headerLockButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style Selector="Button.headerLockButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF" />
        </Style>
        <Style Selector="Border.profileHeaderChrome">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="1" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.22" />
                    <BrushTransition Property="Background" Duration="0:0:0.22" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.profileHeaderChrome:pointerover">
            <Setter Property="BorderBrush" Value="#93C5FD" />
            <Setter Property="Background" Value="#2260A5FA" />
        </Style>
        <Style Selector="Border.profileHeaderChrome.profileSelected">
            <Setter Property="BorderBrush" Value="#2563EB" />
            <Setter Property="Background" Value="#332563EB" />
        </Style>
        <Style Selector="Border.profileHeaderChrome.profileExpanded">
            <Setter Property="BorderBrush" Value="#16A34A" />
        </Style>
        <Style Selector="Border.profileHeaderChrome.profileSelected.profileExpanded">
            <Setter Property="BorderBrush" Value="#1D4ED8" />
            <Setter Property="Background" Value="#332563EB" />
        </Style>
        <Style Selector="Border.profileHeaderChrome.profileSelected:pointerover">
            <Setter Property="BorderBrush" Value="#1D4ED8" />
        </Style>
        <Style Selector="Border.profileEditingBadge">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
        </Style>
        <Style Selector="Border.corporateLogoBadge">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.comboLogoChip">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="2" />
        </Style>
        <Style Selector="Image.corporateLogo">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Image.appLogo">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Height" Value="44" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.appLogoBadge">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Image.helpCopyrightLogo">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
        <Style Selector="TabControl.mainTabs /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Height" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleBar">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel > TextBlock">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="WindowDrawnDecorations /template/ Button#PART_FullScreenButton">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Width" Value="0" />
        </Style>
        <Style Selector="TabStrip#MainTabStrip TabStripItem">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="{DynamicResource FluxFontSizeTab}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TabStrip#MainTabStrip TabStripItem:selected">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TabStrip#MainTabStrip TabStripItem:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Height" Value="0" />
        </Style>
        <Style Selector="TextBlock.profileStatusIcon">
            <Setter Property="FontSize" Value="{DynamicResource FluxFontSizeStatusIcon}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="LineHeight" Value="24" />
        </Style>
        <Style Selector="TextBox.profileName">
            <Setter Property="MinLines" Value="1" />
            <Setter Property="MaxLines" Value="4" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="TextBox.diagnosticTerminal">
            <Setter Property="Background" Value="#101828" />
            <Setter Property="Foreground" Value="#D1FADF" />
            <Setter Property="BorderBrush" Value="#344054" />
            <Setter Property="SelectionBrush" Value="#175CD3" />
            <Setter Property="SelectionForegroundBrush" Value="White" />
            <Setter Property="MinLines" Value="2" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="TextBox.diagnosticTerminal:pointerover">
            <Setter Property="Background" Value="#101828" />
            <Setter Property="Foreground" Value="#D1FADF" />
            <Setter Property="BorderBrush" Value="#475467" />
        </Style>
        <Style Selector="TextBox.diagnosticTerminal:focus">
            <Setter Property="Background" Value="#101828" />
            <Setter Property="Foreground" Value="#D1FADF" />
            <Setter Property="BorderBrush" Value="#344054" />
        </Style>
        <Style Selector="TextBox.diagnosticTerminal:focus-within">
            <Setter Property="Background" Value="#101828" />
            <Setter Property="Foreground" Value="#D1FADF" />
            <Setter Property="BorderBrush" Value="#344054" />
        </Style>
    </Window.Styles>

    <Panel>
    <LayoutTransformControl x:Name="LayoutScaler">
        <LayoutTransformControl.LayoutTransform>
            <ScaleTransform ScaleX="1" ScaleY="1" />
        </LayoutTransformControl.LayoutTransform>

    <Grid x:Name="MainLayoutGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="160" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="{Binding DiagnosticsRowHeight}" MinHeight="{Binding DiagnosticsPanelMinHeight}" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Padding="18,8,0,8"
                Background="{DynamicResource FluxChromeBackground}"
                BorderBrush="{DynamicResource FluxCardBorder}"
                BorderThickness="0,0,0,1">
        <Grid x:Name="HeaderChrome"
              ColumnDefinitions="Auto,*,Auto"
              LayoutUpdated="HeaderChrome_LayoutUpdated">
            <Border Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Background="Transparent"
                    WindowDecorationProperties.ElementRole="TitleBar" />
            <Border Grid.Column="0"
                    Classes="appLogoBadge"
                    Margin="2,0,0,0"
                    VerticalAlignment="Center"
                    WindowDecorationProperties.ElementRole="User"
                    ToolTip.Tip="AI-FluxMux">
                <ctrl:AnimatedAppLogo IsPlaying="{Binding IsModelActive}" />
            </Border>
            <TabStrip x:Name="MainTabStrip"
                      Grid.Column="1"
                      Margin="12,0,8,0"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      WindowDecorationProperties.ElementRole="User"
                      SelectedIndex="{Binding SelectedMainTabIndex}">
                <TabStrip.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="0" />
                    </ItemsPanelTemplate>
                </TabStrip.ItemsPanel>
                <TabStripItem ToolTip.Tip="Start, reload, or stop models you have already tested. This is the day-to-day tab.">Quick Select</TabStripItem>
                <TabStripItem ToolTip.Tip="The port the Client app connects to, where local models live, which program runs them, and cloud API keys.">Servers</TabStripItem>
                <TabStripItem ToolTip.Tip="Create model profiles for each local model or cloud model, then test that they actually answer before they appear in Quick Select.">Model Profiles</TabStripItem>
                <TabStripItem ToolTip.Tip="Lab tests: how well a chat survives switching between two tested models (two locals, local and cloud, or two clouds). This unloads and reloads; it is not everyday routing.">Live-Switch Testing</TabStripItem>
                <TabStripItem ToolTip.Tip="Checks llama-server, the model folder, the graphics card, paths, and cloud keys.">Environment</TabStripItem>
                <TabStripItem ToolTip.Tip="Configure GPU &amp; VRAM, idle timeout, UI scale, theme, and window width preferences.">Settings</TabStripItem>
                <TabStripItem>Help</TabStripItem>
            </TabStrip>
            <Panel x:Name="CaptionButtonSpacer"
                   Grid.Column="2"
                   MinWidth="138"
                   IsHitTestVisible="False" />
        </Grid>
        </Border>

        <TabControl x:Name="MainTabs"
                    Grid.Row="1"
                    Classes="mainTabs"
                    Margin="14,4,14,0"
                    HorizontalAlignment="Stretch"
                    ClipToBounds="True"
                    Background="{DynamicResource FluxPaneBackground}"
                    SelectedIndex="{Binding SelectedMainTabIndex}"
                    SelectionChanged="OnMainTabsSelectionChanged">
            <TabItem Header="Quick Select" ToolTip.Tip="Start, reload, or stop models you have already tested. This is the day-to-day tab.">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10" Margin="0,8,0,8">
                        <views:OptionInfoNote InfoId="quickselect.intro"
                                              NoteText="Quick Select only runs profiles that already passed **Validate to endpoint** on the Model Profiles tab. Choose a validated profile in a slot, click **Save**, then **Launch**. A newly validated copy is offered on the first empty row. You cannot add another slot while a populated slot is still unsaved." />
                        <WrapPanel Orientation="Horizontal">
                            <StackPanel Spacing="2" Margin="0,0,16,4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <CheckBox VerticalAlignment="Center"
                                              IsChecked="{Binding LoadSelectedProfileOnStartup}"
                                              ToolTip.Tip="On: when AI-FluxMux starts, it loads the selected Quick Select profile for you. Off: you start profiles yourself." />
                                    <TextBlock VerticalAlignment="Center" Text="Auto-load selected profile on startup" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Spacing="2" Margin="0,0,16,4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <CheckBox VerticalAlignment="Center"
                                              IsChecked="{Binding RequestRoutingEnabled}"
                                              ToolTip.Tip="Off: only one model answers at a time. On: a ready local and a ready cloud can both take turns on Port; AI-FluxMux asks before a switch, and Cloud Usage Mode sets how often cloud is offered." />
                                    <TextBlock VerticalAlignment="Center" Text="Route requests" />
                                </StackPanel>
                                <views:OptionInfoNote InfoId="quickselect.route_requests"
                                                      StartDismissed="True"
                                                      NoteText="Off: only one model answers at a time. On: a ready local and a ready cloud can both take turns on Port; AI-FluxMux asks before a switch, and **Cloud Usage Mode** sets how often cloud is offered." />
                            </StackPanel>
                            <StackPanel Spacing="2" Margin="0,0,16,4"
                                        IsVisible="{Binding RequestRoutingEnabled}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <CheckBox VerticalAlignment="Center"
                                              IsChecked="{Binding InterventionPopupsEnabled}"
                                              views:MarkedText.Tip="When **Route requests** needs a decision (**Keep current model — end this turn**, **Keep current model — this turn continues**, or **Switch to** the other ready model; **Load suggested model profile**; **Compact**), open a small always-on-top window so it is not hidden behind Harness or another Client app. The same buttons stay on Diagnostics." />
                                    <TextBlock VerticalAlignment="Center" Text="Pop up routing prompts" />
                                </StackPanel>
                                <views:OptionInfoNote InfoId="quickselect.popup_routing"
                                                      StartDismissed="True"
                                                      NoteText="When **Route requests** needs a decision (**Keep current model — end this turn**, **Keep current model — this turn continues**, or **Switch to** the other ready model; **Load suggested model profile**; **Compact**), open a small always-on-top window so it is not hidden behind Harness or another Client app. The same buttons stay on Diagnostics." />
                            </StackPanel>
                            <StackPanel Spacing="2" Margin="0,0,0,4"
                                        IsVisible="{Binding RequestRoutingEnabled}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Cloud Usage Mode" />
                                    <ComboBox MinWidth="160"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              ItemsSource="{Binding CloudRoutingCapacityOptions}"
                                              SelectedItem="{Binding SelectedCloudRoutingCapacity}"
                                              ToolTip.Tip="How freely to spend your cloud subscription. Normal: large or clearly cloud-named requests may go to the ready cloud model. Low: stay on the loaded local unless it is down or the prompt asks for cloud. Hold: stay on the loaded local while it is working (if local is down, cloud can still be used). On Low or Hold, AI-FluxMux may ask before loading a different local model." />
                                </StackPanel>
                                <views:OptionInfoNote InfoId="quickselect.cloud_usage"
                                                      NoteText="Cloud Usage Mode sets how often (or if) routing can direct a selected cloud model to take a chat turn (fast). Prompted local routing (slower) will still apply when cloud is not used." />
                            </StackPanel>
                        </WrapPanel>
                        <views:OptionInfoNote InfoId="quickselect.hot_routing"
                                              NoteText="{Binding RequestRoutingModeText}" />
                        <ItemsControl x:Name="QuickSelectSlotList"
                                      ItemsSource="{Binding QuickSelectSlots}"
                                      views:ReorderMoveAnimation.Enable="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RouteSlotViewModel">
                                    <GroupBox>
                                        <GroupBox.Header>
                                            <DockPanel LastChildFill="True">
                                                <TextBlock Classes="reorderGrip"
                                                           DockPanel.Dock="Left"
                                                           Margin="0,0,8,0"
                                                           Text="⋮⋮"
                                                           ToolTip.Tip="Drag to reorder this Quick Select row."
                                                           PointerPressed="OnQuickSelectSlotGripPressed"
                                                           PointerMoved="OnQuickSelectSlotGripMoved"
                                                           PointerReleased="OnQuickSelectSlotGripReleased"
                                                           PointerCaptureLost="OnQuickSelectSlotGripCaptureLost" />
                                                <TextBlock VerticalAlignment="Center" Text="{Binding DisplayName}" />
                                            </DockPanel>
                                        </GroupBox.Header>
                                        <Border Classes="slotRuntimeChrome"
                                                Classes.activeRuntimeLive="{Binding IsActiveRuntimeLive}"
                                                Classes.activeRuntimeAmber="{Binding IsActiveRuntimeAmber}"
                                                Classes.activeRuntimeFault="{Binding IsActiveRuntimeFault}"
                                                Classes.standbyHotLive="{Binding IsStandbyHotLive}"
                                                Classes.standbyHotAmber="{Binding IsStandbyHotAmber}"
                                                Classes.standbyHotFault="{Binding IsStandbyHotFault}"
                                                CornerRadius="6">
                                        <Grid>
                                        <Border Classes="slotLoadingFill"
                                                IsVisible="{Binding IsLoadingRuntimeSlot}"
                                                Opacity="{Binding LoadingPulseOpacity}"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                CornerRadius="6" />
                                        <Grid Margin="8"
                                              ColumnDefinitions="Auto,*,Auto"
                                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                              ColumnSpacing="10"
                                              RowSpacing="8">
                                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Validated profile" />
                                            <ComboBox Grid.Row="0"
                                                      Grid.Column="1"
                                                      Classes="quickSelectProfile"
                                                      ItemsSource="{Binding AvailableValidatedProfiles}"
                                                      SelectedItem="{Binding SelectedValidatedProfile}"
                                                      PlaceholderText="Choose a validated Model Profiles entry"
                                                      ItemTemplate="{StaticResource ValidatedProfileOptionTemplate}"
                                                      MaxDropDownHeight="480"
                                                      ToolTip.Tip="Only models that passed the 'Validate to endpoint' test on Model Profiles. Scroll if the list is long. ⚠ means this profile is not trusted right now: the last connection failed, settings were saved after the last successful Validate, or a local model is missing from the folder.">
                                                <ComboBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel />
                                                    </ItemsPanelTemplate>
                                                </ComboBox.ItemsPanel>
                                            </ComboBox>
                                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                                <Button Content="Save"
                                                        IsEnabled="{Binding CanSaveSlot}"
                                                        Command="{Binding SaveSlotCommand}"
                                                        ToolTip.Tip="Saves which model this row should Launch. Two rows cannot use the same named profile. Model profile variants of the same local model (temperature, max tokens, Images) can each have their own row." />
                                                <Button Content="Delete Slot" Command="{Binding DeleteSlotCommand}" views:MarkedText.Tip="Removes this shortcut row. The model is not stopped, your saved Model Profiles are not deleted, and the chat in the Client app is not erased. Click **Stop** first if you want to unload this row's model." />
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Spacing="2"
                                                        IsVisible="{Binding ShowActiveRuntimeStatus}">
                                                <TextBlock FontSize="{DynamicResource FluxFontSizeCaption}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding ActiveRuntimeTelemetryBrush}"
                                                           Text="{Binding ActiveRuntimeStatusText}" />
                                                <TextBlock TextWrapping="Wrap"
                                                           FontSize="{DynamicResource FluxFontSizeCaption}"
                                                           Foreground="{Binding ActiveRuntimeTelemetryBrush}"
                                                           Text="{Binding ActiveRuntimeTelemetryText}"
                                                           IsVisible="{Binding ShowActiveRuntimeTelemetry}" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                                       TextWrapping="Wrap" FontSize="{DynamicResource FluxFontSizeCaption}"
                                                       Text="{Binding AttributeSummary}"
                                                       IsVisible="{Binding ShowSlotFacts}" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                                       TextWrapping="Wrap" FontSize="{DynamicResource FluxFontSizeCaption}" Opacity="0.72"
                                                       Text="{Binding ProfileSyncNote}"
                                                       IsVisible="{Binding ShowProfileSyncNote}" />
                                            <TextBlock Grid.Row="4"
                                                       Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       FontSize="{DynamicResource FluxFontSizeCaption}"
                                                       Text="Temperature"
                                                       IsVisible="{Binding ShowRequestOverlay}" />
                                            <WrapPanel Grid.Row="4"
                                                       Grid.Column="1"
                                                       Grid.ColumnSpan="2"
                                                       Orientation="Horizontal"
                                                       IsVisible="{Binding ShowRequestOverlay}">
                                                <NumericUpDown MinWidth="88"
                                                               Margin="0,0,16,4"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Center"
                                                               Minimum="0"
                                                               Maximum="2"
                                                               Increment="0.05"
                                                               Value="{Binding RequestTemperature}"
                                                               ToolTip.Tip="How mixed the wording is. Lower is more repeatable. Higher is more varied. Applies on the next Client-app message while this row is loaded." />
                                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,4">
                                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Max tokens" />
                                                    <ComboBox MinWidth="96"
                                                              HorizontalAlignment="Left"
                                                              VerticalAlignment="Center"
                                                              ItemsSource="{Binding RequestMaxTokenOptions}"
                                                              SelectedItem="{Binding RequestMaxTokens}"
                                                              ToolTip.Tip="How long one answer can be. Applies on the next Client-app message while this row is loaded." />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeCaption}" Text="Reasoning" />
                                                    <ComboBox MinWidth="96"
                                                              HorizontalAlignment="Left"
                                                              VerticalAlignment="Center"
                                                              ItemsSource="{Binding RequestReasoningOptions}"
                                                              SelectedItem="{Binding RequestReasoning}"
                                                              views:MarkedText.Tip="How much the local model thinks before it answers. **Off** is what a Client-app tool loop wants — the next message can run a test or command instead of spending Max tokens on a think. **Low**, **Medium**, and **XHigh** turn thinking on for this row. **XHigh** can use the whole reply budget before any tool call." />
                                                </StackPanel>
                                            </WrapPanel>
                                            <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasSavedAssignment}">
                                                        <Button Content="Launch" Command="{Binding LaunchCommand}" IsEnabled="{Binding CanLaunchSavedAssignment}" views:MarkedText.Tip="Starts this row's saved model. If you changed the dropdown, click **Save** first. If ⚠ is showing, run **Validate to endpoint** on Model Profiles first." />
                                                        <Button Content="Restart" Command="{Binding RestartCommand}" IsEnabled="{Binding CanLaunchSavedAssignment}" views:MarkedText.Tip="Loads this row's model again. If ⚠ is showing, run **Validate to endpoint** on Model Profiles first. Local: you wait, and the new load starts without the in-memory reading of this chat, so it may grasp less of what you already discussed (the Client app still has the messages and will usually send them again). Cloud: reconnects to the provider; the Client app's chat is unchanged." />
                                                        <Button Content="Stop" Command="{Binding StopCommand}" ToolTip.Tip="Stops this row's running model. Local: frees graphics memory and drops the in-memory reading of this chat. Cloud: disconnects that cloud model. The chat stays in the Client app; AI-FluxMux does not store that conversation." />
                                                    </StackPanel>
                                                    <Border IsVisible="{Binding IsStandbyHotSlot}"
                                                            Background="{DynamicResource FluxQuickSelectStandbyBackground}"
                                                            BorderBrush="{DynamicResource FluxQuickSelectStandbyBorder}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="8,4"
                                                            VerticalAlignment="Center"
                                                            ToolTip.Tip="This model is launched and ready.">
                                                        <TextBlock FontSize="{DynamicResource FluxFontSizeCaption}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding ActiveRuntimeTelemetryBrush}"
                                                                   Text="{Binding ActiveRuntimeStatusText}" />
                                                    </Border>
                                                    <Border IsVisible="{Binding ShowHarnessOperationalControls}"
                                                            Background="{DynamicResource FluxTintPurpleBackground}"
                                                            BorderBrush="{DynamicResource FluxTintPurpleBorder}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="8,4"
                                                            VerticalAlignment="Center"
                                                            ToolTip.Tip="Experimental. Starts or opens DeepSeek Harness web chat for the active slot after Launch. Does not replace Launch — the local model must be running first.">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock VerticalAlignment="Center"
                                                                       FontSize="{DynamicResource FluxFontSizeCaption}"
                                                                       FontWeight="SemiBold"
                                                                       Opacity="0.88"
                                                                       Text="DeepSeek Harness launcher (experimental)" />
                                                            <Button Content="{Binding ElementName=RootWindow, Path=DataContext.HarnessWebChatButtonText}"
                                                                    Command="{Binding ElementName=RootWindow, Path=DataContext.StartHarnessWebCommand}"
                                                                    ToolTip.Tip="{Binding ElementName=RootWindow, Path=DataContext.HarnessWebChatButtonTooltip}" />
                                                            <Button Content="Stop Harness web"
                                                                    Command="{Binding ElementName=RootWindow, Path=DataContext.StopHarnessWebCommand}"
                                                                    ToolTip.Tip="{Binding ElementName=RootWindow, Path=DataContext.HarnessStopButtonTooltip}" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock TextWrapping="Wrap"
                                                           FontSize="{DynamicResource FluxFontSizeCaption}"
                                                           Opacity="0.82"
                                                           Text="{Binding ElementName=RootWindow, Path=DataContext.HarnessStopUnavailableHint}"
                                                           IsVisible="{Binding ElementName=RootWindow, Path=DataContext.ShowHarnessStopUnavailableHint}" />
                                            </StackPanel>
                                        </Grid>
                                        </Grid>
                                        </Border>
                                    </GroupBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Spacing="4" IsVisible="{Binding ShowQuickSelectSlotAddButton}">
                            <Button HorizontalAlignment="Left"
                                    IsEnabled="{Binding CanAddQuickSelectSlots}"
                                    Content="Add New Slot"
                                    Command="{Binding AddQuickSelectSlotCommand}"
                                    ToolTip.Tip="{Binding QuickSelectSlotAddButtonTooltip}" />
                            <TextBlock FontSize="{DynamicResource FluxFontSizeCaption}"
                                       Opacity="0.75"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding ShowQuickSelectSlotAddBlockedText}"
                                       Text="{Binding QuickSelectSlotAddBlockedText}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Servers" ToolTip.Tip="The port the Client app connects to, where local models live, which program runs them, and cloud API keys.">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10" Margin="0,8,0,8">
                        <GroupBox Header="Shared Connection Settings (Global)">
                            <StackPanel Margin="8" Spacing="10">
                                <Border Background="{DynamicResource FluxServersTintOrangeBackground}" BorderBrush="{DynamicResource FluxServersTintOrangeBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel Spacing="8">
                                        <TextBlock FontWeight="SemiBold" Text="Endpoint settings" />
                                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Port" />
                                            <NumericUpDown Grid.Column="1" MinWidth="120" Value="{Binding OrchestratorPort}" Minimum="1" Maximum="65534" ToolTip.Tip="The address your Client app connects to. llama-server listens privately on the next port up (the daemon port); never point a Client app there." />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Client app" />
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding EndpointAppOptions}"
                                                      SelectedItem="{Binding SelectedEndpointApp}"
                                                      ToolTip.Tip="Extra setup notes only. Cline, Harness, and other OpenAI Compatible clients can all use the same Port at once — you do not nominate who is talking. Routing dialogs always cover both Cline and Harness. DeepSeek Harness adds a launcher on Quick Select and a web UI port below." />
                                            <TextBlock Grid.Column="2"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       FontSize="{DynamicResource FluxFontSizeCaption}"
                                                       Opacity="0.85"
                                                       Text="{Binding EndpointModelAddressText}" />
                                        </Grid>
                                        <views:OptionInfoNote InfoId="servers.endpoint_intro"
                                                              NoteText="{Binding EndpointSettingsIntroText}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Export Endpoint adapters"
                                                    Command="{Binding ExportEndpointAdaptersCommand}"
                                                    ToolTip.Tip="Save Port, Client app and Harness settings to a file you keep, so a reinstall or a bad hand-edit is easy to undo. No API keys or model profiles." />
                                            <Button Content="Import Endpoint adapters"
                                                    Command="{Binding ImportEndpointAdaptersCommand}"
                                                    ToolTip.Tip="Restore those settings from a file you exported. AI-FluxMux backs up its current settings first. Cloud keys and model profiles are not touched." />
                                        </StackPanel>
                                        <Border IsVisible="{Binding ShowClineEndpointHint}"
                                                Background="{DynamicResource FluxMutedBackground}"
                                                BorderBrush="{DynamicResource FluxMutedBorder}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10">
                                            <StackPanel Spacing="8">
                                                <TextBlock FontWeight="SemiBold" Text="Cline (VS Code)" />
                                                <TextBlock TextWrapping="Wrap" Opacity="0.88" Text="{Binding ClineSettingsStatusText}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Content="Install guide (Cline)"
                                                            Command="{Binding OpenExternalLinkCommand}"
                                                            CommandParameter="https://marketplace.visualstudio.com/items?itemName=saoudrizwan.claude-dev"
                                                            ToolTip.Tip="Cline on the Visual Studio Marketplace. Install it from the Extensions panel of VS Code. AI-FluxMux does not install Cline." />
                                                    <Button Content="Cline docs"
                                                            Command="{Binding OpenExternalLinkCommand}"
                                                            CommandParameter="https://docs.cline.bot/"
                                                            ToolTip.Tip="Official Cline documentation." />
                                                    <Button Content="Open Cline releases"
                                                            Command="{Binding OpenExternalLinkCommand}"
                                                            CommandParameter="https://github.com/cline/cline/releases"
                                                            ToolTip.Tip="GitHub releases for Cline. AI-FluxMux does not install or upgrade Cline." />
                                                </StackPanel>
                                                <views:OptionInfoNote InfoId="servers.cline_hint"
                                                                      NoteText="{Binding ClineEndpointHintText}" />
                                            </StackPanel>
                                        </Border>
                                        <Border IsVisible="{Binding ShowGenericEndpointHint}"
                                                Background="{DynamicResource FluxMutedBackground}"
                                                BorderBrush="{DynamicResource FluxMutedBorder}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8">
                                            <views:OptionInfoNote InfoId="servers.generic_hint"
                                                                  NoteText="{Binding GenericEndpointHintText}" />
                                        </Border>
                                        <Border IsVisible="{Binding ShowHarnessServersPanel}"
                                                Background="{DynamicResource FluxServersTintPurpleBackground}"
                                                BorderBrush="{DynamicResource FluxServersTintPurpleBorder}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10">
                                            <StackPanel Spacing="8">
                                                <TextBlock FontWeight="SemiBold" Text="DeepSeek Harness (experimental)" />
                                                <TextBlock TextWrapping="Wrap" Opacity="0.88" Text="{Binding HarnessInstalledVersionText}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Content="Install guide (DeepSeek)"
                                                            Command="{Binding OpenExternalLinkCommand}"
                                                            CommandParameter="https://github.com/deepseek-ai/deepseek-harness#run-from-npm"
                                                            ToolTip.Tip="DeepSeek Harness install (Node.js, npx @deepseek-ai/dsh, or build from source)." />
                                                    <Button Content="Harness docs"
                                                            Command="{Binding OpenExternalLinkCommand}"
                                                            CommandParameter="https://deepseek-harness.github.io/deepseek-harness/"
                                                            ToolTip.Tip="Official DeepSeek Harness documentation." />
                                                    <Button Content="Open Harness releases"
                                                            Command="{Binding OpenHarnessReleasesCommand}"
                                                            ToolTip.Tip="GitHub releases for DeepSeek Harness. To install or update dsh, use 'Update now' in the AI-FluxMux updates panel — it backs up your config and updates dsh via npm." />
                                                </StackPanel>
                                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Harness web UI port" />
                                                    <NumericUpDown Grid.Column="1"
                                                                   MinWidth="120"
                                                                   Value="{Binding HarnessWebPort}"
                                                                   Minimum="1"
                                                                   Maximum="65534"
                                                                   ToolTip.Tip="Browser chat address bookmark. Default 3080. AI-FluxMux does not listen on this port." />
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Content="Copy settings.yaml"
                                                            Command="{Binding CopyHarnessSettingsYamlCommand}"
                                                            ToolTip.Tip="Copies a freshly generated FluxMux provider block for the loaded profile to the clipboard (not a copy of the on-disk file)." />
                                                    <Button Content="Write settings.yaml"
                                                            Command="{Binding WriteHarnessSettingsYamlCommand}"
                                                            ToolTip.Tip="Merges a freshly generated FluxMux provider block into %USERPROFILE%\.dsh\settings.yaml — same path as automatic sync; use to retry." />
                                                </StackPanel>
                                                <views:OptionInfoNote InfoId="servers.harness_summary"
                                                                      NoteText="{Binding HarnessServersSummaryText}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource FluxServersTintGreenBackground}" BorderBrush="{DynamicResource FluxServersTintGreenBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel Spacing="8">
                                        <TextBlock FontWeight="SemiBold" Text="Local model server" />
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Model Directory" />
                                            <TextBox Grid.Column="1" Text="{Binding LocalModelDirectory}" ToolTip.Tip="Put your local models here. Every local shortcut uses this same folder." />
                                            <Button Grid.Column="2" Content="Browse" Command="{Binding BrowseModelDirectoryCommand}" ToolTip.Tip="Choose the folder that holds your local models." />
                                        </Grid>
                                        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FluxFontSizeCaption}" Opacity="0.78" Text="{Binding LocalModelDiscoveryText}" />
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="llama-server installation" />
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding InstalledLocalServerOptions}"
                                                      SelectedItem="{Binding SelectedInstalledLocalServer}"
                                                      PlaceholderText="No llama-server installation found"
                                                      ToolTip.Tip="The program AI-FluxMux starts and stops to run local models. Pick a detected install, or Browse if yours is not listed." />
                                            <Button Grid.Column="2"
                                                    Content="Browse"
                                                    Command="{Binding BrowseLocalServerExecutableCommand}"
                                                    ToolTip.Tip="Point to a llama-server.exe AI-FluxMux did not find automatically (for example a portable copy)." />
                                        </Grid>
                                        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FluxFontSizeCaption}" Opacity="0.78" Text="{Binding LocalServerInstallationText}" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Content="Test Server Readiness"
                                                    Command="{Binding TestLocalServerReadinessCommand}"
                                                    ToolTip.Tip="Checks that llama-server is installed, the model folder exists, and the ports from Endpoint settings are free. Does not start a local model." />
                                        </StackPanel>
                                        <!-- One full-width expander, like a model profile: the Port rules tick box sits in
                                             its header, so the settings get the whole width instead of the space beside a
                                             left-hand tick-box column (which squeezed and clipped the fields, 25 Nov). -->
                                        <Expander Classes="fieldHeight"
                                                  HorizontalAlignment="Stretch"
                                                  IsExpanded="False"
                                                  ToolTip.Tip="How a local Client-app chat is sent on to llama-server: Compact when Context fills, optionally pause a tool loop or hang, and retry a load. One checkbox turns off the outlined group it sits in. Cloud models do not use these.">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <CheckBox VerticalAlignment="Center"
                                                              Content="Port rules"
                                                              IsChecked="{Binding PortRules.Enabled}"
                                                              ToolTip.Tip="Detailed control over how a local Client-app chat is sent on to llama-server, affecting management of context compaction, tool loops and hangs. Uncheck for default settings (recommended). Cloud models do not use these rules." />
                                                    <TextBlock VerticalAlignment="Center" Opacity="0.75" Text="Advanced settings" />
                                                    <!-- Auto steer works whether Port rules are on or off, so it sits beside their
                                                         tick box rather than inside the group they switch off (28 Nov). -->
                                                    <CheckBox VerticalAlignment="Center"
                                                              Content="Auto steer"
                                                              IsChecked="{Binding PortRules.AutoSteerEnabled}"
                                                              ToolTip.Tip="When the model in the Client app loops or keeps failing, AI-FluxMux adds a note to its next request saying what it saw and what to do instead: a failed call's likely fix (too large, text not found, path not found, too slow...), a command that keeps repeating, or a long run of tool calls since your last message, where it asks the model to stop and report to you. Port rules pause the turn only if that does not work. Works with Port rules on or off; the notes carry only what AI-FluxMux observed." />
                                                </StackPanel>
                                            </Expander.Header>
                                            <Expander.Resources>
                                                <x:Double x:Key="ExpanderMinHeight">32</x:Double>
                                                <Thickness x:Key="ExpanderHeaderPadding">8,0,0,0</Thickness>
                                                <Thickness x:Key="ExpanderChevronMargin">8,0,8,0</Thickness>
                                            </Expander.Resources>
                                            <!-- Shared-size scope: every Compact / Omit / Hang label takes the width of the
                                                 longest one and every field the width of the widest, so the pairs line up and
                                                 follow the text size instead of a fixed pixel width. -->
                                            <StackPanel Spacing="10" Margin="0,8,0,0"
                                                        Grid.IsSharedSizeScope="True"
                                                        IsEnabled="{Binding PortRules.Enabled}">
                                                <TextBlock TextWrapping="Wrap"
                                                           FontSize="{DynamicResource FluxFontSizeCaption}"
                                                           Opacity="0.85">
                                                    <Run Text="One checkbox turns off the outlined group it sits in. Compact, omit, and Max pictures only change the pack forwarded to llama-server. The Client app still has the full chat. Client-app max tokens and Stop strings are a choice, not on/off. " /><views:HelpTopicLink TopicId="{x:Static svc:HelpTopicIds.PortRules}"
                                                                                   ToolTip.Tip="Open the Port rules Help topic." />
                                                </TextBlock>
                                                <StackPanel.Styles>
                                                    <Style Selector="NumericUpDown">
                                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                    </Style>
                                                    <Style Selector="ComboBox">
                                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                    </Style>
                                                    <Style Selector="Border.portRuleGroup">
                                                        <Setter Property="Background" Value="{DynamicResource FluxMutedBackground}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource FluxMutedBorder}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Setter Property="CornerRadius" Value="4" />
                                                        <Setter Property="Padding" Value="8" />
                                                    </Style>
                                                </StackPanel.Styles>
                                                <Border Classes="portRuleGroup">
                                                    <StackPanel Spacing="8">
                                                        <DockPanel>
                                                            <views:HelpTopicLink DockPanel.Dock="Right"
                                                                                 TopicId="{x:Static svc:HelpTopicIds.PortRules}"
                                                                                 ToolTip.Tip="Open the Port rules Help topic." />
                                                            <CheckBox FontWeight="SemiBold"
                                                                      Content="Compact"
                                                                      IsChecked="{Binding PortRules.CompactEnabled}"
                                                                      IsEnabled="{Binding CompactionControlsEnabled}"
                                                                      ToolTip.Tip="When off, AI-FluxMux does not shorten older turns forwarded to llama-server. The Client app still has the full chat." />
                                                        </DockPanel>
                                                        <WrapPanel IsEnabled="{Binding PortRules.CompactEnabled}">
                                                            <Grid ColumnSpacing="8" Margin="0,0,20,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleLabel" />
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleField" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock VerticalAlignment="Center" Text="Watermark %" ToolTip.Tip="Compact when the forwarded prompt reaches this percent of Context, or when Context is already filling." TextWrapping="Wrap" />
                                                                <NumericUpDown Grid.Column="1" Minimum="50" Maximum="95" Value="{Binding PortRules.CompactWatermarkPercent}" ToolTip.Tip="Compact when the forwarded prompt reaches this percent of Context, or when Context is already filling." />
                                                            </Grid>
                                                            <Grid ColumnSpacing="8" Margin="0,0,20,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleLabel" />
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleField" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock VerticalAlignment="Center" Text="Keep turns" ToolTip.Tip="The fewest recent messages left intact when Compact shortens older history. It keeps as many more as fit, leaving the Context about 20 points below the Watermark." TextWrapping="Wrap" />
                                                                <NumericUpDown Grid.Column="1" Minimum="4" Maximum="24" Value="{Binding PortRules.CompactKeepTurns}" ToolTip.Tip="The fewest recent messages left intact when Compact shortens older history. It keeps as many more as fit, leaving the Context about 20 points below the Watermark." />
                                                            </Grid>
                                                            <Grid ColumnSpacing="8" Margin="0,0,20,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleLabel" />
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleField" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock VerticalAlignment="Center" Text="Tool keep turns" ToolTip.Tip="When the chat has tools, Compact keeps at least this many recent turns." TextWrapping="Wrap" />
                                                                <NumericUpDown Grid.Column="1" Minimum="6" Maximum="32" Value="{Binding PortRules.CompactToolKeepTurns}" ToolTip.Tip="When the chat has tools, Compact keeps at least this many recent turns." />
                                                            </Grid>
                                                            <Grid ColumnSpacing="8" Margin="0,0,20,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleLabel" />
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleField" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock VerticalAlignment="Center" Text="Headroom" ToolTip.Tip="Tokens reserved so prompt plus reply still fit Context after Compact or a max-tokens clamp." TextWrapping="Wrap" />
                                                                <NumericUpDown Grid.Column="1" Minimum="64" Maximum="4096" Value="{Binding PortRules.CompactHeadroom}" ToolTip.Tip="Tokens reserved so prompt plus reply still fit Context after Compact or a max-tokens clamp." />
                                                            </Grid>
                                                            <Grid ColumnSpacing="8" Margin="0,0,20,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleLabel" />
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleField" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock VerticalAlignment="Center" Text="Preserved user chars" ToolTip.Tip="How much of an older user task Compact may pin when that turn would otherwise drop." TextWrapping="Wrap" />
                                                                <NumericUpDown Grid.Column="1" Minimum="500" Maximum="20000" Value="{Binding PortRules.CompactPreservedUserChars}" ToolTip.Tip="How much of an older user task Compact may pin when that turn would otherwise drop." />
                                                            </Grid>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>

                                                <Border Classes="portRuleGroup">
                                                    <StackPanel Spacing="8">
                                                        <DockPanel>
                                                            <views:HelpTopicLink DockPanel.Dock="Right"
                                                                                 TopicId="{x:Static svc:HelpTopicIds.PortRules}"
                                                                                 ToolTip.Tip="Open the Port rules Help topic." />
                                                            <CheckBox FontWeight="SemiBold"
                                                                      Content="Omit"
                                                                      IsChecked="{Binding PortRules.OmitEnabled}"
                                                                      ToolTip.Tip="Off: older tool output is still sent to the model in full. On: older tool output is shortened so Context lasts longer. The Client app always keeps the full output." />
                                                        </DockPanel>
                                                        <WrapPanel IsEnabled="{Binding PortRules.OmitEnabled}">
                                                            <Grid ColumnSpacing="8" Margin="0,0,20,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleLabel" />
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleField" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock VerticalAlignment="Center" Text="Keep recent results" ToolTip.Tip="How many recent tool results are sent in full. Older ones are shortened to a note that the tool ran." TextWrapping="Wrap" />
                                                                <NumericUpDown Grid.Column="1" Minimum="4" Maximum="64" Value="{Binding PortRules.KeepRecentResults}" ToolTip.Tip="How many recent tool results are sent in full. Older ones are shortened to a note that the tool ran." />
                                                            </Grid>
                                                            <Grid ColumnSpacing="8" Margin="0,0,20,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleLabel" />
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleField" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock VerticalAlignment="Center" Text="Pin latest shell" ToolTip.Tip="Recent shell output is always sent in full, even while older tool output is being shortened." TextWrapping="Wrap" />
                                                                <NumericUpDown Grid.Column="1" Minimum="1" Maximum="16" Value="{Binding PortRules.PinLatestShellResults}" ToolTip.Tip="Recent shell output is always sent in full, even while older tool output is being shortened." />
                                                            </Grid>
                                                            <Grid ColumnSpacing="8" Margin="0,0,20,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleLabel" />
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleField" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock VerticalAlignment="Center" Text="Min chars to omit" ToolTip.Tip="Tool output shorter than this is always sent in full." TextWrapping="Wrap" />
                                                                <NumericUpDown Grid.Column="1" Minimum="80" Maximum="2000" Value="{Binding PortRules.MinResultCharsToClear}" ToolTip.Tip="Tool output shorter than this is always sent in full." />
                                                            </Grid>
                                                            <Grid ColumnSpacing="8" Margin="0,0,20,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleLabel" />
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleField" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock VerticalAlignment="Center" Text="Tool result clearing" ToolTip.Tip="On: older tool results are shortened to keep Context small, and a result identical to one still shown in full (a file read again unchanged) becomes a short pointer to it. Off: all tool results are kept in full, which fills Context faster." TextWrapping="Wrap" />
                                                                <CheckBox Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" IsChecked="{Binding PortRules.ToolResultClearingEnabled}" ToolTip.Tip="On: older tool results are shortened to keep Context small, and a result identical to one still shown in full (a file read again unchanged) becomes a short pointer to it. Off: all tool results are kept in full, which fills Context faster." />
                                                            </Grid>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>

                                                <Grid ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Row="0" Grid.Column="0" Classes="portRuleGroup">
                                                        <StackPanel Spacing="4">
                                                            <DockPanel>
                                                                <views:HelpTopicLink DockPanel.Dock="Right"
                                                                                     TopicId="{x:Static svc:HelpTopicIds.PortRules}"
                                                                                     ToolTip.Tip="Open the Port rules Help topic." />
                                                                <CheckBox VerticalAlignment="Center" Content="Mill check"
                                                                          IsChecked="{Binding PortRules.MillAtOmittedEnabled}"
                                                                          ToolTip.Tip="Once the model has run this many tools since your last message, AI-FluxMux looks at the most recent ones (Closed-loop lookback) and ends the turn if they no longer look like reading, editing, searching or testing the project. Stops a runaway tool loop." />
                                                            </DockPanel>
                                                                <Grid HorizontalAlignment="Left">
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleField" /></Grid.ColumnDefinitions>
                                                                    <NumericUpDown Minimum="8" Maximum="128" IsEnabled="{Binding PortRules.MillAtOmittedEnabled}" Value="{Binding PortRules.RunawayOmittedResults}" ToolTip.Tip="Once the model has run this many tools since your last message, AI-FluxMux looks at the most recent ones (Closed-loop lookback) and ends the turn if they no longer look like reading, editing, searching or testing the project. Stops a runaway tool loop." />
                                                                </Grid>
                                                            <TextBlock FontSize="{DynamicResource FluxFontSizeCaption}" Opacity="0.75"
                                                                       IsVisible="{Binding PortRules.MillCheckTally, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                                                       Text="{Binding PortRules.MillCheckTally}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Row="0" Grid.Column="1" Classes="portRuleGroup">
                                                        <StackPanel Spacing="4">
                                                        <DockPanel>
                                                            <views:HelpTopicLink DockPanel.Dock="Right"
                                                                                 TopicId="{x:Static svc:HelpTopicIds.PortRules}"
                                                                                 ToolTip.Tip="Open the Port rules Help topic." />
                                                            <CheckBox VerticalAlignment="Center" Content="Closed-loop lookback"
                                                                      IsChecked="{Binding PortRules.ClosedLoopLookbackEnabled}"
                                                                      ToolTip.Tip="How many recent tool calls AI-FluxMux checks to tell real progress from going round in circles. Off: Mill check ends the turn at its count without that check." />
                                                        </DockPanel>
                                                            <Grid HorizontalAlignment="Left">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleField" /></Grid.ColumnDefinitions>
                                                                <NumericUpDown Minimum="2" Maximum="16" IsEnabled="{Binding PortRules.ClosedLoopLookbackEnabled}" Value="{Binding PortRules.ClosedLoopMillLookback}" ToolTip.Tip="How many recent tool calls AI-FluxMux checks to tell real progress from going round in circles. Off: Mill check ends the turn at its count without that check." />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Row="0" Grid.Column="2" Classes="portRuleGroup">
                                                        <StackPanel Spacing="4">
                                                            <DockPanel>
                                                                <views:HelpTopicLink DockPanel.Dock="Right"
                                                                                     TopicId="{x:Static svc:HelpTopicIds.PortRules}"
                                                                                     ToolTip.Tip="Open the Port rules Help topic." />
                                                                <CheckBox VerticalAlignment="Center" Content="Closed-loop mill ceiling"
                                                                          IsChecked="{Binding PortRules.ClosedLoopCeilingEnabled}"
                                                                          ToolTip.Tip="Last-resort stop once the model has run this many tools since your last message without stopping, even if the recent tools still look useful. Counts this Client-app turn only, so a long chat never reaches it just by being long." />
                                                            </DockPanel>
                                                                <Grid HorizontalAlignment="Left">
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleField" /></Grid.ColumnDefinitions>
                                                                    <NumericUpDown Minimum="32" Maximum="512" IsEnabled="{Binding PortRules.ClosedLoopCeilingEnabled}" Value="{Binding PortRules.ClosedLoopRunawayOmittedResults}" ToolTip.Tip="Last-resort stop once the model has run this many tools since your last message without stopping, even if the recent tools still look useful. Counts this Client-app turn only, so a long chat never reaches it just by being long." />
                                                                </Grid>
                                                            <TextBlock FontSize="{DynamicResource FluxFontSizeCaption}" Opacity="0.75"
                                                                       IsVisible="{Binding PortRules.ClosedLoopCeilingTally, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                                                       Text="{Binding PortRules.ClosedLoopCeilingTally}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Row="1" Grid.Column="0" Classes="portRuleGroup">
                                                        <StackPanel Spacing="4">
                                                            <DockPanel>
                                                                <views:HelpTopicLink DockPanel.Dock="Right"
                                                                                     TopicId="{x:Static svc:HelpTopicIds.PortRules}"
                                                                                     ToolTip.Tip="Open the Port rules Help topic." />
                                                                <CheckBox VerticalAlignment="Center" Content="Observe-only mill"
                                                                          IsChecked="{Binding PortRules.ObserveOnlyMillEnabled}"
                                                                          ToolTip.Tip="Ends this Client-app turn when this many recent tool calls only look around (screenshots, scripts, runs) without editing any file, even before Mill check is reached." />
                                                            </DockPanel>
                                                                <Grid HorizontalAlignment="Left">
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleField" /></Grid.ColumnDefinitions>
                                                                    <NumericUpDown Minimum="4" Maximum="24" IsEnabled="{Binding PortRules.ObserveOnlyMillEnabled}" Value="{Binding PortRules.ObserveOnlyMillCount}" ToolTip.Tip="Ends this Client-app turn when this many recent tool calls only look around (screenshots, scripts, runs) without editing any file, even before Mill check is reached." />
                                                                </Grid>
                                                            <TextBlock FontSize="{DynamicResource FluxFontSizeCaption}" Opacity="0.75"
                                                                       IsVisible="{Binding PortRules.ObserveOnlyTally, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                                                       Text="{Binding PortRules.ObserveOnlyTally}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Row="2" Grid.Column="0" Classes="portRuleGroup">
                                                        <StackPanel Spacing="4">
                                                            <DockPanel>
                                                                <views:HelpTopicLink DockPanel.Dock="Right"
                                                                                     TopicId="{x:Static svc:HelpTopicIds.PortRules}"
                                                                                     ToolTip.Tip="Open the Port rules Help topic." />
                                                                <CheckBox VerticalAlignment="Center" Content="Max pictures"
                                                                          IsChecked="{Binding PortRules.MaxPicturesEnabled}"
                                                                          ToolTip.Tip="Only the newest pictures, up to this many, are sent to the model; older ones are dropped. The Client app keeps them all." />
                                                            </DockPanel>
                                                                <Grid HorizontalAlignment="Left">
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleField" /></Grid.ColumnDefinitions>
                                                                    <NumericUpDown Minimum="1" Maximum="8" IsEnabled="{Binding PortRules.MaxPicturesEnabled}" Value="{Binding PortRules.MaxForwardedImages}" ToolTip.Tip="Only the newest pictures, up to this many, are sent to the model; older ones are dropped. The Client app keeps them all." />
                                                                </Grid>
                                                            <TextBlock FontSize="{DynamicResource FluxFontSizeCaption}" Opacity="0.75"
                                                                       IsVisible="{Binding PortRules.MaxPicturesTally, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                                                       Text="{Binding PortRules.MaxPicturesTally}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Row="1" Grid.Column="1" Classes="portRuleGroup">
                                                        <StackPanel Spacing="4">
                                                            <DockPanel>
                                                                <views:HelpTopicLink DockPanel.Dock="Right"
                                                                                     TopicId="{x:Static svc:HelpTopicIds.PortRules}"
                                                                                     ToolTip.Tip="Open the Port rules Help topic." />
                                                                <CheckBox VerticalAlignment="Center" Content="Repeated command"
                                                                          IsChecked="{Binding PortRules.RepeatedCommandEnabled}"
                                                                          ToolTip.Tip="When the model runs the same command twice in a row, AI-FluxMux first tells it the result will not change and to try something different. Only if it runs it a third time is this Client-app turn paused for you." />
                                                            </DockPanel>
                                                            <TextBlock FontSize="{DynamicResource FluxFontSizeCaption}" Opacity="0.75"
                                                                       IsVisible="{Binding PortRules.RepeatedCommandTally, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                                                       Text="{Binding PortRules.RepeatedCommandTally}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Row="1" Grid.Column="2" Classes="portRuleGroup">
                                                        <StackPanel Spacing="4">
                                                            <DockPanel>
                                                                <views:HelpTopicLink DockPanel.Dock="Right"
                                                                                     TopicId="{x:Static svc:HelpTopicIds.PortRules}"
                                                                                     ToolTip.Tip="Open the Port rules Help topic." />
                                                                <CheckBox VerticalAlignment="Center" Content="Diagnostic dump"
                                                                          IsChecked="{Binding PortRules.DiagnosticDumpEnabled}"
                                                                          ToolTip.Tip="End this Client-app turn when the Client app dumps a large diagnostic artifact instead of editing a project file." />
                                                            </DockPanel>
                                                            <TextBlock FontSize="{DynamicResource FluxFontSizeCaption}" Opacity="0.75"
                                                                       IsVisible="{Binding PortRules.DumpTally, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                                                       Text="{Binding PortRules.DumpTally}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>

                                                <Border Classes="portRuleGroup">
                                                    <StackPanel Spacing="8">
                                                        <DockPanel>
                                                            <views:HelpTopicLink DockPanel.Dock="Right"
                                                                                 TopicId="{x:Static svc:HelpTopicIds.PortRules}"
                                                                                 ToolTip.Tip="Open the Port rules Help topic." />
                                                            <CheckBox FontWeight="SemiBold"
                                                                      Content="Hang"
                                                                      IsChecked="{Binding PortRules.HangEnabled}"
                                                                      ToolTip.Tip="When off, AI-FluxMux does not open the hang prompt or abort a quiet llama-server stream." />
                                                        </DockPanel>
                                                        <TextBlock FontSize="{DynamicResource FluxFontSizeCaption}" Opacity="0.75"
                                                                   IsVisible="{Binding PortRules.HangTally, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                                                   Text="{Binding PortRules.HangTally}" />
                                                        <WrapPanel IsEnabled="{Binding PortRules.HangEnabled}">
                                                            <Grid ColumnSpacing="8" Margin="0,0,20,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleLabel" />
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleField" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock VerticalAlignment="Center" Text="First-byte seconds" ToolTip.Tip="Open the hang prompt if llama-server sends nothing for this long (non-thinking turns)." TextWrapping="Wrap" />
                                                                <NumericUpDown Grid.Column="1" Minimum="5" Maximum="120" Value="{Binding PortRules.FirstByteSeconds}" ToolTip.Tip="Open the hang prompt if llama-server sends nothing for this long (non-thinking turns)." />
                                                            </Grid>
                                                            <Grid ColumnSpacing="8" Margin="0,0,20,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleLabel" />
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleField" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock VerticalAlignment="Center" Text="Think tokens / sec" ToolTip.Tip="Roughly how fast this model thinks. AI-FluxMux uses it to wait out the thinking budget before asking whether the model has hung." TextWrapping="Wrap" />
                                                                <NumericUpDown Grid.Column="1" Minimum="5" Maximum="80" Value="{Binding PortRules.ThinkTokensPerSecond}" ToolTip.Tip="Roughly how fast this model thinks. AI-FluxMux uses it to wait out the thinking budget before asking whether the model has hung." />
                                                            </Grid>
                                                            <Grid ColumnSpacing="8" Margin="0,0,20,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleLabel" />
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleField" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock VerticalAlignment="Center" Text="Max think first-byte" ToolTip.Tip="Cap on how long a thinking model may sit before the hang prompt." TextWrapping="Wrap" />
                                                                <NumericUpDown Grid.Column="1" Minimum="30" Maximum="300" Value="{Binding PortRules.MaxThinkFirstByteSeconds}" ToolTip.Tip="Cap on how long a thinking model may sit before the hang prompt." />
                                                            </Grid>
                                                            <Grid ColumnSpacing="8" Margin="0,0,20,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleLabel" />
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleField" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock VerticalAlignment="Center" Text="Stall seconds" ToolTip.Tip="Open the hang prompt if llama-server goes silent mid-stream for this long." TextWrapping="Wrap" />
                                                                <NumericUpDown Grid.Column="1" Minimum="10" Maximum="180" Value="{Binding PortRules.StallSeconds}" ToolTip.Tip="Open the hang prompt if llama-server goes silent mid-stream for this long." />
                                                            </Grid>
                                                            <Grid ColumnSpacing="8" Margin="0,0,20,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleLabel" />
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleField" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock VerticalAlignment="Center" Text="Wait-longer seconds" ToolTip.Tip="Extra quiet time if you choose to keep this turn open." TextWrapping="Wrap" />
                                                                <NumericUpDown Grid.Column="1" Minimum="15" Maximum="180" Value="{Binding PortRules.WaitLongerSeconds}" ToolTip.Tip="Extra quiet time if you choose to keep this turn open." />
                                                            </Grid>
                                                            <Grid ColumnSpacing="8" Margin="0,0,20,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleLabel" />
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PortRuleField" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock VerticalAlignment="Center" Text="Decision seconds" ToolTip.Tip="How long the hang prompt waits for a choice before ending the turn." TextWrapping="Wrap" />
                                                                <NumericUpDown Grid.Column="1" Minimum="10" Maximum="120" Value="{Binding PortRules.DecisionSeconds}" ToolTip.Tip="How long the hang prompt waits for a choice before ending the turn." />
                                                            </Grid>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>

                                                <Border Classes="portRuleGroup">
                                                    <StackPanel Spacing="8">
                                                        <DockPanel>
                                                            <views:HelpTopicLink DockPanel.Dock="Right"
                                                                                 TopicId="{x:Static svc:HelpTopicIds.PortRules}"
                                                                                 ToolTip.Tip="Open the Port rules Help topic." />
                                                            <CheckBox FontWeight="SemiBold"
                                                                      Content="503"
                                                                      IsChecked="{Binding PortRules.Loading503Enabled}"
                                                                      ToolTip.Tip="Keep retrying while llama-server is still loading the model, so the Client app does not give up on Port during a slow start." />
                                                        </DockPanel>
                                                        <TextBlock FontSize="{DynamicResource FluxFontSizeCaption}" Opacity="0.75"
                                                                   IsVisible="{Binding PortRules.Loading503Tally, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                                                   Text="{Binding PortRules.Loading503Tally}" />
                                                        <Grid ColumnSpacing="8" ColumnDefinitions="Auto,*,Auto,*"
                                                              IsEnabled="{Binding PortRules.Loading503Enabled}">
                                                            <TextBlock VerticalAlignment="Center" Text="Retries"
                                                                       ToolTip.Tip="How many times to retry while the model is still loading." />
                                                            <NumericUpDown Grid.Column="1" Minimum="0" Maximum="12"
                                                                           Value="{Binding PortRules.LoadingRetryCount}" 
                                                                              ToolTip.Tip="How many times to retry while the model is still loading." />
                                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Delay seconds"
                                                                       ToolTip.Tip="Wait this long between Loading model retries. Total wait is capped." />
                                                            <NumericUpDown Grid.Column="3" Minimum="1" Maximum="10"
                                                                           Value="{Binding PortRules.LoadingRetryDelaySeconds}" 
                                                                                     ToolTip.Tip="Wait this long between Loading model retries. Total wait is capped." />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <Border Classes="portRuleGroup">
                                                    <DockPanel>
                                                    <views:HelpTopicLink DockPanel.Dock="Right"
                                                                         TopicId="{x:Static svc:HelpTopicIds.PortRules}"
                                                                         ToolTip.Tip="Open the Port rules Help topic." />
                                                    <Grid ColumnSpacing="8" RowDefinitions="Auto" ColumnDefinitions="Auto,*,Auto,*">
                                                        <TextBlock VerticalAlignment="Center" Text="Client-app max tokens"
                                                                   ToolTip.Tip="Which reply limit wins: this profile's Max tokens, the Client app's, or the smaller of the two. Replies are always kept short enough to fit Context." />
                                                        <ComboBox Grid.Column="1"
                                                                  ItemsSource="{Binding PortRules.ClientMaxTokensModeOptions}"
                                                                  SelectedItem="{Binding PortRules.SelectedClientMaxTokensMode}" 
                                                                   ToolTip.Tip="Which reply limit wins: this profile's Max tokens, the Client app's, or the smaller of the two. Replies are always kept short enough to fit Context." />
                                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Stop strings"
                                                                   ToolTip.Tip="Pass the Client app's stop words through, or ignore them if they cut replies or thinking short." />
                                                        <ComboBox Grid.Column="3"
                                                                  ItemsSource="{Binding PortRules.StopHygieneModeOptions}"
                                                                  SelectedItem="{Binding PortRules.SelectedStopHygieneMode}" 
                                                                   ToolTip.Tip="Pass the Client app's stop words through, or ignore them if they cut replies or thinking short." />
                                                    </Grid>
                                                    </DockPanel>
                                                </Border>

                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Content="Save Port rules"
                                                            Command="{Binding PortRules.SaveCommand}"
                                                            ToolTip.Tip="Save these Port rules. They apply from the next Client-app message." />
                                                    <Button Content="Load Port rules"
                                                            Command="{Binding PortRules.LoadSavedCommand}"
                                                            ToolTip.Tip="Throw away unsaved edits and put back the last saved Port rules file. If that file is missing, show the built-in defaults." />
                                                    <Button Content="Revert to defaults"
                                                            Command="{Binding PortRules.ResetCommand}"
                                                            ToolTip.Tip="Fill the built-in Compact, omit, mill, hang, 503, cache, max tokens, and stop numbers. Save Port rules to keep them, or Load Port rules to put the last saved file back." />
                                                </StackPanel>
                                                <TextBlock TextWrapping="Wrap"
                                                           FontSize="{DynamicResource FluxFontSizeCaption}"
                                                           Opacity="0.85"
                                                           IsVisible="{Binding PortRules.StatusText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                                           views:MarkedText.Source="{Binding PortRules.StatusText}" />
                                                <TextBlock TextWrapping="Wrap"
                                                           FontSize="{DynamicResource FluxFontSizeCaption}"
                                                           Opacity="0.85"
                                                           Text="Every Client app on Port shares these numbers. Save applies on the next local turn without reloading llama-server." />
                                            </StackPanel>
                                        </Expander>
                                        <TextBlock TextWrapping="Wrap"
                                                   FontSize="{DynamicResource FluxFontSizeCaption}"
                                                   Opacity="0.85"
                                                   Text="When Port rules are on, they watch for conditions that can derail a Client-app turn on local models, and can pause runaway looping. Turn them off to simply forward turns to llama-server without intervention, apart from Auto steer's notes while it is ticked. Cloud models do not use Port rules." />
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource FluxServersTintBlueBackground}" BorderBrush="{DynamicResource FluxServersTintBlueBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel Spacing="8">
                                        <TextBlock FontWeight="SemiBold" Text="Cloud provider" />
                                        <Grid ColumnDefinitions="Auto,*,Auto,2*,Auto,Auto" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Cloud AI Model Provider" />
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding CloudProviders}"
                                                      SelectedItem="{Binding SelectedCredentialCloudProvider}"
                                                      ItemTemplate="{StaticResource CloudProviderOptionTemplate}"
                                                      ToolTip.Tip="Which cloud company this key is for. Changing this does not switch which model is running." />
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="API Key" />
                                            <TextBox Grid.Column="3"
                                                     Text="{Binding CloudApiKeyEntry}"
                                                     PasswordChar="*"
                                                     PlaceholderText="Paste or type API key for selected provider"
                                                     ToolTip.Tip="Secret from the cloud company. Asterisks mean a key is already saved for this company. Paste a new key to replace it. Which models you can use depends on your paid plan with them." />
                                            <Button Grid.Column="4" Content="Validate Cloud Key" Command="{Binding ValidateCloudCommand}" ToolTip.Tip="Asks the cloud company if this key works. Paste or save the key first." />
                                            <Button Grid.Column="5" Content="Save Key" Command="{Binding SaveCloudApiKeyCommand}" ToolTip.Tip="Stores the key on this computer. Asterisks stay in the box to show a key is saved, without showing the real key." />
                                        </Grid>
                                        <TextBlock TextWrapping="Wrap" Text="{Binding CloudCredentialsHelpText}" Opacity="0.75" FontSize="{DynamicResource FluxFontSizeCaption}" />
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding ShowCustomOpenAiCompatibleSettings}">
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Base URL" />
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding CustomCompatEndpoint}"
                                                     PlaceholderText="https://host:port/v1"
                                                     ToolTip.Tip="Web address of this custom cloud-style server. Include /v1 if that server uses it. This is not a model name." />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,Auto" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Name" />
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding NewCustomCloudProviderName}"
                                                     PlaceholderText="Required name (e.g. Work vLLM)"
                                                     ToolTip.Tip="A name for this OpenAI-compatible server, shown in the Provider lists." />
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Base URL" />
                                            <TextBox Grid.Column="3"
                                                     Text="{Binding NewCustomCloudProviderEndpoint}"
                                                     PlaceholderText="https://api.example.com/v1"
                                                     ToolTip.Tip="The web address of this server. Needed, with a name, to add it." />
                                            <Button Grid.Column="4"
                                                    Content="Add custom provider"
                                                    Command="{Binding AddCustomCloudProviderCommand}"
                                                    ToolTip.Tip="Adds this server to the Provider lists with its own address and key." />
                                            <Button Grid.Column="5"
                                                    Content="Remove custom"
                                                    Command="{Binding RemoveCustomCloudProviderCommand}"
                                                    IsEnabled="{Binding CanRemoveSelectedCustomCloudProvider}"
                                                    ToolTip.Tip="Removes the selected named custom provider when no Model Profiles still use it." />
                                        </Grid>
                                        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FluxFontSizeCaption}" Opacity="0.75"
                                                   Text="Google/Gemini, Anthropic, OpenAI, and Copilot GitHub only need the key. Built-in OpenAI-compatible providers (Groq, DeepSeek, OpenRouter, Together, Fireworks, Mistral, xAI, Cerebras, Perplexity, Cohere, DeepInfra, SambaNova, NVIDIA, Hugging Face, Hyperbolic, Ollama, LM Studio) appear with usual base URLs — paste each key and Save Key. Any other server needs a Name and Base URL — Add custom provider writes it into the registry." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Model Profiles" ToolTip.Tip="Create model profiles for each local model or cloud model, then test that they actually answer before they appear in Quick Select.">
                <ScrollViewer x:Name="ModelProfilesScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12" Margin="0,8,0,8">
                        <TextBlock Grid.Row="0"
                                   FontSize="{DynamicResource FluxFontSizeCaption}"
                                   FontWeight="DemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="{Binding ProfileActionFeedbackBrush}"
                                   Text="{Binding ProfileActionFeedbackText}"
                                   IsVisible="{Binding ProfileActionFeedbackText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                        <Border Grid.Row="1"
                                Background="{DynamicResource FluxMutedBackground}"
                                BorderBrush="{DynamicResource FluxMutedBorder}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8">
                            <StackPanel Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="Model profile pack" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Export model profiles"
                                            Command="{Binding ExportModelProfilesCommand}"
                                            ToolTip.Tip="Save all your model profiles to a file you keep. No API keys. Validated marks are removed, so imported profiles need validating again." />
                                    <Button Content="Import model profiles"
                                            Command="{Binding ImportModelProfilesCommand}"
                                            ToolTip.Tip="Add model profiles from an exported file. AI-FluxMux backs up its settings first, skips profiles whose model file or picture helper is missing here, and never overwrites a profile you already have. Each skip is listed in Diagnostics." />
                                </StackPanel>
                                <TextBlock FontSize="{DynamicResource FluxFontSizeCaption}"
                                           Opacity="0.85"
                                           TextWrapping="Wrap"
                                           Text="Export writes a temporary JSON pack (no API keys). Import patches the live fluxmux_config.json with pack contents, but only if the pack coding is clean. Any imported profiles with existing name but different settings are skipped; profiles with existing settings but different name are skipped. See Help: Model profile packs." />
                            </StackPanel>
                        </Border>
                        <GroupBox Grid.Row="2" Header="Cloud Profiles">
                            <StackPanel Spacing="10" Margin="8">
                                <Border Background="{DynamicResource FluxMutedBackground}"
                                        BorderBrush="{DynamicResource FluxMutedBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,8">
                                    <StackPanel Spacing="8">
                                        <TextBlock FontSize="{DynamicResource FluxFontSizeBody}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource FluxHeadingForeground}"
                                                   Text="Create a cloud model profile" />
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" RowSpacing="6">
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Provider" />
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding CloudProviders}"
                                                      SelectedItem="{Binding NewCloudProfileProvider}"
                                                      ItemTemplate="{StaticResource CloudProviderOptionTemplate}"
                                                      MaxDropDownHeight="480"
                                                      ToolTip.Tip="Cloud company for a new default. Save that company's API key on the Servers tab first." />
                                            <Button Grid.Column="2"
                                                    Content="Refresh Models"
                                                    Command="{Binding RefreshNewCloudProfileModelsCommand}"
                                                    ToolTip.Tip="Downloads this company's current model names using your saved key. If yours is missing, paste the name in the box below." />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Model id" />
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding NewCloudProfileModels}"
                                                      SelectedItem="{Binding NewCloudProfileSelectedModel}"
                                                      ToolTip.Tip="The short name the company uses for the model, not a website address." />
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Or paste id" />
                                            <TextBox Grid.Column="3"
                                                     PlaceholderText="gemini-2.5-flash or gpt-4.1"
                                                     Text="{Binding NewCloudProfileCustomModelId}"
                                                     ToolTip.Tip="Type or paste a model name if Refresh Models did not list it." />
                                            <Button Grid.Column="4"
                                                    Content="Create new cloud model profile"
                                                    Command="{Binding CreateNewCloudModelProfileCommand}"
                                                    views:MarkedText.Tip="Creates a locked default for this cloud model. Run **Validate to endpoint** before it can be used in Quick Select." />
                                        </Grid>
                                        <TextBlock FontSize="{DynamicResource FluxFontSizeCaption}"
                                                   Opacity="0.88"
                                                   Foreground="{DynamicResource FluxSecondaryForeground}"
                                                   TextWrapping="Wrap"
                                                   views:MarkedText.Source="{Binding CloudModelIdHelpText}" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Spacing="6">
                                    <TextBlock FontSize="{DynamicResource FluxFontSizeBody}"
                                               FontWeight="SemiBold"
                                               Text="Existing cloud profiles" />
                                <ListBox x:Name="CloudVariantList"
                                         Classes="profileTree"
                                         ItemsSource="{Binding CloudVariantTreeItems}"
                                         SelectedItem="{Binding SelectedCloudVariantItem}"
                                         AutoScrollToSelectedItem="False"
                                         HorizontalAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.Styles>
                                        <Style Selector="ListBox /template/ ScrollViewer">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="AllowAutoHide" Value="True" />
                                        </Style>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CloudVariantTreeItemViewModel">
                                            <Expander Classes="profileExpander" HorizontalAlignment="Stretch" Margin="{Binding RowMargin}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Expanded="VariantExpander_Expanded" Collapsing="VariantExpander_Collapsing" Padding="0" BorderThickness="0">
                                                <Expander.Header>
                                            <Border Classes="profileHeaderChrome"
                                                            Classes.profileSelected="{Binding IsSelected}"
                                                            Classes.profileExpanded="{Binding IsExpanded}"
                                                            HorizontalAlignment="Stretch"
                                                            ToolTip.Tip="{Binding ProfileParadigmTooltip}">
                                                    <Border MinHeight="36" Padding="6,4" CornerRadius="6" Background="{Binding HeaderBackground}" BorderBrush="{Binding HeaderBorderBrush}" BorderThickness="1" HorizontalAlignment="Stretch">
                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" HorizontalAlignment="Stretch">
                                                            <Panel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Classes="profileStatusIcon"
                                                                           Text="⚠"
                                                                           Foreground="#F87171"
                                                                           IsVisible="{Binding ShowMissingFileWarning, FallbackValue=False, TargetNullValue=False}"
                                                                           ToolTip.Tip="{Binding MissingFileWarningTooltip}" />
                                                                <TextBlock Classes="profileStatusIcon"
                                                                           Text="✓"
                                                                           Foreground="#4ADE80"
                                                                           IsVisible="{Binding ShowValidatedCheck, FallbackValue=False, TargetNullValue=False}"
                                                                           ToolTip.Tip="{Binding EndpointStatusText}" />
                                                                <TextBlock Classes="profileStatusIcon"
                                                                           Text="●"
                                                                           Foreground="#34D399"
                                                                           IsVisible="{Binding IsRunning, FallbackValue=False, TargetNullValue=False}"
                                                                           ToolTip.Tip="This profile is currently running (launched from Quick Select)" />
                                                            </Panel>
                                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <Border Classes="corporateLogoBadge"
                                                                            IsVisible="{Binding HasLogo, FallbackValue=False}"
                                                                            ToolTip.Tip="{Binding LogoCompanyName}">
                                                                        <Image Classes="corporateLogo"
                                                                               Source="{Binding LogoAssetKey, Converter={x:Static vm:CorporateLogoImageConverter.Instance}}" />
                                                                    </Border>
                                                                    <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{Binding HeaderForeground}" Text="{Binding DisplayName}" />
                                                                </StackPanel>
                                                                <TextBlock FontSize="{DynamicResource FluxFontSizeSmall}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{Binding HeaderMutedForeground}" Text="{Binding SettingsSummary}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="{DynamicResource FluxSideNoteMaxWidth}">
                                                                <TextBlock FontSize="{DynamicResource FluxFontSizeSmall}"
                                                                           FontStyle="Italic"
                                                                           TextAlignment="Right"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="{Binding HeaderMutedForeground}"
                                                                           Text="{Binding RoleLabel}" />
                                                                <Border Classes="profileEditingBadge"
                                                                        HorizontalAlignment="Right"
                                                                        IsVisible="{Binding ShowEditingMarker, FallbackValue=False}">
                                                                    <TextBlock Text="editing this profile"
                                                                               FontSize="{DynamicResource FluxFontSizeSmall}"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#F8FAFC" />
                                                                </Border>
                                                            </StackPanel>
                                                            <Button Grid.Column="3"
                                                                    Classes="headerLockButton"
                                                                    IsVisible="{Binding ShowDefaultLockToggle, FallbackValue=False}"
                                                                    ToolTip.Tip="{Binding DefaultLockTooltip}">
                                                                <Panel Width="20" Height="20">
                                                                    <Viewbox IsVisible="{Binding ShowLockedPadlock, FallbackValue=False}" Stretch="Uniform">
                                                                        <Canvas Width="16" Height="16">
                                                                            <Path Stroke="{Binding HeaderForeground}" StrokeThickness="1.5" StrokeLineCap="Round" Fill="Transparent"
                                                                                  Data="M 4.5,7.4 V 5.1 C 4.5,3.2 6.2,1.8 8,1.8 C 9.8,1.8 11.5,3.2 11.5,5.1 V 7.4" />
                                                                            <Path Fill="{Binding HeaderForeground}" Data="M 3.1,7.4 H 12.9 V 14.3 C 12.9,14.8 12.5,15.2 12,15.2 H 4 C 3.5,15.2 3.1,14.8 3.1,14.3 Z" />
                                                                        </Canvas>
                                                                    </Viewbox>
                                                                    <Viewbox IsVisible="{Binding ShowUnlockedPadlock, FallbackValue=False}" Stretch="Uniform">
                                                                        <Canvas Width="16" Height="16">
                                                                            <Path Stroke="{Binding HeaderForeground}" StrokeThickness="1.5" StrokeLineCap="Round" Fill="Transparent"
                                                                                  Data="M 4.5,7.4 V 5.1 C 4.5,3.2 6.2,1.8 8,1.8 C 9.8,1.8 11.5,3.2 11.5,5.1 V 3.4" />
                                                                            <Path Fill="{Binding HeaderForeground}" Data="M 3.1,7.4 H 12.9 V 14.3 C 12.9,14.8 12.5,15.2 12,15.2 H 4 C 3.5,15.2 3.1,14.8 3.1,14.3 Z" />
                                                                        </Canvas>
                                                                    </Viewbox>
                                                                </Panel>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                    </Border>
                                                </Expander.Header>
                                                <ContentControl HorizontalAlignment="Stretch"
                                                                Content="{Binding InlineEditor}"
                                                                ContentTemplate="{StaticResource CloudProfileEditorTemplate}" />
                                            </Expander>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                    <TextBlock FontSize="{DynamicResource FluxFontSizeCaption}" Opacity="0.75" TextWrapping="Wrap" views:MarkedText.Source="Locked default model profiles appear in the list after Creation. Click the padlock to unlock and edit, rename, or replace AI-FluxMux auto settings; click it again to lock. Provider and Model id live in Detailed settings and save with **Save profile**. If **Validate to endpoint** fails, change those fields, **Save profile**, then **Validate to endpoint** again. On successful validation, the profile becomes an available set up option for the Quick Select tab. **Make New Variant** copies the current profile for tweaking as a new model profile variant, with a different settings package. Deleting a default model profile removes that model and all its variants from AI-FluxMux after confirmation." />
                                </StackPanel>


                            </StackPanel>
                        </GroupBox>

                        <GroupBox Grid.Row="3" Header="Local Profiles">
                            <StackPanel Spacing="10" Margin="8">
                                <Border Background="{DynamicResource FluxMutedBackground}"
                                        BorderBrush="{DynamicResource FluxMutedBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,8">
                                    <StackPanel Spacing="8">
                                        <TextBlock FontSize="{DynamicResource FluxFontSizeBody}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource FluxHeadingForeground}"
                                                   Text="Create a local model profile" />
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Local model" />
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding LocalProfiles}"
                                                      SelectedItem="{Binding NewLocalProfileModel}"
                                                      ToolTip.Tip="Local models found in the folder you set on the Servers tab." />
                                            <Button Grid.Column="2"
                                                    Content="Create new local model profile"
                                                    Command="{Binding CreateNewLocalModelProfileCommand}"
                                                    views:MarkedText.Tip="Creates a locked default for this local model. Run **Validate to endpoint** before it can be used in Quick Select." />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <StackPanel Spacing="6">
                                    <TextBlock FontSize="{DynamicResource FluxFontSizeBody}"
                                               FontWeight="SemiBold"
                                               Text="Existing local profiles" />
                                <ListBox x:Name="LocalVariantList"
                                         Classes="profileTree"
                                         ItemsSource="{Binding LocalVariantTreeItems}"
                                         SelectedItem="{Binding SelectedLocalVariantItem}"
                                         AutoScrollToSelectedItem="False"
                                         HorizontalAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.Styles>
                                        <Style Selector="ListBox /template/ ScrollViewer">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="AllowAutoHide" Value="True" />
                                        </Style>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CloudVariantTreeItemViewModel">
                                            <Expander Classes="profileExpander" HorizontalAlignment="Stretch" Margin="{Binding RowMargin}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Expanded="VariantExpander_Expanded" Collapsing="VariantExpander_Collapsing" Padding="0" BorderThickness="0">
                                                <Expander.Header>
                                            <Border Classes="profileHeaderChrome"
                                                            Classes.profileSelected="{Binding IsSelected}"
                                                            Classes.profileExpanded="{Binding IsExpanded}"
                                                            HorizontalAlignment="Stretch"
                                                            ToolTip.Tip="{Binding ProfileParadigmTooltip}">
                                                    <Border MinHeight="36" Padding="6,4" CornerRadius="6" Background="{Binding HeaderBackground}" BorderBrush="{Binding HeaderBorderBrush}" BorderThickness="1" HorizontalAlignment="Stretch">
                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" HorizontalAlignment="Stretch">
                                                            <Panel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Classes="profileStatusIcon"
                                                                           Text="⚠"
                                                                           Foreground="#F87171"
                                                                           IsVisible="{Binding ShowMissingFileWarning, FallbackValue=False, TargetNullValue=False}"
                                                                           ToolTip.Tip="{Binding MissingFileWarningTooltip}" />
                                                                <TextBlock Classes="profileStatusIcon"
                                                                           Text="✓"
                                                                           Foreground="#4ADE80"
                                                                           IsVisible="{Binding ShowValidatedCheck, FallbackValue=False, TargetNullValue=False}"
                                                                           ToolTip.Tip="{Binding EndpointStatusText}" />
                                                                <TextBlock Classes="profileStatusIcon"
                                                                           Text="●"
                                                                           Foreground="#34D399"
                                                                           IsVisible="{Binding IsRunning, FallbackValue=False, TargetNullValue=False}"
                                                                           ToolTip.Tip="This profile is currently running (launched from Quick Select)" />
                                                            </Panel>
                                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <Border Classes="corporateLogoBadge"
                                                                            IsVisible="{Binding HasLogo, FallbackValue=False}"
                                                                            ToolTip.Tip="{Binding LogoCompanyName}">
                                                                        <Image Classes="corporateLogo"
                                                                               Source="{Binding LogoAssetKey, Converter={x:Static vm:CorporateLogoImageConverter.Instance}}" />
                                                                    </Border>
                                                                    <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{Binding HeaderForeground}" Text="{Binding DisplayName}" />
                                                                </StackPanel>
                                                                <TextBlock FontSize="{DynamicResource FluxFontSizeSmall}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{Binding HeaderMutedForeground}" Text="{Binding SettingsSummary}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="{DynamicResource FluxSideNoteMaxWidth}">
                                                                <TextBlock FontSize="{DynamicResource FluxFontSizeSmall}"
                                                                           FontStyle="Italic"
                                                                           TextAlignment="Right"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="{Binding HeaderMutedForeground}"
                                                                           Text="{Binding RoleLabel}" />
                                                                <Border Classes="profileEditingBadge"
                                                                        HorizontalAlignment="Right"
                                                                        IsVisible="{Binding ShowEditingMarker, FallbackValue=False}">
                                                                    <TextBlock Text="editing this profile"
                                                                               FontSize="{DynamicResource FluxFontSizeSmall}"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#F8FAFC" />
                                                                </Border>
                                                            </StackPanel>
                                                            <Button Grid.Column="3"
                                                                    Classes="headerLockButton"
                                                                    IsVisible="{Binding ShowDefaultLockToggle, FallbackValue=False}"
                                                                    ToolTip.Tip="{Binding DefaultLockTooltip}">
                                                                <Panel Width="20" Height="20">
                                                                    <Viewbox IsVisible="{Binding ShowLockedPadlock, FallbackValue=False}" Stretch="Uniform">
                                                                        <Canvas Width="16" Height="16">
                                                                            <Path Stroke="{Binding HeaderForeground}" StrokeThickness="1.5" StrokeLineCap="Round" Fill="Transparent"
                                                                                  Data="M 4.5,7.4 V 5.1 C 4.5,3.2 6.2,1.8 8,1.8 C 9.8,1.8 11.5,3.2 11.5,5.1 V 7.4" />
                                                                            <Path Fill="{Binding HeaderForeground}" Data="M 3.1,7.4 H 12.9 V 14.3 C 12.9,14.8 12.5,15.2 12,15.2 H 4 C 3.5,15.2 3.1,14.8 3.1,14.3 Z" />
                                                                        </Canvas>
                                                                    </Viewbox>
                                                                    <Viewbox IsVisible="{Binding ShowUnlockedPadlock, FallbackValue=False}" Stretch="Uniform">
                                                                        <Canvas Width="16" Height="16">
                                                                            <Path Stroke="{Binding HeaderForeground}" StrokeThickness="1.5" StrokeLineCap="Round" Fill="Transparent"
                                                                                  Data="M 4.5,7.4 V 5.1 C 4.5,3.2 6.2,1.8 8,1.8 C 9.8,1.8 11.5,3.2 11.5,5.1 V 3.4" />
                                                                            <Path Fill="{Binding HeaderForeground}" Data="M 3.1,7.4 H 12.9 V 14.3 C 12.9,14.8 12.5,15.2 12,15.2 H 4 C 3.5,15.2 3.1,14.8 3.1,14.3 Z" />
                                                                        </Canvas>
                                                                    </Viewbox>
                                                                </Panel>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                    </Border>
                                                </Expander.Header>
                                                <ContentControl HorizontalAlignment="Stretch"
                                                                Content="{Binding InlineEditor}"
                                                                ContentTemplate="{StaticResource LocalProfileEditorTemplate}" />
                                            </Expander>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                    <TextBlock FontSize="{DynamicResource FluxFontSizeCaption}" Opacity="0.75" TextWrapping="Wrap" views:MarkedText.Source="Locked default model profiles appear in the list after Creation. Click the padlock to unlock and edit, rename, or replace AI-FluxMux auto settings; click it again to lock. If **Validate to endpoint** fails, change the settings, **Save profile**, then **Validate to endpoint** again. On successful validation, the profile becomes an available set up option for the Quick Select tab. **Make New Variant** copies the current profile for tweaking as a new model profile variant, with a different settings package. Deleting a default model profile removes that model and all its variants from AI-FluxMux after confirmation." />
                                </StackPanel>


                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Live-Switch Testing" ToolTip.Tip="Lab tests: how well a chat survives switching between two tested models (two locals, local and cloud, or two clouds). This unloads and reloads; it is not everyday routing.">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10" Margin="0,8,0,8">
                        <GroupBox Header="Profile switch guidance">
                            <StackPanel Margin="8" Spacing="8">
                                <TextBlock TextWrapping="Wrap"
                                           Text="This is for testing task continuity when switching between any two model profiles in one chat. This allows you to compare one pairing with another with different model profile settings." />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Model switch performance testing">
                            <StackPanel Margin="8" Spacing="8">
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Profile A" />
                                    <ComboBox Grid.Row="0"
                                              Grid.Column="1"
                                              ItemsSource="{Binding SwitchBenchmarkProfiles}"
                                              SelectedItem="{Binding SelectedSwitchBenchmarkProfileA}"
                                              ItemTemplate="{StaticResource SwitchBenchmarkProfileOptionTemplate}"
                                              ToolTip.Tip="First tested model in the switch. Local or cloud. ⚠ means this profile is not trusted right now: last connection failed, settings were saved after Validate, or a local model is missing." />

                                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Profile B" />
                                    <ComboBox Grid.Row="1"
                                              Grid.Column="1"
                                              ItemsSource="{Binding SwitchBenchmarkProfiles}"
                                              SelectedItem="{Binding SelectedSwitchBenchmarkProfileB}"
                                              ItemTemplate="{StaticResource SwitchBenchmarkProfileOptionTemplate}"
                                              ToolTip.Tip="Second tested model in the switch. Local or cloud. ⚠ means this profile is not trusted right now: last connection failed, settings were saved after Validate, or a local model is missing." />

                                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Order" />
                                    <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding SwitchBenchmarkOrderOptions}"
                                                  SelectedItem="{Binding SelectedSwitchBenchmarkOrder}" />
                                        <Button Grid.Column="1"
                                                Content="Run test"
                                                Command="{Binding RunSwitchBenchmarkCommand}" />
                                    </Grid>
                                </Grid>
                                <TextBlock TextWrapping="Wrap"
                                           FontSize="{DynamicResource FluxFontSizeCaption}"
                                           Opacity="0.75"
                                           Text="Pick any two validated model profiles, local or cloud. The test plants ten made-up facts through a long agent chat, sends that whole chat through Port to Profile A, then to Profile B, then back to Profile A, the way a Client app resends it, so AI-FluxMux shortens it for each profile exactly as in real use. Each profile is asked questions only those facts answer. It runs two chat sizes: one that fits both profiles, and one larger than the smaller profile's Context. The result lists the facts each profile lost, what AI-FluxMux shortened, and which settings to change. It reloads llama-server three times and can take several minutes." />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" RowSpacing="8">
                                    <TextBlock Grid.Column="0" VerticalAlignment="Top" Text="Result" />
                                    <TextBox Grid.Column="1"
                                             IsReadOnly="True"
                                             Text="{Binding SwitchBenchmarkResultText}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap" />
                                </Grid>
                                <StackPanel Spacing="4">
                                    <TextBlock FontWeight="SemiBold" Text="Summary" />
                                    <TextBlock TextWrapping="Wrap" Text="{Binding SwitchBenchmarkSummaryText}" />
                                    <TextBlock FontWeight="SemiBold" Text="Recommendation" />
                                    <TextBlock TextWrapping="Wrap" Text="{Binding SwitchBenchmarkRecommendationText}" />
                                </StackPanel>
                                <Expander Header="Advanced details" IsExpanded="False">
                                    <TextBox IsReadOnly="True"
                                             Text="{Binding SwitchBenchmarkAdvancedDetailsText}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                </Expander>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Environment" ToolTip.Tip="Checks llama-server, the model folder, the graphics card, paths, and cloud keys.">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Margin="0,8,0,8">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Content="Refresh" Command="{Binding CheckDependenciesCommand}" ToolTip.Tip="Check again after you change folders, keys, or hardware." />
                            <Button Content="Capture Known-Good Snapshot" Command="{Binding CaptureDependencyBaselineCommand}" ToolTip.Tip="After things work, save today's llama-server version and paths so you can compare later." />
                            <Button Content="Export Report" Command="{Binding ExportDependencyBomCommand}" ToolTip.Tip="Save this environment check as a file you can share." />
                        </StackPanel>

                        <GroupBox Header="AI-FluxMux updates">
                            <StackPanel Margin="8" Spacing="8">

                                <!-- ============ AI-FluxMux ============ -->
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock FontWeight="SemiBold" Text="AI-FluxMux" />
                                    <TextBlock Opacity="0.6" FontSize="{DynamicResource FluxFontSizeCaption}"
                                               Text="{x:Static upc:FluxMuxAppInfo.Version}" />
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" Opacity="0.88"
                                           Text="Click &quot;Check for updates&quot; to look for a newer AI-FluxMux on GitHub. Clicking &quot;Update now&quot; starts the automatic update — AI-FluxMux closes, the updater backs up and replaces the files, then prompts you to restart. Set an update source only if you have a preferred alternate source of updates." />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <TextBlock VerticalAlignment="Center" Text="Alternative source" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding UpdateFeedUrl}"
                                             PlaceholderText="https://…/fluxmux-updates.json"
                                             ToolTip.Tip="Optional. A custom update feed URL for AI-FluxMux. Leave blank to use the default GitHub releases." />
                                </Grid>
                                <TextBlock TextWrapping="Wrap" Opacity="0.88" Text="{Binding UpdateCheckStatusText}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Check for updates"
                                            Command="{Binding CheckForFluxMuxUpdatesCommand}">
                                        <ToolTip.Tip>
                                            <TextBlock TextWrapping="Wrap" MaxWidth="{DynamicResource FluxReadableTextMaxWidth}"
                                                       Text="Looks for a newer AI-FluxMux on GitHub (or the alternative source if set) and reports the result. Does not install anything." />
                                        </ToolTip.Tip>
                                    </Button>
                                    <Button Content="Update now"
                                            Command="{Binding UpdateFluxMuxNowCommand}">
                                        <ToolTip.Tip>
                                            <TextBlock TextWrapping="Wrap" MaxWidth="{DynamicResource FluxReadableTextMaxWidth}"
                                                       Text="If a newer AI-FluxMux is available, closes AI-FluxMux and runs the standalone updater to back up and replace the install, then prompts you to restart." />
                                        </ToolTip.Tip>
                                    </Button>
                                </StackPanel>
                                <!-- ============ llama-server ============ -->
                                <TextBlock FontWeight="SemiBold" Text="llama-server" />
                                <TextBlock TextWrapping="Wrap" Opacity="0.88"
                                           Text="Click &quot;Check for updates&quot; to look for a newer llama-server on the llama.cpp nightlies. Clicking &quot;Update now&quot; starts the automatic update — AI-FluxMux closes, the updater backs up and replaces the llama-server folder, then prompts you to restart. Set an update source only if you have a preferred alternate source of updates. If you have recently changed GPU hardware, you may need to manually uninstall and reinstall with the correct version optimised for your hardware — future updates should then work." />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <TextBlock VerticalAlignment="Center" Text="Alternative source" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding LlamaUpdateSource}"
                                             PlaceholderText="https://… (optional custom nightly source)"
                                             ToolTip.Tip="Optional. A custom source for llama-server updates. Leave blank to use the default llama.cpp nightlies." />
                                </Grid>
                                <TextBlock TextWrapping="Wrap" Opacity="0.88" Text="{Binding LlamaServerUpdateStatusText}" />
                                <!-- CUDA-minor picker: shown when the release ships multiple CUDA-minor zips -->
                                <StackPanel Orientation="Horizontal" Spacing="8"
                                            IsVisible="{Binding LlamaCudaMinorPickerVisible}">
                                    <TextBlock VerticalAlignment="Center" Text="CUDA minor:"
                                               ToolTip.Tip="The llama.cpp release ships multiple CUDA-minor zips. Pick the one that matches your install (e.g. 12.4, 12.6). This choice is remembered for next time." />
                                    <ComboBox ItemsSource="{Binding LlamaCudaMinorChoices}"
                                              SelectedItem="{Binding LlamaCudaMinor}"
                                              ToolTip.Tip="Pick the CUDA minor that matches your GPU driver. This is remembered so future updates don't need a manual pick." />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Check for updates"
                                            Command="{Binding CheckForLlamaServerUpdatesCommand}">
                                        <ToolTip.Tip>
                                            <TextBlock TextWrapping="Wrap" MaxWidth="{DynamicResource FluxReadableTextMaxWidth}"
                                                       Text="Looks for a newer llama-server zip matching this install's family (or the alternative source if set) and reports the result. Does not install anything." />
                                        </ToolTip.Tip>
                                    </Button>
                                    <Button Content="Update now"
                                            Command="{Binding UpdateLlamaServerNowViaUpdaterCommand}">
                                        <ToolTip.Tip>
                                            <TextBlock TextWrapping="Wrap" MaxWidth="{DynamicResource FluxReadableTextMaxWidth}"
                                                       Text="If a newer llama-server is available, closes AI-FluxMux and runs the standalone updater to back up and replace your llama-server folder, then prompts you to restart." />
                                        </ToolTip.Tip>
                                    </Button>
                                </StackPanel>
                                <!-- ============ DeepSeek Harness ============ -->
                                <TextBlock FontWeight="SemiBold" Text="DeepSeek Harness" />
                                <TextBlock TextWrapping="Wrap" Opacity="0.88"
                                           Text="Click &quot;Check for updates&quot; to look for a newer DeepSeek Harness on npm. Clicking &quot;Update now&quot; starts the automatic update — AI-FluxMux closes, the updater backs up your config and updates dsh via npm, then prompts you to restart. Set an update source only if you have a preferred alternate source of updates." />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <TextBlock VerticalAlignment="Center" Text="Alternative source" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding HarnessUpdateSource}"
                                             PlaceholderText="https://… (optional custom release source)"
                                             ToolTip.Tip="Optional. A custom source for DeepSeek Harness updates. Leave blank to use the default npm registry." />
                                </Grid>
                                <TextBlock TextWrapping="Wrap" Opacity="0.88" Text="{Binding HarnessUpdateStatusText}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Check for updates"
                                            Command="{Binding CheckForHarnessUpdatesCommand}">
                                        <ToolTip.Tip>
                                            <TextBlock TextWrapping="Wrap" MaxWidth="{DynamicResource FluxReadableTextMaxWidth}"
                                                       Text="Looks for a newer DeepSeek Harness on npm (or the alternative source if set) and reports the result. Does not install anything." />
                                        </ToolTip.Tip>
                                    </Button>
                                    <Button Content="Update now"
                                            Command="{Binding UpdateHarnessNowCommand}">
                                        <ToolTip.Tip>
                                            <TextBlock TextWrapping="Wrap" MaxWidth="{DynamicResource FluxReadableTextMaxWidth}"
                                                       Text="If a newer DeepSeek Harness is available and Node.js is present, closes AI-FluxMux and runs the standalone updater to back up your config and update dsh via npm, then prompts you to restart." />
                                        </ToolTip.Tip>
                                    </Button>
                                </StackPanel>

                            </StackPanel>
                        </GroupBox>

                        <Border Background="{DynamicResource FluxTintBlueBackground}" BorderBrush="{DynamicResource FluxTintBlueBorder}" BorderThickness="1" Padding="10">
                            <TextBlock TextWrapping="Wrap" Text="{Binding DependencySummary}" />
                        </Border>

                        <Border Background="{DynamicResource FluxMutedBackground}" BorderBrush="{DynamicResource FluxMutedBorder}" BorderThickness="1" Padding="10">
                            <TextBlock TextWrapping="Wrap" Text="{Binding DependencyScopeHelpText}" />
                        </Border>

                        <Border Background="{DynamicResource FluxTintAmberBackground}" BorderBrush="{DynamicResource FluxTintAmberBorder}" BorderThickness="1" Padding="10">
                            <StackPanel Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="Update guidance" />
                                <TextBlock TextWrapping="Wrap" Text="{Binding DependencyPinPolicyText}" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource FluxMutedBackground}" BorderBrush="{DynamicResource FluxMutedBorder}" BorderThickness="1" Padding="10">
                            <StackPanel Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="Known-good environment comparison (optional)" />
                                <TextBlock TextWrapping="Wrap" Text="{Binding DependencyDriftSummaryText}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" Text="Reference links:" />
                            <Button Content="llama.cpp"
                                Command="{Binding OpenExternalLinkCommand}"
                                CommandParameter="https://github.com/ggml-org/llama.cpp/releases"
                                ToolTip.Tip="Opens the official llama.cpp download page in your browser." />
                        </StackPanel>

                        <GroupBox Header="Local runtime" ToolTip.Tip="The program that runs local models.">
                            <StackPanel Margin="8" Spacing="4">
                                <Grid ColumnDefinitions="2.6*,1.1*,2.2*,2.1*" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0" FontWeight="Bold" Text="Component" />
                                    <TextBlock Grid.Column="1" FontWeight="Bold" Text="Minimum" />
                                    <TextBlock Grid.Column="2" FontWeight="Bold" Text="Installed" />
                                    <TextBlock Grid.Column="3" FontWeight="Bold" Text="Status" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding CoreDependencyRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding RowBackground}" ToolTip.Tip="{Binding Guidance}">
                                                <Grid ColumnDefinitions="2.6*,1.1*,2.2*,2.1*" ColumnSpacing="6" Margin="0,2,0,2">
                                                    <TextBlock Grid.Column="0" TextWrapping="Wrap" Text="{Binding Dependency}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Minimum}" />
                                                    <TextBlock Grid.Column="2" TextWrapping="Wrap" Text="{Binding Installed}" />
                                                    <TextBlock Grid.Column="3" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Status}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Active route requirements" ToolTip.Tip="Keys and files needed for the cloud company and local model you are using.">
                            <StackPanel Margin="8" Spacing="4">
                                <Grid ColumnDefinitions="1.8*,1.8*,2.5*,2.9*" ColumnSpacing="4">
                                    <TextBlock Grid.Column="0" FontWeight="Bold" Text="Provider connection" />
                                    <TextBlock Grid.Column="1" FontWeight="Bold" Text="Connection" />
                                    <TextBlock Grid.Column="2" FontWeight="Bold" Text="Required file(s)" />
                                    <TextBlock Grid.Column="3" FontWeight="Bold" Text="Required field(s)" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding ProviderRequirementRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding RowBackground}" ToolTip.Tip="{Binding Guidance}">
                                                <Grid ColumnDefinitions="1.8*,1.8*,2.5*,2.9*" ColumnSpacing="4" Margin="0,2,0,2">
                                                    <TextBlock Grid.Column="0" TextWrapping="Wrap" Text="{Binding Provider}" />
                                                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{Binding Sdk}" />
                                                    <TextBlock Grid.Column="2" TextWrapping="Wrap" Text="{Binding RequiredFiles}" />
                                                    <TextBlock Grid.Column="3" TextWrapping="Wrap" Text="{Binding RequiredFields}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Configured paths" ToolTip.Tip="Folders and files AI-FluxMux is set to use. A missing path only matters for the kind of model you are starting.">
                            <StackPanel Margin="8" Spacing="4">
                                <Grid ColumnDefinitions="2.2*,1.1*,3.7*,1.2*" ColumnSpacing="4">
                                    <TextBlock Grid.Column="0" FontWeight="Bold" Text="Component" />
                                    <TextBlock Grid.Column="1" FontWeight="Bold" Text="Type" />
                                    <TextBlock Grid.Column="2" FontWeight="Bold" Text="Resolved path" />
                                    <TextBlock Grid.Column="3" FontWeight="Bold" Text="Status" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding HardRequiredPathRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding RowBackground}" ToolTip.Tip="{Binding Guidance}">
                                                <Grid ColumnDefinitions="2.2*,1.1*,3.7*,1.2*" ColumnSpacing="4" Margin="0,2,0,2">
                                                    <TextBlock Grid.Column="0" Text="{Binding Component}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Kind}" />
                                                    <TextBlock Grid.Column="2" TextWrapping="Wrap" Text="{Binding ResolvedPath}" />
                                                    <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="{Binding Status}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Runtime diagnostics files" ToolTip.Tip="Log files created after you run related tests. 'Not yet generated' is normal until that test has run.">
                            <StackPanel Margin="8" Spacing="4">
                                <Grid ColumnDefinitions="2.2*,1.1*,3.7*,1.2*" ColumnSpacing="4">
                                    <TextBlock Grid.Column="0" FontWeight="Bold" Text="Component" />
                                    <TextBlock Grid.Column="1" FontWeight="Bold" Text="Type" />
                                    <TextBlock Grid.Column="2" FontWeight="Bold" Text="Resolved path" />
                                    <TextBlock Grid.Column="3" FontWeight="Bold" Text="Status" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding RuntimePathRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding RowBackground}" ToolTip.Tip="{Binding Guidance}">
                                                <Grid ColumnDefinitions="2.2*,1.1*,3.7*,1.2*" ColumnSpacing="4" Margin="0,2,0,2">
                                                    <TextBlock Grid.Column="0" Text="{Binding Component}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Kind}" />
                                                    <TextBlock Grid.Column="2" TextWrapping="Wrap" Text="{Binding ResolvedPath}" />
                                                    <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="{Binding Status}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Local model capability estimate" ToolTip.Tip="Guesses from filenames whether a model can see pictures. Not proven until you Launch.">
                            <StackPanel Margin="8" Spacing="4">
                                <Grid ColumnDefinitions="2.8*,1.0*,1.8*,3.4*" ColumnSpacing="4">
                                    <TextBlock Grid.Column="0" FontWeight="Bold" Text="Model" />
                                    <TextBlock Grid.Column="1" FontWeight="Bold" Text="Format" />
                                    <TextBlock Grid.Column="2" FontWeight="Bold" Text="Vision support" />
                                    <TextBlock Grid.Column="3" FontWeight="Bold" Text="Notes" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding LocalModelCapabilityRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding RowBackground}" ToolTip.Tip="{Binding Guidance}">
                                                <Grid ColumnDefinitions="2.8*,1.0*,1.8*,3.4*" ColumnSpacing="4" Margin="0,2,0,2">
                                                    <TextBlock Grid.Column="0" TextWrapping="Wrap" Text="{Binding Model}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Format}" />
                                                    <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="{Binding VisionSupport}" />
                                                    <TextBlock Grid.Column="3" TextWrapping="Wrap" Text="{Binding Notes}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Install guides" ToolTip.Tip="Official download pages.">
                            <StackPanel Margin="8" Spacing="4">
                                <ItemsControl ItemsSource="{Binding CoreInstallGuideRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource FluxMutedBorder}" Padding="0,4" Background="{Binding RowBackground}" ToolTip.Tip="{Binding Guidance}">
                                                <StackPanel Spacing="2">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Dependency}" />
                                                    <TextBlock TextWrapping="Wrap" Text="{Binding InstallOrUpdate}" />
                                                    <Button HorizontalAlignment="Left"
                                                            Command="{Binding ElementName=RootWindow, Path=DataContext.OpenExternalLinkCommand}"
                                                            CommandParameter="{Binding Source}"
                                                            ToolTip.Tip="Open this official page in your browser.">
                                                        <TextBlock TextWrapping="Wrap" Text="{Binding Source}" />
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Settings"
                     ToolTip.Tip="Configure GPU &amp; VRAM, idle timeout, UI scale, theme, and window width preferences.">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Margin="0,8,0,8">
                    <StackPanel Spacing="16">
                        <!-- GPU & VRAM -->
                        <GroupBox Header="GPU &amp; VRAM">
                            <StackPanel Margin="8" Spacing="8">
                                <TextBlock IsVisible="{Binding GpuVramScanning}"
                                           Opacity="0.82"
                                           Text="{x:Static vm:MainViewModel.GpuVramScanningText}" />
                                <TextBlock IsVisible="{Binding !GpuVramScanning}"
                                           Text="{Binding VramStatusText}"
                                           TextWrapping="Wrap" />
                                <Button HorizontalAlignment="Left"
                                        Content="Refresh GPU &amp; apps info"
                                        Command="{Binding RefreshVramStatusCommand}"
                                        IsEnabled="{Binding !GpuVramScanning}"
                                        ToolTip.Tip="Update graphics-memory numbers and app list after you close apps or move the display." />

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Display adapters"
                                               FontSize="{DynamicResource FluxFontSizeBody}"
                                               FontWeight="SemiBold"
                                               Opacity="0.7" />
                                    <ItemsControl IsVisible="{Binding ShowGpuAdapterList}"
                                                  ItemsSource="{Binding GpuAdapterRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="6,4"
                                                        CornerRadius="4"
                                                        Background="{DynamicResource FluxCardBackground}"
                                                        Margin="0,2">
                                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding NameLabel}"
                                                                   TextWrapping="Wrap"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding StatusLabel}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="0,0,12,0" />
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding NotesLabel}"
                                                                   Margin="12,0,0,0"
                                                                   TextWrapping="Wrap" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- Empty-state fallback: shown when no display adapters were
                                         detected (or the PowerShell query failed). Restored after
                                         c3f9cd2 dropped it, which made the section look empty. -->
                                    <TextBlock IsVisible="{Binding ShowGpuAdapterEmptyMessage}"
                                               Opacity="0.82"
                                               TextWrapping="Wrap"
                                               Text="No display adapters detected, or PowerShell query failed." />
                                </StackPanel>

                                <!-- Monitor connection scenarios info (restored after c3f9cd2 dropped it).
                                     Sits between the Display adapters detection and the affinity switcher.
                                     Covers the three connection scenarios with pros/cons. -->
                                <views:OptionInfoNote InfoId="gpu.monitor_scenarios"
                                                      IsVisible="{Binding ShowDesktopGpuPreference}"
                                                      NoteText="**Monitor connections vs local-model performance.**&#10;&#8226; **Motherboard GPU (iGPU) mode:** plug your monitor(s) into the motherboard graphics ports and use the batch toggle control below to set the Windows GPU affinity to **Motherboard GPU**. All desktop apps then use the on-board graphics + shared system RAM by default (after Windows restart). VRAM-based versions of llama-server stay pinned to your main graphics card.&#10;&#8211; **Pros:** maximum flexibility as to which GPU &amp; RAM is used for what. Allows the maximum amount of the main card's VRAM to be made free for your local models, with the ability to opt individual apps in and out for apps and games that really need VRAM performance (use the toggles below).&#10;&#8211; **Cons:** your display and some apps may run less smoothly, and some features like G-Sync, HDR, higher refresh rates etc may not perform as well or may be unavailable. A BIOS change is usually needed first so the on-board chip runs alongside the main card, and not all motherboards support this cleanly. A small routing overhead applies (compared with plugging monitors directly into dGPU ports) when apps and games use the dGPU and route via iGPU ports.&#10;&#10;&#8226; **Discrete GPU (dGPU) mode:** plug your monitor(s) directly into the main graphics card's ports.&#10;&#8211; **Pros:** maximum graphical performance at all times, highest refresh rate, access to G-Sync, HDR etc.&#10;&#8211; **Cons:** the main card's VRAM is shared with your desktop and apps, with no ability to offload them to the iGPU, leaving less for local models." />

                                <!-- Batch Windows affinity switcher -->
                                <StackPanel Spacing="4"
                                            Margin="0,10,0,0"
                                            IsVisible="{Binding ShowDesktopGpuPreference}">
                                    <TextBlock Text="Batch Windows affinity switcher"
                                               FontSize="{DynamicResource FluxFontSizeEmphasis}"
                                               FontWeight="SemiBold"
                                               Opacity="0.85" />
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="8">
                                        <ComboBox MinWidth="200"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  ItemsSource="{Binding DesktopGpuChoices}"
                                                  SelectedItem="{Binding SelectedDesktopGpu}"
                                                  IsEnabled="{Binding !DesktopGpuBusy}"
                                                  ToolTip.Tip="Sets the default GPU for eligible desktop apps. Only eligible apps &amp; processes are switched — pinned apps (llama-server) and system/background processes are protected and stay on their current GPU. Click **Apply**, then restart Windows." />
                                        <Button Grid.Column="1"
                                                Content="Apply"
                                                Command="{Binding ApplyDesktopGpuCommand}"
                                                ToolTip.Tip="Write the Windows GPU affinity, then restart Windows so apps pick it up." />
                                    </Grid>
                                    <TextBlock views:MarkedText.Source="{Binding DesktopGpuStatusText}"
                                               TextWrapping="Wrap"
                                               Opacity="0.85" />
                                </StackPanel>

                                <!-- GPU / dedicated VRAM using apps (user-facing, switchable) -->
                                <Border Margin="0,10,0,0"
                                        Padding="8,6"
                                        CornerRadius="6"
                                        Background="{DynamicResource FluxMutedBackground}">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="GPU / dedicated VRAM using apps"
                                                       FontSize="{DynamicResource FluxFontSizeEmphasis}"
                                                       FontWeight="SemiBold"
                                                       Opacity="0.85" />
                                            <TextBlock Text="{Binding VramGpuAppsCountText}"
                                                       FontSize="{DynamicResource FluxFontSizeBody}"
                                                       Opacity="0.5" />
                                        </StackPanel>
                                        <TextBlock IsVisible="{Binding !HasVramGpuAppRows}"
                                                   Text="No user-facing apps are using the dedicated GPU right now."
                                                   Opacity="0.6"
                                                   FontSize="{DynamicResource FluxFontSizeBody}" />
                                        <ItemsControl ItemsSource="{Binding VramGpuAppRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="svc:GpuAppListItem">
                                                    <Border Padding="6,4"
                                                            CornerRadius="4"
                                                            Background="{DynamicResource FluxCardBackground}"
                                                            Margin="0,2">
                                                        <Grid ColumnDefinitions="*,Auto,Auto"
                                                              ColumnSpacing="10">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding DisplayName}"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="Wrap"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding MemoryLabel}"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Right"
                                                                       Opacity="0.8"
                                                                       FontSize="{DynamicResource FluxFontSizeCaption}" />
                                                            <ctrl:GpuPillToggle Grid.Column="2"
                                                                                IsOnMotherboard="{Binding IsOnMotherboardGpu}"
                                                                                IsSwitchable="{Binding CanToggle}"
                                                                                HasPendingChange="{Binding HasPendingGpuChange}"
                                                                                 ToggleCommand="{Binding $parent[Window].DataContext.ToggleGpuAppCommand}"
                                                                                ToolTip.Tip="Move this app to the Motherboard GPU (iGPU). Click the other side to return it to the Discrete GPU." />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- iGPU / shared RAM using apps (user-facing, switchable) -->
                                <Border Margin="0,10,0,0"
                                        Padding="8,6"
                                        CornerRadius="6"
                                        Background="{DynamicResource FluxTintBlueBackground}">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="iGPU / shared RAM using apps"
                                                       FontSize="{DynamicResource FluxFontSizeEmphasis}"
                                                       FontWeight="SemiBold"
                                                       Opacity="0.85" />
                                            <TextBlock Text="{Binding IgpuGpuAppsCountText}"
                                                       FontSize="{DynamicResource FluxFontSizeBody}"
                                                       Opacity="0.5" />
                                        </StackPanel>
                                        <TextBlock IsVisible="{Binding !HasIgpuGpuAppRows}"
                                                   Text="No user-facing apps are on the Motherboard GPU (iGPU) right now."
                                                   Opacity="0.6"
                                                   FontSize="{DynamicResource FluxFontSizeBody}" />
                                        <ItemsControl ItemsSource="{Binding IgpuGpuAppRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="svc:GpuAppListItem">
                                                    <Border Padding="6,4"
                                                            CornerRadius="4"
                                                            Background="{DynamicResource FluxCardBackground}"
                                                            Margin="0,2">
                                                        <Grid ColumnDefinitions="*,Auto,Auto"
                                                              ColumnSpacing="10">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding DisplayName}"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="Wrap"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding MemoryLabel}"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Right"
                                                                       Opacity="0.8"
                                                                       FontSize="{DynamicResource FluxFontSizeCaption}" />
                                                            <ctrl:GpuPillToggle Grid.Column="2"
                                                                                IsOnMotherboard="{Binding IsOnMotherboardGpu}"
                                                                                IsSwitchable="{Binding CanToggle}"
                                                                                HasPendingChange="{Binding HasPendingGpuChange}"
                                                                                 ToggleCommand="{Binding $parent[Window].DataContext.ToggleGpuAppCommand}"
                                                                                ToolTip.Tip="Move this app to the Discrete GPU (dedicated VRAM). Click the other side to return it to the Motherboard GPU." />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Protected apps (pinned, not switchable — listed individually, greyed) -->
                                <Border Margin="0,10,0,0"
                                        Padding="8,6"
                                        CornerRadius="6"
                                        Background="{DynamicResource FluxTintAmberBackground}"
                                        IsVisible="{Binding HasProtectedGpuApps}">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Protected apps"
                                                       FontSize="{DynamicResource FluxFontSizeEmphasis}"
                                                       FontWeight="SemiBold"
                                                       Opacity="0.85" />
                                            <TextBlock Text="{Binding ProtectedGpuAppsCountText}"
                                                       FontSize="{DynamicResource FluxFontSizeBody}"
                                                       Opacity="0.5" />
                                        </StackPanel>
                                        <TextBlock Text="These apps are pinned to a GPU by AI-FluxMux and cannot be switched here."
                                                   Opacity="0.6"
                                                   FontSize="{DynamicResource FluxFontSizeBody}"
                                                   TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding ProtectedGpuAppRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="svc:GpuAppListItem">
                                                    <Border Padding="6,4"
                                                            CornerRadius="4"
                                                            Background="{DynamicResource FluxCardBackground}"
                                                            Margin="0,2"
                                                            Opacity="0.55">
                                                        <Grid ColumnDefinitions="*,Auto,Auto"
                                                              ColumnSpacing="10">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding DisplayName}"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="Wrap"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding MemoryLabel}"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Right"
                                                                       Opacity="0.8"
                                                                       FontSize="{DynamicResource FluxFontSizeCaption}" />
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding StatusLabel}"
                                                                       VerticalAlignment="Center"
                                                                       Opacity="0.7"
                                                                       FontSize="{DynamicResource FluxFontSizeCaption}"
                                                                       ToolTip.Tip="Pinned by AI-FluxMux — not switchable." />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- System & background processes (listed individually, greyed, not switchable) -->
                                <Border Margin="0,10,0,0"
                                        Padding="8,6"
                                        CornerRadius="6"
                                        Background="{DynamicResource FluxMutedBackground}"
                                        IsVisible="{Binding HasSystemGpuApps}">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="System &amp; background processes"
                                                       FontSize="{DynamicResource FluxFontSizeEmphasis}"
                                                       FontWeight="SemiBold"
                                                       Opacity="0.85" />
                                            <TextBlock Text="{Binding SystemGpuAppsCountText}"
                                                       FontSize="{DynamicResource FluxFontSizeBody}"
                                                       Opacity="0.5" />
                                        </StackPanel>
                                        <TextBlock Text="OS compositing and background processes. These cannot be switched."
                                                   Opacity="0.6"
                                                   FontSize="{DynamicResource FluxFontSizeBody}"
                                                   TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding SystemGpuAppRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="svc:GpuAppListItem">
                                                    <Border Padding="6,4"
                                                            CornerRadius="4"
                                                            Background="{DynamicResource FluxCardBackground}"
                                                            Margin="0,2"
                                                            Opacity="0.55">
                                                        <Grid ColumnDefinitions="*,Auto,Auto"
                                                              ColumnSpacing="10">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding DisplayName}"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="Wrap"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding MemoryLabel}"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Right"
                                                                       Opacity="0.8"
                                                                       FontSize="{DynamicResource FluxFontSizeCaption}" />
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding StatusLabel}"
                                                                       VerticalAlignment="Center"
                                                                       Opacity="0.7"
                                                                       FontSize="{DynamicResource FluxFontSizeCaption}"
                                                                       ToolTip.Tip="System process — not switchable." />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </GroupBox>

                        <!-- Idle Timeout -->
                        <GroupBox Header="Idle Timeout">
                            <StackPanel Margin="8" Spacing="8">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                    <CheckBox VerticalAlignment="Center"
                                              Content="Enable idle timeout"
                                              IsChecked="{Binding IdleTimeoutEnabled}"
                                              ToolTip.Tip="Automatically stop the model after a period of inactivity to save resources." />
                                    <NumericUpDown MinWidth="72"
                                                   Value="{Binding IdleTimeoutMinutes}"
                                                   Minimum="1"
                                                   Maximum="240"
                                                   IsEnabled="{Binding IdleTimeoutEnabled}"
                                                   ToolTip.Tip="{StaticResource IdleTimeoutTooltip}" />
                                    <TextBlock VerticalAlignment="Center" Text="min" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- UI Preferences -->
                        <GroupBox Header="UI Preferences">
                            <StackPanel Margin="8" Spacing="8">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                    <TextBlock VerticalAlignment="Center" Opacity="0.6" Text="UI scale" />
                                    <ComboBox VerticalAlignment="Center"
                                              ItemsSource="{Binding UiScaleOptions}"
                                              SelectedItem="{Binding SelectedUiScale}"
                                              ToolTip.Tip="Make the whole window smaller so more fits on screen. Nothing is hidden." />
                                    <TextBlock VerticalAlignment="Center" Opacity="0.6" Text="UI theme" />
                                    <ComboBox VerticalAlignment="Center"
                                              ItemsSource="{Binding UiThemeOptions}"
                                              SelectedItem="{Binding SelectedUiTheme}"
                                              ToolTip.Tip="Light or dark window chrome. Diagnostics log stays dark either way." />
                                    <CheckBox VerticalAlignment="Center"
                                              Content="UI enforce clean width"
                                              IsChecked="{Binding EnforceCleanWidth}"
                                              ToolTip.Tip="Limits how narrow the window can be shrunk, to protect the visibility of controls on all tabs. At Normal UI scale this sets a 1024px minimum width; smaller UI scales reduce it proportionally. When unchecked, the window can shrink much smaller and controls may wrap or compress." />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Git Checkpoints"
                                  ToolTip.Tip="Folder where the '📌 Checkpoint' button creates commits. Global setting — applies to all profiles and client types. Leave blank to use the workspace root.">
                            <StackPanel Margin="8" Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Checkpoint folder" VerticalAlignment="Center"
                                               FontSize="{DynamicResource FluxFontSizeCaption}" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding LocalGitCheckpointDirectory}"
                                             MinWidth="{DynamicResource FluxPathBoxMinWidth}"
                                             VerticalAlignment="Center"
                                             ToolTip.Tip="The folder where git checkpoint commits are created. Leave blank to use the workspace root (shown below)." />
                                    <Button Content="Browse…" Command="{Binding BrowseGitCheckpointDirectoryCommand}"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="Pick a folder for git checkpoints." />
                                    <Button Content="Reset" Command="{Binding ClearGitCheckpointDirectoryCommand}"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="Reset to the workspace root." />
                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeSmall}" Foreground="Gray"
                                               Text="{Binding GitCheckpointDefaultDirectory, StringFormat='(default: {0})'}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Restore" VerticalAlignment="Center"
                                               FontSize="{DynamicResource FluxFontSizeCaption}" FontWeight="SemiBold" />
                                    <Button Content="Restore to latest checkpoint"
                                            Command="{Binding RestoreGitCheckpointCommand}"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="Puts the checkpoint folder back to the most recent checkpoint. Anything changed since then that was not checkpointed is lost." />
                                    <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeSmall}" Foreground="Gray"
                                               Text="Restores to the most recent checkpoint commit." />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Help">
                <Grid ColumnDefinitions="260,10,*" Margin="0,8,0,8" Loaded="OnHelpChromeLoaded">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                        <TextBox x:Name="HelpSearchBox"
                                 PlaceholderText="Search Help"
                                 ToolTip.Tip="Type to filter the index. Matching topics stay in the list; click one to jump. Press Enter to jump to the first match."
                                 TextChanged="OnHelpSearchTextChanged"
                                 KeyDown="OnHelpSearchKeyDown" />
                        <TextBlock x:Name="HelpSearchStatus"
                                   Grid.Row="1"
                                   FontSize="{DynamicResource FluxFontSizeCaption}"
                                   Opacity="0.72"
                                   TextWrapping="Wrap"
                                   Text="Pick a topic, or search." />
                        <ListBox x:Name="HelpIndexList"
                                 Grid.Row="2"
                                 SelectionChanged="OnHelpIndexSelectionChanged">
                            <ListBox.Styles>
                                <!-- Section banners label the topics under them; they are not destinations. -->
                                <Style Selector="ListBoxItem" x:DataType="views:HelpTopicEntry">
                                    <Setter Property="IsHitTestVisible" Value="{Binding IsTopic}" />
                                    <Setter Property="Focusable" Value="{Binding IsTopic}" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="views:HelpTopicEntry">
                                    <Panel>
                                        <TextBlock Text="{Binding Title}"
                                                   IsVisible="{Binding IsSection}"
                                                   FontSize="{DynamicResource FluxFontSizeCaption}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource FluxSecondaryForeground}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Title}"
                                                   IsVisible="{Binding IsTopic}"
                                                   TextWrapping="Wrap" />
                                    </Panel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <ScrollViewer x:Name="HelpBodyScroll"
                                  Grid.Column="2"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="HelpBodyPanel" Margin="14,0,8,24">
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <GridSplitter Grid.Row="2"
                      Theme="{StaticResource DiagnosticsSashTheme}"
                      ResizeDirection="Rows"
                      HorizontalAlignment="Stretch"
                      ToolTip.Tip="Drag to make the log area taller or shorter." />

        <Border Grid.Row="3"
                x:Name="DiagnosticsPanelBorder"
                Padding="14,6,14,8"
                ClipToBounds="False"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource FluxChromeBackground}"
                BorderBrush="{DynamicResource FluxChromeEdge}"
                BorderThickness="0,1,0,0">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="3">
                <!-- Row 0: Recommendation banners (above the Diagnostics label) -->
                <StackPanel Grid.Row="0" Spacing="4" x:Name="RecommendBannerPanel">
                    <Border IsVisible="{Binding CloudRecommendVisible}"
                            Background="{DynamicResource FluxTintAmberBackground}"
                            BorderBrush="{DynamicResource FluxTintAmberBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,6">
                        <StackPanel Spacing="8">
                            <TextBlock views:MarkedText.Source="{Binding CloudRecommendText}"
                                       TextWrapping="Wrap"
                                       FontSize="{DynamicResource FluxFontSizeBody}" />
                            <TextBlock Text="{Binding RecoveryHarnessRelaunchHint}"
                                       TextWrapping="Wrap"
                                       FontSize="{DynamicResource FluxFontSizeCaption}"
                                       Opacity="0.88"
                                       IsVisible="{Binding RecoveryHarnessRelaunchVisible}" />
                            <WrapPanel>
                                <Button Content="{Binding RecoveryWaitLongerLabel}"
                                        Margin="0,0,8,4"
                                        IsVisible="{Binding RecoveryWaitLongerVisible}"
                                        Command="{Binding ContinueWaitingRecoveryCommand}"
                                        views:MarkedText.Tip="{Binding RecoveryWaitLongerTooltip}" />
                                <Button Content="{Binding RecoveryResumeLabel}"
                                        Margin="0,0,8,4"
                                        Command="{Binding ResumeCurrentModelRecoveryCommand}"
                                        views:MarkedText.Tip="{Binding RecoveryResumeTooltip}" />
                                <Button Content="{Binding RecoverySteerLabel}"
                                        Margin="0,0,8,4"
                                        IsVisible="{Binding RecoverySteerVisible}"
                                        Command="{Binding SteerPortRuleRecoveryCommand}"
                                        views:MarkedText.Tip="{Binding RecoverySteerTooltip}" />
                                <Button Content="{Binding RecoverySwitchLocalLabel}"
                                        Margin="0,0,8,4"
                                        IsVisible="{Binding RecoverySwitchLocalVisible}"
                                        Command="{Binding SwitchRecoveryLocalCommand}"
                                        ToolTip.Tip="{Binding RecoverySwitchLocalTooltip}" />
                                <Button Content="{Binding RecoverySwitchCloudLabel}"
                                        Margin="0,0,8,4"
                                        IsVisible="{Binding RecoverySwitchCloudVisible}"
                                        Command="{Binding ApproveCloudRecommendCommand}"
                                        ToolTip.Tip="{Binding RecoverySwitchCloudTooltip}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border IsVisible="{Binding LocalReloadRecommendVisible}"
                            Background="{Binding LocalReloadRecommendBackgroundBrush}"
                            BorderBrush="{Binding LocalReloadRecommendAccentBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="0"
                            views:MarkedText.Tip="{Binding LocalReloadRecommendTooltip}">
                        <Grid ColumnDefinitions="4,*">
                            <Border Grid.Column="0"
                                    CornerRadius="4,0,0,4"
                                    Background="{Binding LocalReloadRecommendAccentBrush}" />
                            <StackPanel Grid.Column="1" Spacing="8" Margin="8,6">
                                <TextBlock views:MarkedText.Source="{Binding LocalReloadRecommendText}"
                                           TextWrapping="Wrap"
                                           FontSize="{DynamicResource FluxFontSizeBody}" />
                                <WrapPanel>
                                    <Button Content="Compact"
                                            Margin="0,0,8,4"
                                            IsVisible="{Binding LocalReloadCompactVisible}"
                                            IsEnabled="{Binding CompactionControlsEnabled}"
                                            Command="{Binding CompactLocalReloadRecommendCommand}"
                                            ToolTip.Tip="Compact: shorten the older turns that AI-FluxMux forwards to the local model so the current turn fits in the loaded Context." />
                                    <Button Content="Load suggested model profile"
                                            Margin="0,0,8,4"
                                            IsVisible="{Binding LocalReloadLoadVisible}"
                                            Command="{Binding ApproveLocalReloadRecommendCommand}"
                                            views:MarkedText.Tip="Unload the model profile that is running now and start the suggested model profile named in the blue note." />
                                    <Button Content="Keep current model for now"
                                            Margin="0,0,8,4"
                                            Command="{Binding DeclineLocalReloadRecommendCommand}"
                                            ToolTip.Tip="Keep the local model profile that is already loaded. Hide this suggestion for 15 minutes." />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border IsVisible="{Binding HealthReportVisible}"
                            Background="{DynamicResource FluxTintAmberBackground}"
                            BorderBrush="{DynamicResource FluxTintAmberBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,6">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Content="Dismiss"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding DismissHealthReportCommand}"
                                    views:MarkedText.Tip="Hide this health note. Click **Health** again if you want a fresh check." />
                            <TextBlock views:MarkedText.Source="{Binding HealthReportText}"
                                       TextWrapping="Wrap"
                                       FontSize="{DynamicResource FluxFontSizeBody}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Border IsVisible="{Binding MemoryGuardWarningBannerVisible}"
                            Background="{DynamicResource FluxTintAmberBackground}"
                            BorderBrush="{DynamicResource FluxTintAmberBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,6"
                            views:MarkedText.Tip="{Binding MemoryGuardWarningBannerTooltip}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding MemoryGuardWarningBannerText}"
                                       TextWrapping="Wrap"
                                       FontSize="{DynamicResource FluxFontSizeBody}" />
                            <WrapPanel>
                                <Button Content="Stop model now"
                                        Margin="0,0,8,4"
                                        Command="{Binding StopModelFromMemoryGuardWarningCommand}"
                                        ToolTip.Tip="Proactively stop the local model to free up RAM. Your task is safe in the Client app; launch the model (or send a message) to continue." />
                                <Button Content="Dismiss"
                                        Margin="0,0,8,4"
                                        Command="{Binding DismissMemoryGuardWarningBannerCommand}"
                                        ToolTip.Tip="Hide this warning. The model keeps running; if free RAM drops below 4 GiB the memory guard will stop it." />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border IsVisible="{Binding ParkedTaskBannerVisible}"
                            Background="{DynamicResource FluxTintAmberBackground}"
                            BorderBrush="{DynamicResource FluxTintAmberBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,6"
                            views:MarkedText.Tip="{Binding ParkedTaskBannerTooltip}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding ParkedTaskBannerText}"
                                       TextWrapping="Wrap"
                                       FontSize="{DynamicResource FluxFontSizeBody}" />
                            <WrapPanel>
                                <Button Content="Dismiss"
                                        Margin="0,0,8,4"
                                        Command="{Binding DismissParkedTaskBannerCommand}"
                                        ToolTip.Tip="Hide this notice. Your task is safe in the Client app; launch the model (or send a message) to continue." />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border IsVisible="{Binding HailMaryBannerVisible}"
                            Background="{Binding HailMaryBannerBackgroundBrush}"
                            BorderBrush="{Binding HailMaryBannerAccentBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,6"
                            views:MarkedText.Tip="{Binding HailMaryBannerTooltip}">
                        <StackPanel Spacing="8">
                            <TextBlock views:MarkedText.Source="{Binding HailMaryBannerText}"
                                       TextWrapping="Wrap"
                                       FontSize="{DynamicResource FluxFontSizeBody}" />
                            <WrapPanel>
                                <Button Content="📝 Chat handover brief"
                                        Margin="0,0,8,4"
                                        FontFamily="Segoe UI Emoji, Segoe UI, Arial"
                                        Command="{Binding ChatHandoverBriefCommand}"
                                        ToolTip.Tip="Prepares a brief of this chat to paste as the first message of a new chat: copy it or save it from the notice that appears." />
                                <Button Content="🙏&#xFE0E; Hail Mary: rebuild this chat"
                                        Margin="0,0,8,4"
                                        FontFamily="Segoe UI Emoji, Segoe UI, Arial"
                                        Command="{Binding RunHailMaryCommand}"
                                        ToolTip.Tip="Rebuilds this chat in the Client app's own files (Cline, Harness): the older part becomes a summary, the newest messages stay word for word, and about 40 % of the Context is left free. A backup of the original is kept. Then type retry." />
                                <Button Content="Dismiss"
                                        Margin="0,0,8,4"
                                        Command="{Binding DismissHailMaryBannerCommand}"
                                        ToolTip.Tip="Hide this suggestion." />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border IsVisible="{Binding HandoverBriefBannerVisible}"
                            Background="{DynamicResource FluxTintAmberBackground}"
                            BorderBrush="{DynamicResource FluxTintAmberBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,6">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding HandoverBriefBannerText}"
                                       TextWrapping="Wrap"
                                       FontSize="{DynamicResource FluxFontSizeBody}" />
                            <WrapPanel>
                                <Button Content="📋 Copy to clipboard"
                                        Margin="0,0,8,4"
                                        FontFamily="Segoe UI Emoji, Segoe UI, Arial"
                                        IsVisible="{Binding HandoverBriefCanSave}"
                                        Command="{Binding CopyHandoverBriefCommand}"
                                        ToolTip.Tip="Copies the brief, as the Include box shows it, ready to paste as the first message of a new chat." />
                                <Button Content="💾 Save to file…"
                                        Margin="0,0,8,4"
                                        FontFamily="Segoe UI Emoji, Segoe UI, Arial"
                                        IsVisible="{Binding HandoverBriefCanSave}"
                                        Command="{Binding SaveHandoverBriefCommand}"
                                        ToolTip.Tip="Saves the brief as a Markdown file where you choose (it starts in the Hand over briefs folder beside the AI-FluxMux config): to park a task for later, or for an agent chat to read the file instead of a paste." />
                                <CheckBox Content="Include your final message"
                                          Margin="0,0,8,4"
                                          VerticalAlignment="Center"
                                          FontSize="{DynamicResource FluxFontSizeBody}"
                                          IsVisible="{Binding HandoverBriefHasLastMessage}"
                                          IsChecked="{Binding HandoverBriefIncludeLastMessage}"
                                          ToolTip.Tip="Your final message may be what killed the chat: if it was huge, or set off runaway context use, sending it again in a new chat may repeat the overflow there. It starts unticked when the chat was refused as too large after it. Copy and Save use what this box shows; the Diagnostics log keeps the full brief, and Save to file saves a left-out message beside the brief so you can review or edit it." />
                                <Button Content="Dismiss"
                                        Margin="0,0,8,4"
                                        Command="{Binding DismissHandoverBriefBannerCommand}"
                                        ToolTip.Tip="Hide this notice. The brief is kept: press Chat handover brief to copy it or show this notice again." />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border IsVisible="{Binding DocumentContextDialogVisible}"
                            Background="{DynamicResource FluxTintAmberBackground}"
                            BorderBrush="{DynamicResource FluxTintAmberBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,6">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding DocumentContextDialogText}"
                                       TextWrapping="Wrap"
                                       FontSize="{DynamicResource FluxFontSizeBody}" />
                            <WrapPanel>
                                <Button Content="Full fidelity, this turn only"
                                        Margin="0,0,8,4"
                                        Command="{Binding DocumentContextFullThisTurnCommand}"
                                        ToolTip.Tip="Read the whole document at full precision. It will run in ordinary memory (slower) for this turn. Next turn, older parts may be compacted to return to the fast card." />
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,8,4" VerticalAlignment="Center">
                                    <Button Content="Full fidelity, keep for"
                                            Command="{Binding DocumentContextFullNTurnsCommand}"
                                            ToolTip.Tip="Keep the whole document in context for the next N turns, then compact. Slower for N turns, but the model remembers the document." />
                                    <NumericUpDown Minimum="1" Maximum="20"
                                                   Value="{Binding DocumentContextKeepTurns}"
                                                   ToolTip.Tip="How many turns to keep the document at full precision." />
                                    <TextBlock Text="turns" VerticalAlignment="Center" FontSize="{DynamicResource FluxFontSizeBody}" />
                                </StackPanel>
                                <Button Content="Summarize the document"
                                        Margin="0,0,8,4"
                                        Command="{Binding DocumentContextSummarizeCommand}"
                                        ToolTip.Tip="Create a compact summary that fits in graphics memory. This may lose important details — good if you just need the gist, risky if you need precise answers. The full document is kept in this Client app." />
                                <Button Content="Cancel this turn"
                                        Margin="0,0,8,4"
                                        Command="{Binding DocumentContextCancelCommand}"
                                        ToolTip.Tip="Don't send this turn. You can break the document into smaller pieces or try a different approach." />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border IsVisible="{Binding RecoveryReplacementVisible}"
                            Background="{DynamicResource FluxMutedBackground}"
                            BorderBrush="{DynamicResource FluxMutedBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,6">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           FontSize="{DynamicResource FluxFontSizeBody}"
                                           Text="Or choose a different model" />
                                <ComboBox x:Name="RecoveryReplacementChooser"
                                          Grid.Column="1"
                                          ItemsSource="{Binding RecoveryReplacementOptions}"
                                          SelectedItem="{Binding SelectedRecoveryReplacement}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="2"
                                        Content="Switch to selected"
                                        VerticalAlignment="Center"
                                        Command="{Binding ApplyRecoveryReplacementCommand}"
                                        ToolTip.Tip="Load or route to the model you picked. The note says whether this Client-app chat can continue." />
                            </Grid>
                            <TextBlock Text="{Binding RecoveryReplacementAdvice}"
                                       TextWrapping="Wrap"
                                       FontSize="{DynamicResource FluxFontSizeCaption}"
                                       Opacity="0.88" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Row 1: Diagnostics label + controls -->
                <StackPanel Grid.Row="1" Spacing="4">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6" ClipToBounds="False" VerticalAlignment="Top">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Diagnostics" />
                        <shapes:Ellipse Grid.Column="1"
                                        Width="14"
                                        Height="14"
                                        VerticalAlignment="Center"
                                        Margin="4,0,8,0"
                                        Fill="{Binding ActiveRouteStatusBrush}"
                                        Opacity="{Binding ActiveRouteStatusOpacity}"
                                        Stroke="#344054"
                                        StrokeThickness="1"
                                        ToolTip.Tip="{Binding ActiveRouteStatusTooltip}" />
                        <TextBlock Grid.Column="2"
                                   FontSize="{DynamicResource FluxFontSizeBody}"
                                   VerticalAlignment="Center"
                                   ClipToBounds="True"
                                   Text="{Binding ActiveRouteStatusLabel}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding ActiveRouteStatusTooltip}" />
                        <TextBlock Grid.Column="3"
                                   FontSize="{DynamicResource FluxFontSizeBody}"
                                   Opacity="0.8"
                                   Margin="8,0,4,0"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap"
                                   Text="{Binding ActiveClientAppText}"
                                   IsVisible="{Binding ActiveClientAppText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   ToolTip.Tip="{Binding ActiveClientAppTooltip}" />
                        <Button Grid.Row="0" Grid.Column="4"
                                x:Name="HailMaryButton"
                                Classes="hailMary"
                                IsEnabled="{Binding HailMaryButtonEnabled}"
                                MinWidth="180"
                                MinHeight="32"
                                VerticalAlignment="Top"
                                VerticalContentAlignment="Center"
                                FontFamily="Segoe UI Emoji, Segoe UI, Arial"
                                FontSize="{DynamicResource FluxFontSizeBody}"
                                Content="🙏&#xFE0E; Hail Mary"
                                Background="#1A1A1A"
                                Foreground="White"
                                BorderBrush="#333333"
                                Command="{Binding RunHailMaryCommand}"
                                ToolTip.Tip="Use when a chat is stuck: refused as too large, or the Client app no longer answers or will not reopen it.&#10;&#10;One press rebuilds the chat in the Client app&#x27;s own files: the older part becomes a summary (your opening request and earlier messages, decisions, values found, files changed), the newest messages stay word for word, and about 40 % of the Context is left free for your retried message and the reply. The original is backed up first. Then type retry (for Cline, close and reopen the chat first).&#10;&#10;Built in for Cline and Harness; other Client apps can be added under RescueAdapters in fluxmux_config.json. For any other Client app, the press prepares a hand over brief instead, copied and shown in the Diagnostics log, to paste into a new chat." />
                        <TextBlock Grid.Row="1" Grid.Column="4"
                                   IsVisible="{Binding HailMaryOutcome, Converter={StaticResource StringToVisibility}}"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0"
                                   FontSize="{DynamicResource FluxFontSizeSmall}"
                                   Foreground="#E5E7EB"
                                   Opacity="0.9"
                                   MaxWidth="{DynamicResource FluxSideNoteMaxWidth}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding HailMaryOutcome}"
                                   Text="{Binding HailMaryOutcome}" />
                        <Button Grid.Row="0" Grid.Column="5"
                                x:Name="GitCheckpointButton"
                                MinWidth="100"
                                MinHeight="32"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                FontFamily="Segoe UI Emoji, Segoe UI, Arial"
                                FontSize="{DynamicResource FluxFontSizeBody}"
                                Content="📌 Checkpoint"
                                Background="#1A1A1A"
                                Foreground="White"
                                BorderBrush="#333333"
                                Click="GitCheckpointButton_Click"
                                ToolTip.Tip="Creates a git checkpoint in the workspace. This is a safety net: if the model goes off the rails, you can reset to this checkpoint.&#10;&#10;The checkpoint is a git commit with a message like 'fluxmux-checkpoint: manual checkpoint' so it's easy to find and reset to later." />
                        <Button Grid.Row="0" Grid.Column="6"
                                x:Name="HandoverBriefButton"
                                MinHeight="32"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                FontFamily="Segoe UI Emoji, Segoe UI, Arial"
                                FontSize="{DynamicResource FluxFontSizeBody}"
                                Content="📝 Chat handover brief"
                                Background="#1A1A1A"
                                Foreground="White"
                                BorderBrush="#333333"
                                Command="{Binding ChatHandoverBriefCommand}"
                                ToolTip.Tip="Prepares a brief of the stuck or latest chat (from whichever Client app) to paste as the first message of a new chat: the opening request and the latest turns word for word, the rest summarised. It is kept in Hand over briefs\Latest hand over brief.md and shown in full in the Diagnostics log; copy it or save it from the notice that appears.&#10;&#10;The button pulses green while a brief has not been copied yet. Press it again to copy the brief, copy its file location, show the notice again, or brief another chat.&#10;&#10;Use it to carry on after a chat is stuck, to move the task to another Client app or model, or to park a task for later." />
                        <Popup Grid.Row="0" x:Name="HandoverBriefMenu"
                               IsOpen="{Binding HandoverBriefMenuOpen, Mode=TwoWay}"
                               IsLightDismissEnabled="True"
                               PlacementTarget="{Binding ElementName=HandoverBriefButton}"
                               Placement="Bottom">
                            <Border Background="{DynamicResource FluxPaneBackground}"
                                    BorderBrush="{DynamicResource FluxMutedBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8">
                                <StackPanel Spacing="6">
                                    <!-- Width follows the widest button, so the notes wrap instead of widening the menu. -->
                                    <TextBlock Text="{Binding HandoverKeptBriefCaption}" TextWrapping="Wrap"
                                               Width="{Binding #ShowBriefButton.Bounds.Width}" HorizontalAlignment="Left" />
                                    <Border Padding="8,6" CornerRadius="5" BorderThickness="1"
                                            BorderBrush="{DynamicResource FluxTintAmberBorder}" Background="{DynamicResource FluxTintAmberBackground}"
                                            Width="{Binding #ShowBriefButton.Bounds.Width}" HorizontalAlignment="Left"
                                            IsVisible="{Binding HandoverKeptBriefNewerNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="{Binding HandoverKeptBriefNewerNote}" TextWrapping="Wrap" />
                                    </Border>
                                    <Button Content="📋 Copy latest brief to clipboard" HorizontalAlignment="Stretch"
                                            FontFamily="Segoe UI Emoji, Segoe UI, Arial"
                                            Command="{Binding CopyHandoverBriefCommand}" />
                                    <Button Content="📁 Copy brief file location to clipboard" HorizontalAlignment="Stretch"
                                            FontFamily="Segoe UI Emoji, Segoe UI, Arial"
                                            Command="{Binding CopyHandoverBriefLocationCommand}"
                                            ToolTip.Tip="{Binding LatestBriefPath}" />
                                    <Button x:Name="ShowBriefButton" Content="📄 Show the brief in the Diagnostics log, with its options" HorizontalAlignment="Stretch"
                                            FontFamily="Segoe UI Emoji, Segoe UI, Arial"
                                            Command="{Binding ShowHandoverBriefOptionsCommand}"
                                            ToolTip.Tip="Writes the brief into the Diagnostics log, as it would be copied (with or without your final message, as the tick box says), and shows Copy, Save and the tick box again." />
                                    <ItemsControl ItemsSource="{Binding HandoverChatChoices}"
                                                  IsVisible="{Binding HandoverBriefHasNewChats}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:HandoverChatChoice">
                                                <Button Content="{Binding Label}" HorizontalAlignment="Stretch" Margin="0,2,0,0"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).CreateHandoverBriefFromCommand}"
                                                        CommandParameter="{Binding Key}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Popup>
                        </Grid>
                    <TextBlock FontSize="{DynamicResource FluxFontSizeCaption}"
                               Opacity="0.78"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding LastRouteExplanationText}"
                               IsVisible="{Binding ShowLastRouteExplanationText}"
                               ToolTip.Tip="Settings for the loaded model profile that the name row does not show: Images, Reasoning, Context, GPU, temperature, and max tokens. Compact is for the last Client-app turn on this model." />
                    <Border Background="#101828"
                            BorderBrush="#344054"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,6">
                        <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="10">
                            <ContentControl Grid.Column="0"
                                            Content="{Binding GpuVramGauge}"
                                            ContentTemplate="{StaticResource LiveUtilizationGaugeTemplate}" />
                            <ContentControl Grid.Column="1"
                                            Content="{Binding GpuUtilGauge}"
                                            ContentTemplate="{StaticResource LiveUtilizationGaugeTemplate}" />
                            <ContentControl Grid.Column="2"
                                            Content="{Binding RamGauge}"
                                            ContentTemplate="{StaticResource LiveUtilizationGaugeTemplate}" />
                            <ContentControl Grid.Column="3"
                                            Content="{Binding CpuGauge}"
                                            ContentTemplate="{StaticResource LiveUtilizationGaugeTemplate}" />
                            <ContentControl Grid.Column="4"
                                            Content="{Binding ContextGauge}"
                                            ContentTemplate="{StaticResource LiveUtilizationGaugeTemplate}" />
                        </Grid>
                    </Border>
                    </StackPanel>
                    <!-- Live telemetry graph (context-fill stress test, launch progress, etc.).
                         Plots time-series or curve data. Points are added incrementally as data
                         arrives, and the graph updates live. -->
                    <Grid Grid.Row="2" RowSpacing="4" ClipToBounds="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="GraphTerminalGrid"
                              Grid.Row="0"
                              ColumnDefinitions="*,Auto,*"
                              ClipToBounds="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border x:Name="GraphPaneBorder" Grid.Column="0"
                                    ClipToBounds="True"
                                    Background="#101828"
                                    BorderBrush="#344054"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,6">
                        <Grid RowSpacing="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <!-- TTFT plot area: * with a light MinHeight so it never collapses
                                     to zero when the diagnostics panel is small, without forcing
                                     the panel taller than the default split allows. -->
                                <RowDefinition Height="*" MinHeight="60" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <!-- Throughput plot area: * with a light MinHeight. -->
                                <RowDefinition Height="*" MinHeight="60" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- Title bar -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding TelemetryGraph.Title}"
                                           FontSize="{DynamicResource FluxFontSizeCaption}"
                                           FontWeight="SemiBold"
                                           Foreground="#E4E7EC"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TelemetryGraph.SummaryText}"
                                           FontSize="{DynamicResource FluxFontSizeSmall}"
                                           Opacity="0.72"
                                           Foreground="#D0D5DD"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <!-- Plot area with axes. Wrapped in a Panel so the "No telemetry"
                                 placeholder can overlay the plot area (centered on top of it)
                                 instead of occupying its own grid row. The plot area is visible
                                 when there are data points (HasPoints), NOT when the graph is
                                 "active" (IsActive). This is critical: after a stress test
                                 completes, Deactivate() sets IsActive=false (so the "No telemetry"
                                 placeholder can reappear when the graph is empty), but the plot
                                 area must stay visible to show the test's data points. Binding to
                                 HasPoints keeps the plot visible while data exists, and hides it
                                 (showing the placeholder) only when the graph is truly empty. -->
                            <Panel Grid.Row="1">
                            <Grid
                                  RowDefinitions="*,Auto"
                                  ColumnDefinitions="Auto,*"
                                  IsVisible="{Binding TelemetryGraph.IsPlotVisible}">
                                <!-- Y-axis labels + tick marks (left column). Positioned by code-behind
                                     at 0/25/50/75/100% of the plot height. The tick marks project
                                     outward (leftward) from the plot edge; the numbers are right-aligned
                                     against the ticks and centered on them. No top/bottom margin so the
                                     canvas height matches the plot area exactly. -->
                                <Canvas x:Name="TtftYAxisLabelCanvas"
                                        Grid.Row="0" Grid.Column="0"
                                        Width="32"
                                        Margin="0,0,0,0"
                                        IsHitTestVisible="False"
                                        ToolTip.Tip="{Binding TelemetryGraph.YAxisTooltip}">
                                    <TextBlock x:Name="TtftYLabelMax"
                                               FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Right"
                                               IsVisible="False" />
                                    <TextBlock x:Name="TtftYLabel75"
                                               FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Right"
                                               IsVisible="False" />
                                    <TextBlock x:Name="TtftYLabel50"
                                               FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Right"
                                               IsVisible="False" />
                                    <TextBlock x:Name="TtftYLabel25"
                                               FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Right"
                                               IsVisible="False" />
                                    <TextBlock x:Name="TtftYLabelMin"
                                               FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Right"
                                               IsVisible="False" />
                                    <!-- Tick marks: short horizontal lines projecting outward (leftward)
                                         from the plot edge. Positioned by code-behind. -->
                                    <Rectangle x:Name="TtftYTick0" Height="1" Fill="#475569" Width="4" IsVisible="False" />
                                    <Rectangle x:Name="TtftYTick1" Height="1" Fill="#475569" Width="4" IsVisible="False" />
                                    <Rectangle x:Name="TtftYTick2" Height="1" Fill="#475569" Width="4" IsVisible="False" />
                                    <Rectangle x:Name="TtftYTick3" Height="1" Fill="#475569" Width="4" IsVisible="False" />
                                    <Rectangle x:Name="TtftYTick4" Height="1" Fill="#475569" Width="4" IsVisible="False" />
                                </Canvas>
                                <!-- Plot area -->
                                <Border x:Name="TtftPlotBorder" Grid.Row="0" Grid.Column="1"
                                        Background="#0F172A"
                                        BorderBrush="#344054"
                                        BorderThickness="1">
                                    <Grid Background="#1A34D399">
                                        <!-- Grid lines -->
                                        <Grid RowDefinitions="*,*,*,*,*" ColumnDefinitions="*,*,*,*,*">
                                            <Rectangle Grid.Row="0" Grid.ColumnSpan="5" Height="1" Fill="#1E293B" VerticalAlignment="Top" />
                                            <Rectangle Grid.Row="1" Grid.ColumnSpan="5" Height="1" Fill="#1E293B" VerticalAlignment="Top" />
                                            <Rectangle Grid.Row="2" Grid.ColumnSpan="5" Height="1" Fill="#1E293B" VerticalAlignment="Top" />
                                            <Rectangle Grid.Row="3" Grid.ColumnSpan="5" Height="1" Fill="#1E293B" VerticalAlignment="Top" />
                                            <Rectangle Grid.Row="4" Grid.ColumnSpan="5" Height="1" Fill="#1E293B" VerticalAlignment="Top" />
                                            <Rectangle Grid.Column="0" Grid.RowSpan="5" Width="1" Fill="#1E293B" HorizontalAlignment="Left" />
                                            <Rectangle Grid.Column="1" Grid.RowSpan="5" Width="1" Fill="#1E293B" HorizontalAlignment="Left" />
                                            <Rectangle Grid.Column="2" Grid.RowSpan="5" Width="1" Fill="#1E293B" HorizontalAlignment="Left" />
                                            <Rectangle Grid.Column="3" Grid.RowSpan="5" Width="1" Fill="#1E293B" HorizontalAlignment="Left" />
                                            <Rectangle Grid.Column="4" Grid.RowSpan="5" Width="1" Fill="#1E293B" HorizontalAlignment="Left" />
                                        </Grid>
                                        <!-- Untested-region: dotted vertical line at the boundary + hatched fill to the right edge.
                                             Replaces the old solid red rectangle, which was misleading (looked like a data bar). -->
                                        <Viewbox Stretch="Fill">
                                            <Path Data="{Binding TelemetryGraph.UnfilledRegionGeometry}"
                                                  IsVisible="{Binding TelemetryGraph.HasUnfilledRegion}"
                                                  Width="100" Height="100">
                                                <Path.Fill>
                                                    <DrawingBrush TileMode="Tile" Opacity="0.30"
                                                                  Transform="scale(0.08)">
                                                        <DrawingBrush.Drawing>
                                                            <GeometryDrawing Brush="#EF4444"
                                                                              Geometry="M0,8 L8,0 M-2,2 L2,-2 M6,10 L10,6" />
                                                        </DrawingBrush.Drawing>
                                                    </DrawingBrush>
                                                </Path.Fill>
                                            </Path>
                                        </Viewbox>
                                        <Viewbox Stretch="Fill">
                                            <Path Data="{Binding TelemetryGraph.UnfilledRegionLineGeometry}"
                                                  IsVisible="{Binding TelemetryGraph.HasUnfilledRegion}"
                                                  Stroke="#EF4444" StrokeThickness="1.5" StrokeDashArray="4,4"
                                                  Width="100" Height="100" />
                                        </Viewbox>
                                        <!-- Progressive "testing" bar (grows from baseline as prefill progress is reported).
                                             Dimmer than the finalized data bars to make clear no data has been obtained yet.
                                             Pulses (opacity oscillates) to indicate "in progress" (driven by the code-behind timer). -->
                                        <Viewbox Stretch="Fill">
                                            <Path x:Name="TtftTestingBarPath"
                                                  Data="{Binding TelemetryGraph.TestingBarPath}"
                                                  IsVisible="{Binding TelemetryGraph.IsTestingBandVisible}"
                                                  Fill="#34D399"
                                                  Opacity="0.45"
                                                  Width="100" Height="100" />
                                        </Viewbox>
                                        <!-- Data bars + ghost tick marks in the same Viewbox (shared 100×100
                                             coordinate space ensures ghost lines align with bar positions). -->
                                        <Viewbox Stretch="Fill">
                                            <Canvas Width="100" Height="100">
                                                <Path Data="{Binding TelemetryGraph.BarPathData}"
                                                      IsVisible="{Binding TelemetryGraph.HasPoints}"
                                                      Fill="#34D399" />
                                                <Path Data="{Binding TelemetryGraph.FailureBarPathData}"
                                                      IsVisible="{Binding TelemetryGraph.HasPoints}"
                                                      Stroke="#EF4444" StrokeThickness="1.5"
                                                      StrokeDashArray="0.5,0.5" Fill="Transparent"
                                                      Opacity="0.9" />
                                                <Path Data="{Binding TelemetryGraph.GhostBarGeometry}"
                                                      IsVisible="{Binding TelemetryGraph.HasGhostBars}"
                                                      Stroke="#94A3B8" StrokeThickness="1.0"
                                                      StrokeDashArray="0.5,0.5" Fill="Transparent"
                                                      Opacity="0.85" />
                                            </Canvas>
                                        </Viewbox>
                                        <!-- Bar value labels: overlay Canvas (same cell as the Viewbox) using
                                             the same font as axis labels. Positioned by code-behind in pixel space. -->
                                        <Canvas x:Name="TtftBarValueLabelCanvas"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                IsHitTestVisible="False" ClipToBounds="True">
                                            <TextBlock x:Name="TtftBarValue1" Text="{Binding TelemetryGraph.BarValueText1}"
                                                       FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.85" Foreground="#D0D5DD" />
                                            <TextBlock x:Name="TtftBarValue2" Text="{Binding TelemetryGraph.BarValueText2}"
                                                       FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.85" Foreground="#D0D5DD" />
                                            <TextBlock x:Name="TtftBarValue3" Text="{Binding TelemetryGraph.BarValueText3}"
                                                       FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.85" Foreground="#D0D5DD" />
                                            <TextBlock x:Name="TtftBarValue4" Text="{Binding TelemetryGraph.BarValueText4}"
                                                       FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.85" Foreground="#D0D5DD" />
                                            <TextBlock x:Name="TtftBarValue5" Text="{Binding TelemetryGraph.BarValueText5}"
                                                       FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.85" Foreground="#D0D5DD" />
                                            <TextBlock x:Name="TtftBarValue6" Text="{Binding TelemetryGraph.BarValueText6}"
                                                       FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.85" Foreground="#D0D5DD" />
                                        </Canvas>
                                    </Grid>
                                </Border>
                                <!-- Placeholder when no data. Overlays the entire graph panel (centered
                                     on top of the Border) rather than occupying its own grid row or
                                     sitting inside the Border. This prevents the text from being
                                     clipped by the Border's ClipToBounds when the panel is dragged
                                     up. Shown when the plot is NOT visible (IsPlotVisible=false),
                                     hidden when the plot is visible (during a test OR after a test
                                     with data). -->
                                <TextBlock Grid.ColumnSpan="3"
                                           Text="No telemetry"
                                           FontSize="{DynamicResource FluxFontSizeCaption}"
                                           Opacity="0.5"
                                           Foreground="#D0D5DD"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding TelemetryGraph.IsPlotVisible, Converter={x:Static vm:InvertBoolToVisibilityConverter.Instance}}" />
                                <!-- X-axis labels (bottom row): a fixed pool of 16 static TextBlocks,
                                     one per fill level (up to 16). The code-behind shows/hides and
                                     positions them on each timer tick using the XAxisLabels
                                     collection. Static TextBlocks are always measured before
                                     positioning, so centering is correct (same pattern as the
                                     bar-value labels). -->
                                <Canvas x:Name="TtftXAxisLabelCanvas"
                                        Grid.Row="1" Grid.Column="1"
                                        Height="11"
                                        Margin="0,-6,0,0"
                                        ClipToBounds="True">
                                    <!-- Match the Y-axis tick label style (FontSize 9, Opacity 0.72,
                                         #D0D5DD, Normal weight) so both axes read consistently. -->
                                    <TextBlock x:Name="TtftXLabel1" FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD" VerticalAlignment="Top" />
                                    <TextBlock x:Name="TtftXLabel2" FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD" VerticalAlignment="Top" />
                                    <TextBlock x:Name="TtftXLabel3" FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD" VerticalAlignment="Top" />
                                    <TextBlock x:Name="TtftXLabel4" FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD" VerticalAlignment="Top" />
                                    <TextBlock x:Name="TtftXLabel5" FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD" VerticalAlignment="Top" />
                                    <TextBlock x:Name="TtftXLabel6" FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD" VerticalAlignment="Top" />
                                    <TextBlock x:Name="TtftXLabel7" FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD" VerticalAlignment="Top" />
                                    <TextBlock x:Name="TtftXLabel8" FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD" VerticalAlignment="Top" />
                                    <TextBlock x:Name="TtftXLabel9" FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD" VerticalAlignment="Top" />
                                    <TextBlock x:Name="TtftXLabel10" FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD" VerticalAlignment="Top" />
                                    <TextBlock x:Name="TtftXLabel11" FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD" VerticalAlignment="Top" />
                                    <TextBlock x:Name="TtftXLabel12" FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD" VerticalAlignment="Top" />
                                    <TextBlock x:Name="TtftXLabel13" FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD" VerticalAlignment="Top" />
                                    <TextBlock x:Name="TtftXLabel14" FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD" VerticalAlignment="Top" />
                                    <TextBlock x:Name="TtftXLabel15" FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD" VerticalAlignment="Top" />
                                    <TextBlock x:Name="TtftXLabel16" FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD" VerticalAlignment="Top" />
                                </Canvas>
                            </Grid>
                            </Panel>
                            <!-- Axis titles. Hidden when the plot is not visible. -->
                            <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="4"
                                  IsVisible="{Binding TelemetryGraph.IsPlotVisible}">
                                <!-- Y-axis label is now redundant: the graph title ("TTFT (s)")
                                     serves as the y-axis heading. Hidden to avoid duplication. -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding TelemetryGraph.YLabel}"
                                           FontSize="{DynamicResource FluxFontSizeSmall}"
                                           Opacity="0.72"
                                           Foreground="#D0D5DD"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           IsVisible="False" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TelemetryGraph.XLabel}"
                                           FontSize="{DynamicResource FluxFontSizeSmall}"
                                           FontWeight="SemiBold"
                                           Foreground="#E4E7EC"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <!-- Throughput graph (tok/s) -->
                            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding TelemetryGraphThroughput.Title}"
                                           FontSize="{DynamicResource FluxFontSizeCaption}"
                                           FontWeight="SemiBold"
                                           Foreground="#E4E7EC"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TelemetryGraphThroughput.SummaryText}"
                                           FontSize="{DynamicResource FluxFontSizeSmall}"
                                           Opacity="0.72"
                                           Foreground="#D0D5DD"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <!-- Throughput graph plot area. Wrapped in a Panel so the "No telemetry"
                                 placeholder can overlay the plot area (centered on top of it) when the
                                 graph is empty, matching the TTFT graph's placeholder. -->
                            <Panel Grid.Row="4">
                            <Grid
                                  RowDefinitions="*,Auto"
                                  ColumnDefinitions="Auto,*"
                                  IsVisible="{Binding TelemetryGraphThroughput.IsPlotVisible}">
                                <!-- Y-axis labels + tick marks. Positioned by code-behind at
                                     0/25/50/75/100% of the plot height. The tick marks project
                                     outward (leftward) from the plot edge; the numbers are right-aligned
                                     against the ticks and centered on them. -->
                                <Canvas x:Name="ThroughputYAxisLabelCanvas"
                                        Grid.Row="0" Grid.Column="0"
                                        Width="32"
                                        Margin="0,0,0,0"
                                        IsHitTestVisible="False">
                                    <TextBlock x:Name="ThroughputYLabelMax"
                                               FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Right"
                                               IsVisible="False" />
                                    <TextBlock x:Name="ThroughputYLabel75"
                                               FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Right"
                                               IsVisible="False" />
                                    <TextBlock x:Name="ThroughputYLabel50"
                                               FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Right"
                                               IsVisible="False" />
                                    <TextBlock x:Name="ThroughputYLabel25"
                                               FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Right"
                                               IsVisible="False" />
                                    <TextBlock x:Name="ThroughputYLabelMin"
                                               FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Right"
                                               IsVisible="False" />
                                    <!-- Tick marks: short horizontal lines projecting outward (leftward)
                                         from the plot edge. Positioned by code-behind. -->
                                    <Rectangle x:Name="ThroughputYTick0" Height="1" Fill="#475569" Width="4" IsVisible="False" />
                                    <Rectangle x:Name="ThroughputYTick1" Height="1" Fill="#475569" Width="4" IsVisible="False" />
                                    <Rectangle x:Name="ThroughputYTick2" Height="1" Fill="#475569" Width="4" IsVisible="False" />
                                    <Rectangle x:Name="ThroughputYTick3" Height="1" Fill="#475569" Width="4" IsVisible="False" />
                                    <Rectangle x:Name="ThroughputYTick4" Height="1" Fill="#475569" Width="4" IsVisible="False" />
                                </Canvas>
                                <!-- Plot area -->
                                <Border x:Name="ThroughputPlotBorder" Grid.Row="0" Grid.Column="1"
                                        Background="#0F172A"
                                        BorderBrush="#344054"
                                        BorderThickness="1">
                                    <Grid Background="#1A34D399">
                                        <!-- Grid lines -->
                                        <Grid RowDefinitions="*,*,*,*,*" ColumnDefinitions="*,*,*,*,*">
                                            <Rectangle Grid.Row="0" Grid.ColumnSpan="5" Height="1" Fill="#1E293B" VerticalAlignment="Top" />
                                            <Rectangle Grid.Row="1" Grid.ColumnSpan="5" Height="1" Fill="#1E293B" VerticalAlignment="Top" />
                                            <Rectangle Grid.Row="2" Grid.ColumnSpan="5" Height="1" Fill="#1E293B" VerticalAlignment="Top" />
                                            <Rectangle Grid.Row="3" Grid.ColumnSpan="5" Height="1" Fill="#1E293B" VerticalAlignment="Top" />
                                            <Rectangle Grid.Row="4" Grid.ColumnSpan="5" Height="1" Fill="#1E293B" VerticalAlignment="Top" />
                                            <Rectangle Grid.Column="0" Grid.RowSpan="5" Width="1" Fill="#1E293B" HorizontalAlignment="Left" />
                                            <Rectangle Grid.Column="1" Grid.RowSpan="5" Width="1" Fill="#1E293B" HorizontalAlignment="Left" />
                                            <Rectangle Grid.Column="2" Grid.RowSpan="5" Width="1" Fill="#1E293B" HorizontalAlignment="Left" />
                                            <Rectangle Grid.Column="3" Grid.RowSpan="5" Width="1" Fill="#1E293B" HorizontalAlignment="Left" />
                                            <Rectangle Grid.Column="4" Grid.RowSpan="5" Width="1" Fill="#1E293B" HorizontalAlignment="Left" />
                                        </Grid>
                                        <!-- Untested-region: dotted vertical line at the boundary + hatched fill to the right edge. -->
                                        <Viewbox Stretch="Fill">
                                            <Path Data="{Binding TelemetryGraphThroughput.UnfilledRegionGeometry}"
                                                  IsVisible="{Binding TelemetryGraphThroughput.HasUnfilledRegion}"
                                                  Width="100" Height="100">
                                                <Path.Fill>
                                                    <DrawingBrush TileMode="Tile" Opacity="0.30"
                                                                  Transform="scale(0.08)">
                                                        <DrawingBrush.Drawing>
                                                            <GeometryDrawing Brush="#EF4444"
                                                                              Geometry="M0,8 L8,0 M-2,2 L2,-2 M6,10 L10,6" />
                                                        </DrawingBrush.Drawing>
                                                    </DrawingBrush>
                                                </Path.Fill>
                                            </Path>
                                        </Viewbox>
                                        <Viewbox Stretch="Fill">
                                            <Path Data="{Binding TelemetryGraphThroughput.UnfilledRegionLineGeometry}"
                                                  IsVisible="{Binding TelemetryGraphThroughput.HasUnfilledRegion}"
                                                  Stroke="#EF4444" StrokeThickness="1.5" StrokeDashArray="4,4"
                                                  Width="100" Height="100" />
                                        </Viewbox>
                                        <!-- In-progress "testing" bar: reflects the LIVE tok/s from the gateway's
                                             GenerationSpeedTracker once the first token arrives (before that it's a small
                                             pulsing placeholder). Dimmer than the finalized data bars; pulses to indicate
                                             "in progress" (driven by the code-behind timer). -->
                                        <Viewbox Stretch="Fill">
                                            <Path x:Name="ThroughputTestingBarPath"
                                                  Data="{Binding TelemetryGraphThroughput.TestingBarPath}"
                                                  IsVisible="{Binding TelemetryGraphThroughput.IsTestingBandVisible}"
                                                  Fill="#60A5FA"
                                                  Opacity="0.45"
                                                  Width="100" Height="100" />
                                        </Viewbox>
                                        <!-- Data bars + ghost tick marks in the same Viewbox -->
                                        <Viewbox Stretch="Fill">
                                            <Canvas Width="100" Height="100">
                                                <Path Data="{Binding TelemetryGraphThroughput.BarPathData}"
                                                      IsVisible="{Binding TelemetryGraphThroughput.HasPoints}"
                                                      Fill="#60A5FA" />
                                                <Path Data="{Binding TelemetryGraphThroughput.GhostBarGeometry}"
                                                      IsVisible="{Binding TelemetryGraphThroughput.HasGhostBars}"
                                                      Stroke="#94A3B8" StrokeThickness="1.0"
                                                      StrokeDashArray="0.5,0.5" Fill="Transparent"
                                                      Opacity="0.85" />
                                            </Canvas>
                                        </Viewbox>
                                        <!-- Bar value labels: overlay Canvas using same font as axis labels -->
                                        <Canvas x:Name="ThroughputBarValueLabelCanvas"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                IsHitTestVisible="False" ClipToBounds="True">
                                            <TextBlock x:Name="ThroughputBarValue1" Text="{Binding TelemetryGraphThroughput.BarValueText1}"
                                                       FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.85" Foreground="#D0D5DD" />
                                            <TextBlock x:Name="ThroughputBarValue2" Text="{Binding TelemetryGraphThroughput.BarValueText2}"
                                                       FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.85" Foreground="#D0D5DD" />
                                            <TextBlock x:Name="ThroughputBarValue3" Text="{Binding TelemetryGraphThroughput.BarValueText3}"
                                                       FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.85" Foreground="#D0D5DD" />
                                            <TextBlock x:Name="ThroughputBarValue4" Text="{Binding TelemetryGraphThroughput.BarValueText4}"
                                                       FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.85" Foreground="#D0D5DD" />
                                            <TextBlock x:Name="ThroughputBarValue5" Text="{Binding TelemetryGraphThroughput.BarValueText5}"
                                                       FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.85" Foreground="#D0D5DD" />
                                            <TextBlock x:Name="ThroughputBarValue6" Text="{Binding TelemetryGraphThroughput.BarValueText6}"
                                                       FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.85" Foreground="#D0D5DD" />
                                        </Canvas>
                                    </Grid>
                                </Border>
                                <!-- X-axis labels: a fixed pool of 16 static TextBlocks, one per
                                     fill level (up to 16). Positioned on each timer tick using the
                                     XAxisLabels collection (same pattern as the TTFT graph). -->
                                <Canvas x:Name="ThroughputXAxisLabelCanvas"
                                        Grid.Row="1" Grid.Column="1"
                                        Height="11"
                                        Margin="0,-6,0,0"
                                        ClipToBounds="True">
                                    <!-- Match the Y-axis tick label style (FontSize 9, Opacity 0.72,
                                         #D0D5DD, Normal weight) so both axes read consistently. -->
                                    <TextBlock x:Name="ThroughputXLabel1" FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD" VerticalAlignment="Top" />
                                    <TextBlock x:Name="ThroughputXLabel2" FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD" VerticalAlignment="Top" />
                                    <TextBlock x:Name="ThroughputXLabel3" FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD" VerticalAlignment="Top" />
                                    <TextBlock x:Name="ThroughputXLabel4" FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD" VerticalAlignment="Top" />
                                    <TextBlock x:Name="ThroughputXLabel5" FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD" VerticalAlignment="Top" />
                                    <TextBlock x:Name="ThroughputXLabel6" FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD" VerticalAlignment="Top" />
                                    <TextBlock x:Name="ThroughputXLabel7" FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD" VerticalAlignment="Top" />
                                    <TextBlock x:Name="ThroughputXLabel8" FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD" VerticalAlignment="Top" />
                                    <TextBlock x:Name="ThroughputXLabel9" FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD" VerticalAlignment="Top" />
                                    <TextBlock x:Name="ThroughputXLabel10" FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD" VerticalAlignment="Top" />
                                    <TextBlock x:Name="ThroughputXLabel11" FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD" VerticalAlignment="Top" />
                                    <TextBlock x:Name="ThroughputXLabel12" FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD" VerticalAlignment="Top" />
                                    <TextBlock x:Name="ThroughputXLabel13" FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD" VerticalAlignment="Top" />
                                    <TextBlock x:Name="ThroughputXLabel14" FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD" VerticalAlignment="Top" />
                                    <TextBlock x:Name="ThroughputXLabel15" FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD" VerticalAlignment="Top" />
                                    <TextBlock x:Name="ThroughputXLabel16" FontSize="{DynamicResource FluxFontSizeTiny}" Opacity="0.72" Foreground="#D0D5DD" VerticalAlignment="Top" />
                                </Canvas>
                            </Grid>
                            <!-- Placeholder when no data. Overlays the entire throughput plot area
                                 (centered on top of it). Shown when the plot is NOT visible
                                 (IsPlotVisible=false), hidden when the plot is visible. Mirrors the
                                 TTFT graph's placeholder so both graphs show "No telemetry" when empty. -->
                            <TextBlock Grid.ColumnSpan="3"
                                       Text="No telemetry"
                                       FontSize="{DynamicResource FluxFontSizeCaption}"
                                       Opacity="0.5"
                                       Foreground="#D0D5DD"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding TelemetryGraphThroughput.IsPlotVisible, Converter={x:Static vm:InvertBoolToVisibilityConverter.Instance}}" />
                            </Panel>
                            <!-- Axis titles for throughput graph. Hidden when the plot is not visible. -->
                            <Grid Grid.Row="5" ColumnDefinitions="Auto,*" ColumnSpacing="4"
                                  IsVisible="{Binding TelemetryGraphThroughput.IsPlotVisible}">
                                <!-- Y-axis label is now redundant: the graph title ("(tok/s)")
                                     serves as the y-axis heading. Hidden to avoid duplication. -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding TelemetryGraphThroughput.YLabel}"
                                           FontSize="{DynamicResource FluxFontSizeSmall}"
                                           Opacity="0.72"
                                           Foreground="#D0D5DD"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           IsVisible="False" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TelemetryGraphThroughput.XLabel}"
                                           FontSize="{DynamicResource FluxFontSizeSmall}"
                                           FontWeight="SemiBold"
                                           Foreground="#E4E7EC"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                            </Border>
                            <GridSplitter Grid.Column="1"
                                          Theme="{StaticResource DiagnosticsVerticalSashTheme}"
                                          ResizeDirection="Columns"
                                          VerticalAlignment="Stretch"
                                          ToolTip.Tip="Drag to make the graph or the terminal wider." />
                            <Border Grid.Column="2"
                                    ClipToBounds="True"
                                    Background="#101828"
                                    BorderBrush="#344054"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,6">
                            <TextBox x:Name="DiagnosticTerminal"
                                     Classes="diagnosticTerminal"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                 Text="{Binding DiagnosticTerminalText}"
                                 TextWrapping="Wrap"
                                 FontFamily="Cascadia Mono,Consolas"
                                 FontSize="{DynamicResource FluxFontSizeCaption}"
                                 Foreground="#D1FADF"
                                 Background="Transparent"
                                 BorderBrush="Transparent"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackground">Transparent</SolidColorBrush>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver">Transparent</SolidColorBrush>
                                <SolidColorBrush x:Key="TextControlBackgroundFocused">Transparent</SolidColorBrush>
                                <SolidColorBrush x:Key="TextControlBackgroundDisabled">Transparent</SolidColorBrush>
                                <SolidColorBrush x:Key="TextControlForeground">#D1FADF</SolidColorBrush>
                                <SolidColorBrush x:Key="TextControlForegroundPointerOver">#D1FADF</SolidColorBrush>
                                <SolidColorBrush x:Key="TextControlForegroundFocused">#D1FADF</SolidColorBrush>
                                <SolidColorBrush x:Key="TextControlForegroundDisabled">#D1FADF</SolidColorBrush>
                            </TextBox.Resources>
                        </TextBox>
                        </Border>
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" MinHeight="48">
                            <!-- Full-width prefill/generation indicator: always visible.
                                 Prefill phase: incremental progress bar (0→95% eased, then 100% on first byte).
                                 Generation phase: thin baseline + pulsing dot + elapsed clock + live token count.
                                 Idle: empty bar + "Ready · <speed>" text.
                                 The bar spans the full width of the bottom bar. -->
                            <Grid x:Name="ProgressBarContainer" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <!-- Row 0: the progress bar (spans the terminal panel's width). -->
                                <ProgressBar Grid.Row="0"
                                             Height="4"
                                             Maximum="1"
                                             Value="{Binding PrefillProgress}"
                                             IsIndeterminate="False"
                                             Foreground="#22C55E"
                                             Background="#1E293B"
                                             ToolTip.Tip="{Binding PrefillStatusText}"
                                             HorizontalAlignment="Left">
                                    <ProgressBar.Width>
                                        <MultiBinding Converter="{x:Static vm:MinOfTwoValuesConverter.Instance}">
                                            <Binding ElementName="GraphPaneBorder" Path="Bounds.Width" />
                                            <Binding ElementName="ProgressBarContainer" Path="Bounds.Width" />
                                        </MultiBinding>
                                    </ProgressBar.Width>
                                </ProgressBar>
                                <!-- Row 1: text labels. No width binding here: the row spans the
                                     container, and the divider-resize must not reflow the text.
                                     The ETA sits in the rightmost column (right edge of the row). -->
                                 <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" Margin="0,2,0,0">
                                    <!-- Left text: phase label (prefill status, thinking, generation phase, or idle).
                                         The prefill label pulses (like the generation phase text) so the
                                         user sees live activity while the context is being read. -->
                                    <TextBlock x:Name="PrefillStatusTextBlock" Grid.Column="1"
                                               FontSize="{DynamicResource FluxFontSizeCaption}"
                                               VerticalAlignment="Center"
                                               Text="{Binding PrefillStatusText}"
                                               IsVisible="{Binding IsBottomBarPrefill}" />
                                    <!-- Thinking phase: shown when the model has finished prefilling
                                         and is thinking before generating. The bar keeps running
                                         (driven by the prefill timer) so the user sees activity. -->
                                    <TextBlock x:Name="ThinkingStatusTextBlock" Grid.Column="1"
                                               FontSize="{DynamicResource FluxFontSizeCaption}"
                                               VerticalAlignment="Center"
                                               Text="Thinking…"
                                               IsVisible="{Binding IsBottomBarThinking}" />
                                     <!-- Generation phase: line 1 = "Generating…" + detail (seconds/tokens/speed),
                                          line 2 = ETA. Vertical layout so the ETA sits on its own line
                                          below the detail text instead of overlapping it. -->
                                     <StackPanel Grid.Column="1"
                                                 Orientation="Vertical"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Left"
                                                 IsVisible="{Binding IsBottomBarGenerate}">
                                         <StackPanel Orientation="Horizontal">
                                             <TextBlock x:Name="GenerationPhaseTextBlock"
                                                        FontSize="{DynamicResource FluxFontSizeCaption}"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding GenerationPhaseText}" />
                                             <TextBlock FontSize="{DynamicResource FluxFontSizeCaption}"
                                                        VerticalAlignment="Center"
                                                        Margin="8,0,0,0"
                                                        Text="{Binding GenerationDetailText}" />
                                         </StackPanel>
                                         <TextBlock FontSize="{DynamicResource FluxFontSizeCaption}"
                                                    Margin="0,1,0,0"
                                                    Text="{Binding GenerationEtaText}" />
                                     </StackPanel>
                                    <!-- Idle text: "Ready · <speed>" when not prefilling or generating. -->
                                    <TextBlock Grid.Column="1"
                                               FontSize="{DynamicResource FluxFontSizeCaption}"
                                               VerticalAlignment="Center"
                                               Text="{Binding PrefillStatusText}"
                                               IsVisible="{Binding IsBottomBarIdle}" />
                                    <!-- Right text: ETA (prefill) or ETA (generation), right-aligned. -->
                                    <TextBlock Grid.Column="2"
                                               FontSize="{DynamicResource FluxFontSizeCaption}"
                                               VerticalAlignment="Center"
                                               Text="{Binding PrefillEtaText}"
                                               IsVisible="{Binding IsBottomBarPrefill}" />
                                    <!-- ETA during thinking phase: the prefill timer keeps running,
                                         so the ETA continues to count down while the model thinks. -->
                                    <TextBlock Grid.Column="2"
                                               FontSize="{DynamicResource FluxFontSizeCaption}"
                                               VerticalAlignment="Center"
                                               Text="{Binding PrefillEtaText}"
                                               IsVisible="{Binding IsBottomBarThinking}" />
                                </Grid>
                            </Grid>
                            <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <!-- Stress-test control group: the mode dropdown and the "Stress test"
                                     button are wrapped in a single border so they read as one linked
                                     control. The ComboBox has a FIXED width (120) so the group's
                                     desired size is stable; the button's width is content-driven.
                                     A Grid (not StackPanel) is used so the Border's size is stable
                                     regardless of which child is visible (the button hides when the
                                     test is running). VerticalAlignment=Center + no added Margin
                                     keeps the bottom-bar depth unchanged.
                                     The "Cancel stress test" button is in the same Grid column as
                                     "Stress test" so the border wraps the dropdown + whichever
                                     button is visible. -->
                                <Border BorderBrush="#344054"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="4,2"
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0">
                                    <Grid ColumnDefinitions="Auto,Auto">
                                        <ComboBox Grid.Column="0"
                                                  VerticalAlignment="Center"
                                                  ItemsSource="{Binding StressTestModeOptions}"
                                                  SelectedItem="{Binding SelectedStressTestMode}"
                                                  ToolTip.Tip="How the stress test drives each fill level. 'Progressive' (default) builds a realistic multi-turn conversation up to the target, measuring the model's real token count each turn — most faithful to real chat. 'Single prompt' sends one diverse prompt per level (faster)." />
                                        <Button Grid.Column="1"
                                                Content="Stress test"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Click="OnStressTestButtonClick"
                                                Command="{Binding RunContextFillStressTestCommand}"
                                                IsVisible="{Binding StressTestRunning, Converter={x:Static vm:InvertBoolToVisibilityConverter.Instance}}"
                                                ToolTip.Tip="Runs a context-fill stress test: sends requests at increasing context fill levels (25% to 110% of the profile's context limit) and measures TTFT + tok/s at each. WARNING: this test is intended to run to failure — it deliberately exceeds the context limit to observe the behavior (graceful slowdown, OOM, hang, or crash). Results appear in the log above and are written to context_fill_perf.log." />
                                        <Button Grid.Column="1"
                                                Content="Cancel stress test"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Command="{Binding CancelContextFillStressTestCommand}"
                                                IsVisible="{Binding StressTestRunning}"
                                                ToolTip.Tip="Stop the running context-fill stress test early." />
                                    </Grid>
                                </Border>
                                <Button Content="Health"
                                        Margin="0,0,6,0"
                                        Command="{Binding CheckConnectionHealthCommand}"
                                        ToolTip.Tip="Pings the model that is actually running and writes what is wrong (and how to fix it) in the log above. If Route requests is on, checks both the loaded local and the ready cloud." />
                                <Button Content="Copy log"
                                        Margin="0,0,6,0"
                                        Command="{Binding CopyDiagnosticTerminalCommand}"
                                        ToolTip.Tip="Copy the Diagnostics log so you can paste it elsewhere. Lines name llama-server, AI-FluxMux, AutoTune, or the cloud model when that is what wrote them." />
                                <Button Content="Clear"
                                        Command="{Binding ClearDiagnosticTerminalCommand}"
                                        ToolTip.Tip="Erase the log on this screen." />
                            </WrapPanel>
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                <StackPanel Orientation="Vertical"
                                            VerticalAlignment="Top"
                                            Margin="0,2,10,0">
                                    <TextBlock Opacity="0.5" FontSize="{DynamicResource FluxFontSizeSmall}"
                                               Text="{x:Static upc:FluxMuxAppInfo.ProductTitle}" />
                                    <TextBlock Opacity="0.4" FontSize="{DynamicResource FluxFontSizeSmall}"
                                               Text="{x:Static upc:FluxMuxAppInfo.Copyright}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
            </Grid>
        </Border>
    </Grid>
    </LayoutTransformControl>
    <Canvas x:Name="DragGhostLayer"
            IsHitTestVisible="False" />
    </Panel>

</Window>



