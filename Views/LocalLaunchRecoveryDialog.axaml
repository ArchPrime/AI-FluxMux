<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FluxMux.Avalonia.Views.LocalLaunchRecoveryDialog"
        Width="560"
        MinWidth="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource FluxPaneBackground}"
        Foreground="{DynamicResource FluxHeadingForeground}">

    <Border Padding="16,14"
            Background="{DynamicResource FluxCardBackground}"
            BorderBrush="{DynamicResource FluxCardBorder}"
            BorderThickness="1">
        <StackPanel Spacing="10" HorizontalAlignment="Center">
            <TextBlock x:Name="HeadingText"
                       FontSize="{DynamicResource FluxFontSizeTitle}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource FluxHeadingForeground}" />
            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource FluxFontSizeBody}"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource FluxHeadingForeground}" />
            <WrapPanel HorizontalAlignment="Center">
                <Button x:Name="SmallerContextButton"
                        Margin="0,0,8,0"
                        Click="SmallerContext_Click" />
                <Button x:Name="RetryButton"
                        Margin="0,0,8,0"
                        Click="Retry_Click" />
                <Button x:Name="SmallerModelButton"
                        Margin="0,0,8,0"
                        Click="SmallerModel_Click" />
                <Button x:Name="StopButton"
                        Margin="0,0,8,0"
                        IsVisible="False"
                        Click="Stop_Click" />
                <Button x:Name="WaitLongerButton"
                        Margin="0,0,8,0"
                        IsVisible="False"
                        Click="WaitLonger_Click" />
            </WrapPanel>
        </StackPanel>
    </Border>
</Window>