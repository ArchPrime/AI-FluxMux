<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FluxMux.Avalonia.Controls.GpuPillToggle">
    <!-- Both halves take the width of the longer label plus padding (shared-size columns),
         so they stay equal and the labels never touch at any text size. A fixed MinWidth of
         150 split into two equal halves ran "Discrete GPU" into "Motherboard GPU" (25 Nov). -->
    <Border x:Name="RootBorder"
            MinHeight="22"
            HorizontalAlignment="Right"
            Background="{DynamicResource FluxMutedBackground}"
            BorderBrush="{DynamicResource FluxMutedBorder}"
            BorderThickness="1">
        <Grid Grid.IsSharedSizeScope="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="GpuPillHalf" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="GpuPillHalf" />
            </Grid.ColumnDefinitions>
            <Border x:Name="DiscreteSeg"
                    Grid.Column="0"
                    Padding="10,2"
                    CornerRadius="10,0,0,10">
                <TextBlock x:Name="DiscreteText"
                           FontSize="{DynamicResource FluxFontSizeCaption}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Text="Discrete GPU" />
            </Border>
            <Border x:Name="MotherboardSeg"
                    Grid.Column="1"
                    Padding="10,2"
                    CornerRadius="0,10,10,0">
                <TextBlock x:Name="MotherboardText"
                           FontSize="{DynamicResource FluxFontSizeCaption}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Text="Motherboard GPU" />
            </Border>
        </Grid>
    </Border>
</UserControl>
